quran[26]{c,v,t}:
  53,1,"قسم ہے تارا کی جد وہ ڈوب جائے؛"
  53,2,"تھارا سنگی (نبیؐ) نہ راہ تیں بھٹکو تے نہ ہی بے راہ ہویو؛"
  53,3,"تے نہ ہی وہ اپنی طرفوں کائے گل کرے؛"
  53,4,"بلکہ وہ (قرآن) تے وحی ہے، نازل کری ہوئی (رب نے)؛"
  53,5,"جہڑی اس نا اک زور آور طاقت (فرشتہ) نے سکھائی ہے؛"
  53,6,"بڑو زورآور (جبرائیلؑ)؛ تے فِر وہ سِدھو کھلو ہو گِیو؛"
  53,7,"جد وہ اُچا آسمان کا کنڈھا ور تھو؛"
  53,8,"فِر وہ نیڑے ہویو تے ہیٹھاں اترو؛"
  53,9,"کوئی دو کمان (کا فاصلہ تیں) یا اس تیں وی نیڑے؛"
  53,10,"فِر وحی بھیجی (اللہ نے) اپنا بندہ نا، جو وحی کی؛"
  53,11,"دل نے جُھوٹ نھیں کہیو جو اس (نبیؐ) نے دیکھو تھو؛"
  53,12,"کی تم اس (نبیؐ) کا دیکھیا ور انھاں سنگ بحث کرو گا؟"
  53,13,"بیشک پیغمبر نے وہ (فرشتو) اک بار ہور وی اترتاں دیکھو تھو؛"
  53,14,"آخری حد کی بیری (سدرۃ المنتہیٰ) کا نیڑے؛"
  53,15,"اس کا نیڑے (ہمیشہ رہن کی) جنت الماویٰ ہے؛"
  53,16,"جد اس بیری نا، واہ چیز چھپا لئے تھی جہڑی اس ور چھاں کرے تھی؛"
  53,17,"نہ تے اس (نبیؐ) کی نظر بہکی، نہ حد تیں اگے بڑھی؛"
  53,18,"بیشک اس (نبیؐ) نے اپنا رب کی بڑی بڑی نشانیاں وچوں کجھ نشانیاں دیکھیاں؛"
  53,19,"تم نے کدے لات تے عزی (دو بت) دیکھیا ہیں؟"
  53,20,"تے واہ ہور تیجی (دیوی)، منات؟"
  53,21,"کی تھارے واسطے بیٹا ہیں تے (اس اللہ تعالیٰ) واسطے کڑیاں؟"
  53,22,"یاہ تے بڑی بے ڈھنگی ونڈ (تقسیم) ہے؛"
  53,23,"یہ سب تے بس کجھ ناں ہیں جہڑا تم نے تے تھارا باپ داداں نے رکھ لئے ہیں؛ جنھاں بارے اللہ تعالیٰ نے کوئی ثبوت نھیں بھیجیو، یہ لوک محض اپنی تے اپنا نفس کی مرضی کی پیروی کریں؛ حالانکہ انھاں کول رب کی طرفوں ہدایت آئی ہوئی ہے؛"
  53,24,"کی انسان جو کجھ سوچے وہی اس نا لبھ جائے؟"
  53,25,"بیشک اللہ تعالیٰ ہی کی ملکیت ہیں وہ جہان (آخرت) وی تے یوہ جہان (دنیا) وی؛"
  53,26,"آسماناں ما کتنا ہی فرشتہ ہیں جنھاں کی کوئی اک سفارش نھیں چل سکدی؛ جد تک اللہ تعالیٰ اپنی رضا سنگ، جس واسطے چاوے سفارش کی اجازت نہ دے؛"
