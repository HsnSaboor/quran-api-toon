quran[26]{c,v,t}:
  53,1,"قصم ہے تارا گی جس فلہ وہ دوب بڑن لگے"
  53,2,"جتھارا یہ سنگی ناتے رسطا پولیہیں تنہ غلط راور جلے۔"
  53,3,"توے اپری مرزیناال کائے گال لیں کرتا"
  53,4,"جات وی ہے جڑی انہدر کیجے"
  53,5,"انانا سختاقت آلا فرشتان اتالیم دتی ہے"
  53,6,"جڑو بڑو زور آور ہے فیر وہ سکھڑ خلو ہوگیو"
  53,7,"تو اسمانگاوچہ کنڈاور تھو"
  53,8,"فرن ندہ آیا تو وہ بون لے آیا یا نی ہور ندہ وہ"
  53,9,"تچڑو دو کماناگے برابر چندو رہے گیا یا اس نے بی کتھت"
  53,10,"فرلا نے اپنے بندانا ویپ چائی جڑی ویپ چائی"
  53,11,"جو کوج انہ نی دیکھو دل نے اسلام چوت نہیں کیوں"
  53,12,"فر کیوطم نبینال اس چیز ورچا گریں جیڑی وی اپنی اکھیں دیکھیں"
  53,13,"اور نوی سللہ ہولی و سلم نے تیک دو جی واری وی وہ فرستور لیتا دیکھئے"
  53,14,"سدراتول منتہا گے کلے"
  53,15,"اس کے قول ہے جن نتل ماوہ ہے"
  53,16,"جد جو اس بیرینہ تقری تھی جڑیوی چیز تقری تھی۔"
  53,17,"نظر ناؤتہ ایگا ہوں گا اٹی تنہا و آگہ بھڑی"
  53,18,"یقینن نبی سل اللہ علی و سلہم نے اپنا رب کی قدرت کی بڑی بڑی نشانی دیکھیں"
  53,19,"کیون؟ کم لوگہ نے لا تہ اوزانہ دیکھو؟"
  53,20,"تچھے کر گا تیجا مناتنا دیکھئے"
  53,21,"کیوں تھارا بس تک گگرہ تالہ تالہ تالہ بس تک قدی ہیں"
  53,22,"تانت یا بند مچ بیٹنگئے"
  53,23,"یہ دچھڑا نہ ہیں جڑا تم نے تتھارا باب دادہ نے تارلی ہیں اللہ تعالیٰ نے تونا گبارا ما کائی دلیل نہزل نہیں کی یہ لوگ چھڑا ویم اور اپنا نفس کی خائشہ ورچالدے ہیں آلا کے نکول ہے اُنا گر رب کی ترفوں ہدایت آگی ہے"
  53,24,"کیون் انسان جس تیز کی வیتان کرے وی اسنا لب جے"
  53,25,"دنیا اور آخرت بس اللہ ہی گا اختیار میں"
  53,26,"تیاسمانا مانک کیتنا ایفرشتا ہے کہ انگی صفارش کوجوی کام نہیں آتی بارستوبات کہ اللہ تعالیٰ جس وستج جاو ہے اجازت دیدے تیسفارش نہ پسند کر ہے"
