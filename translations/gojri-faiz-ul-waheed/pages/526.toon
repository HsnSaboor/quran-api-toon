quran[26]{c,v,t}:
  53,1,"اصم ہے تاراگی جس ویلے وہ دب بڑھن لگے"
  53,2,"جتارا یہ سنگی نات ہے رسطا پولے ہیں تنان غلط راور چلی ہیں"
  53,3,"توے اپری مرزی نال کا ایک اعلن کرتا"
  53,4,"یا توے ہے جہڑی انہدر کیج ہے"
  53,5,"انھاں نا سختاقتالہ فرشتان اتالیم دیتی ہے"
  53,6,"جڑو بڑو زوراور ہے فرو سکھت خلو ہوگیو"
  53,7,"تو اسمان گاوچہ قنڈاور تھو"
  53,8,"فرو نیڈا آیا تو وہ بون لیا آیا یعنے ہو رہا ہے"
  53,9,"تچڑو دو قمانا کے برابر چندو راگیا یا اس نے بی قتا"
  53,10,"فرلا نے اپنا بندانا وہی پچای جہڑی بی پچای"
  53,11,"جو کوج انہا دیکھو دل نے اسنا چوت نہیں کیو"
  53,12,"فر کیوں تم نبینال اس چیز ورچагرے جہڑی وی اپنی اکھیں دیکھیں"
  53,13,"اور (اے نبیؐ) صلی اللہ علیہ وسلم نے تیک دو جی واریوی وہ فرشتور لیتا دیکھو ہے"
  53,14,"سدراتول منتاہا گئے کول ہے"
  53,15,"ہے اس کے کول ہے جنہتول ماوہ ہے"
  53,16,"جد کے اس بیرینہ تاکرے تھی جہڑی ویچیز تاکرے تھے"
  53,17,"نظر نہ تایں گا ہوں گا اٹی تنناوہ آگ گیا بڑی"
  53,18,"یکی ننبی صلی اللہ علیہ وسلم نے اپنے رب کی قدرت کی بڑی بڑی نشانی دیکھیں"
  53,19,"کیوں تم لوگہ نے لاتھ اوزانہ دیکھو"
  53,20,"تچھے کر گا تیجا مناتہ دیکھو کیوں"
  53,21,"تارہ وستہ گگرہ تالہ تالہ وستہ قوری ہیں"
  53,22,"تانتہ یا بند مچ بیٹنگی ہے"
  53,23,"یہ دچھڑا نہ ہیں جدتا مناہیں تتارہ باب دادہ نے تارلی ہیں اللہ تعالیٰ نے تارنا گبارہ معا کائد لیل نازل نہیں کی یہ لوگ چھڑا ویم اور اپنا نفس کی خو ورچالدے ہیں آلا کے نکول ہے انگر رب کی ترفوں ہدایت آگی ہے"
  53,24,"کیون انسان جس تیز کی بیتان کرے وائی اسنا لب جے"
  53,25,"دونیا اور آخرت تبس اللہ ہی گئے خیار مائے"
  53,26,"تیاسمانہ مان کیتنا ایفرشتا ہے کہ انگی صفارش کوجوی کام نہیں آتی اور اس طباہت کے اللہ تعالیہ جس وستہ چاو ہے ایجازت دے دیا تو صفارش نہ پسند کر ہے"
