quran[23]{c,v,t}:
  26,61,"فِرْجِسْ وِلَيْ دُوَعْجْمَاتَ نے اِكْدُوْ جِنَا دِيْكِوْ مُسَا کا سنجِعَنِ كِوْ کے حمتِ پَكْرِه گئا"
  26,62,"گئا مُسَا نے فرمائُ بِلْقُلْنِ یقینَا مِرَنَالِ مِرُ رَبِئِ وہ مِنَا عُونِ رَسْتُ دَسْتِئَ"
  26,63,"اس وِلَيْا عَمْنِ مُسَا دَرْوَيْكِ جِي اَپْنِ سُوْتِ سَمَنْدَرْ وَرْمَارِ فِرْ سَمَنْدَرَ پَتْجُوْ یعنِ لَنْنِ کی رَا چُرْ جَا دُوْ پَاسِ خَلْقِوْ تَبْعَنِ جُوْ حَرِكِ سُوْ بُوتْ بَدَا بَارْنَالُواْ جُوْ"
  26,64,"تَعْوَتَامْ دُجَنَامِ نِرَ"
  26,65,"لِاَيَا تَعْمْنِ مُسَا اور اُنَا غَنْنَالْغَا سَارَابَ"
  26,66,"جَالْقَا فِرْ دُجَا عَمْنِ اَغَرْقَرْكَرْدَا"
  26,67,"یقین ان اسم بڑی نشانی ہے ور اُن مہ مچ لوگ ایمان نہیں"
  26,68,"لیاتا۔ تبیشک تار اور رابی غالب ہے تَمُج مِر بان"
  26,69,"ہے۔ تَعِنَ بِسَلِ اللہُ الْعُوْ لِوْسَلْمِ اِنَانَ اِبْرَا حِيمْ کو کی سو"
  26,70,"سُنَاو، جس وِلَا اُنَا نے اپنا باب تِ اپنی قوم نہ کیوں، جتم کس چیز کی عبادت"
  26,71,"عبادت کریں، انہیں کیوں، عام بُطانگی پوچا کرتے ہم اُنہواری دیت کے بیس"
  26,72,"گیا، اگر آہیم نے فرمائے ہو، کیوں؟ یہ تاریوات سنو نہیں، جس فلِلِ اَتَمُنَا گیف فریاد یا"
  26,73,"دواجرے، یا ویتَمُنا کوئی نفو دیسے کیا، یا تمنا کوئی جنوکسان پچاسے"
  26,74,"کیا؟ انہیں کیوں؟ نی، بلکے عام نے اپنا باب دادہ نہ اسے را کرتا"
  26,75,"دیکھو ہے، اِبراہیم نے فرمائے ہو، تم نے ویتے ہیں جنہ گی تم عبادت"
  26,76,"کریں، تم تِ اِتَارا پیسل باب"
  26,77,"دادہ، میرہ تِ اِسَارا دُشْمَنِ سِوَعِئِ اللَّا رَبْبُلَالَمِنِ"
  26,78,"کے، وہ جس نے مِنَّا پیدا کیو ہے، تو وہ اِمِنَ"
  26,79,"رَادَسِ ہے، تو وہ یہ جو جو جو مِنَا کھالِ اِتَ"
  26,80,"پیالِ اِس جس فلِلِ اِمَان دو ہو جاں، تو وہ یہ مِنَا"
  26,81,"شفا دیا، تو جو میں نے مُد دیا گو، فِر مِنَا زندو کرے"
  26,82,"کرے گو، تو وہ یہ جس تُ مِنَا یا مِد ہے جو وہ کیامت کے تَعِدِ اِمِرِ خَتَا یا نے گُنا مَا فرمادیا"
  26,83,"گو، اِبرا رَبْ تُ مِنَا علمُ حِقْمَتَتَا فَرمَا تَ مِنَا نے کو قارم اشامل فرمادے،"
