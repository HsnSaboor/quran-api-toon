quran[27]{c,v,t}:
  55,68,"ان دوہاں (باغاں) ما وی میوہ، کھجور تے انار ہوویں گا؛"
  55,69,"فِر تم دوئے اپنا رب کی کہڑی کہڑی نعمتاں کو انکار کرو گا؟"
  55,70,"انھاں (باغاں ما وی) چنگی عادتاں آلی تے سوہنی سوہنی حوراں ہوویں گی؛"
  55,71,"فِر تم دوئے اپنا رب کی کہڑی کہڑی نعمتاں کو انکار کرو گا؟"
  55,72,"اجیہی حوراں جہڑی تمبوآں کا وچ پردہ ما رہیں؛"
  55,73,"فِر تم دوئے اپنا رب کی کہڑی کہڑی نعمتاں کو انکار کرو گا؟"
  55,74,"جنھاں سنگ پہلاں کسے انسان یا جن نے ہتھ وی نھیں لایو ہوویں؛"
  55,75,"فِر تم دوئے اپنا رب کی کہڑی کہڑی نعمتاں کو انکار کرو گا؟"
  55,76,"(ویہہ جنتی) تکیہ لا کے سبز قالیناں تے شاندار نرم فرشاں ور بیٹھا ہوویں گا؛"
  55,77,"فِر تم دوئے اپنا رب کی کہڑی کہڑی نعمتاں کو انکار کرو گا؟"
  55,78,"بڑی برکت آلو ہے تھارا رب کو ناں، جہڑو رعب تے بزرگی آلو ہے!"
  56,1,"جد واہ ہون آلی (قیامت) ہو جائے گی؛"
  56,2,"اس کا واقع ہون تیں کوئی انکار نھیں کر سکدا؛"
  56,3,"واہ پٹ پرت کرن آلی (آفت) ہے؛"
  56,4,"جس دن زمین بھونچال نال ہل جائے گی؛"
  56,5,"تے پہاڑ ریزہ ریزہ ہو جائیں گا؛"
  56,6,"تے اڑتی دھوڑ (خاک) بن جائیں گا؛"
  56,7,"تے تھارا (انساناں کا) ترے گروہ بن جائیں گا؛"
  56,8,"فِر (اک) سجا پاسا آلا، تے کی چنگا ہیں ویہہ سجا پاسا آلا!"
  56,9,"تے (دوجا) کھبا پاسا آلا، تے کی (بے چارہ) ہیں ویہہ کھبا پاسا آلا!"
  56,10,"(تے تیجا) اگے ودھن آلا (نیکیاں ما)، ویہہ تے اگے ہی ودھن آلا ہیں؛"
  56,11,"یہ لوک اللہ تعالیٰ کا مچ ہی نیڑے (مقرب) ہوویں گا؛"
  56,12,"نعمتاں آلی جنتاں ما ہوویں گا؛"
  56,13,"(اس تیجا گروہ ما) مچ پہلا لوکاں وچوں ہوویں گا؛"
  56,14,"تے تھوڑا پچھلا لوکاں وچوں؛"
  56,15,"(جہڑا) سونا کی تاراں سنگ بنیا ہوا پلنگاں ور،"
  56,16,"تکیہ لا کے، روبرو بیٹھا ہوویں گا؛"
