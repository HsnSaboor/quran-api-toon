quran[29]{c,v,t}:
  91,1,"کسا میں دیں گی تو اس کی توپگی،"
  91,2,"تکسا میں چنگی جس و لے وہ اس کے پیچھے آوے،"
  91,3,"تکسا میں تیاری گی جدوہ دینہ بان دے کر دے،"
  91,4,"تراتگی جدوہ دینہ چھپا لے،"
  91,5,"تیاسمانگی اور اُزاتگی جس نے وہ بڑایا،"
  91,6,"تزمینگی اور اُزاتگی جس نے اسنات دیا،"
  91,7,"تجانگی توزاتگی جس نے وجان بڑایا،"
  91,8,"فیر اسنا بڑی گی تو پر حزگاری کی سمجھ دیتی،"
  91,9,"بلشوبا وہ شخص کامے آب ہوگیو جس نے نفس پاک کر لیو،"
  91,10,"تو وہ یکتینہ نام را د ہوگیو جس نے وہ گناواما دبو شڑے ہو،"
  91,11,"اور میں سموڑ نے اپنی سرکشی کی وجہتے سالحنا چوٹ ہوگیو،"
  91,12,"جدونا مجھون سب سے بڑو بڑ بڑاکت اٹھ پیو،"
  91,13,"تاونہ نا، اللہ گرسول سالح نے کیو تو حبردار تم اللہ کی اُنٹنی تو اس کی پانی پین کی باری تے دور ریو،"
  91,14,"فیرونہ نے اللہ گرسول نہ چوٹ ہوگیو، تاونٹنی کی لتکا پچھڑی، تاونہ گر رب نے اُنہ ور اُنگا گناوانگی وجہتے سخ ازاب نازل کیو، تاوے برابر ہی کار چھڑیا،"
  91,15,"تا اُسنا انگا بضلالیں گو کوئی دارنی،"
  92,1,"قسم ہے رات کی جس فلعوال سب گئے نا چھپالے"
  92,2,"تیاری کی جس فلعوال روشان ہو جے"
  92,3,"توزات کی جس نے نارت مادی نا پیدا کیوں"
  92,4,"بلاش بات تاری کوشش کنی کنی ہے"
  92,5,"تجس نے اللہ گرستہ مدیتوں تو وہ ستدرے ہو"
  92,6,"توس نے چنگی گال کی تستی کی"
  92,7,"فرح مصنا عرام کی چیز وستے آسانی دیگا"
  92,8,"ترے ہو جس نے کنجوسی کی تخودات علاہ بروائی کی"
  92,9,"تجنگی گالی یا ندین نچوٹھو کیوں"
  92,10,"فرح مصنا عوکت وستے آسانی دیگا"
  92,11,"تو اس کو مال اس کے کوج کام نہیں آسے جد وہ برواضی کی خات مجا پوہ گو ہے"
  92,12,"بیشا کرس تو دسلوں مارے زمہیں"
  92,13,"تبلاش با آخرتوی تدنیاوی مارا یہ قبزم ہے"
  92,14,"تمے تم ایک پڑکتی آگتے دراجھوڑ ہے"
