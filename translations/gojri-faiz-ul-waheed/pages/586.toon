quran[29]{c,v,t}:
  81,1,"جس ویلے دن پلیٹ دِتو جائے گو"
  81,2,"تے جس ویلے تارے بے نور ہو جاونگا"
  81,3,"تے جس ویلے پہاڑ چلا دِتا جاونگا"
  81,4,"تے جس ویلے دس مہینے کی سُوئین آلی گَبھن اُونٹھنی بیکار چھوڑ دِتی جائے گی"
  81,5,"تے جس ویلے جنگلی جانور گھبرا کے کٹھے ہو جاونگا"
  81,6,"تے جس ویلے سمندر اُبال دِتا جاونگا"
  81,7,"تے جس ویلے ایک ایک قسم کا لوگ کٹھے کیتا جاونگا"
  81,8,"تے جس ویلے زمین ما جیوندی دبی ہوئی بچی نا پچھِیو جائے گو"
  81,9,"کہ وہ کس جرم ما قتل کیتی گئی تھی؟"
  81,10,"تے جس ویلے اعمال نامہ کھول دِتا جاونگا"
  81,11,"تے جس ویلے آسمان کی کَھل لاہ دِتی جائے گی"
  81,12,"تے جس ویلے دوزخ دہکائی جائے گی"
  81,13,"تے جس ویلے جنت نیڑے آنی جائے گی"
  81,14,"اس ویلے ہر شخص نا پتو لگ جائے گو جو وہ ایتھے لے کے آیو ہے"
  81,15,"سو میں قسم کروں تارا کی جہڑا پچھے الٹے مڑ جائیں"
  81,16,"جہڑا سِدھا چلدا رہیں تے جہڑا چھپ جائیں"
  81,17,"تے رات کی جس ویلے وہ آ چھاوے"
  81,18,"تے قسم ہے سویر کی جس ویلے وہ ساہ لین لگے"
  81,19,"کہ یہ قرآن ایک معزز سنیہو لیاون آلا فرشتہ کو آنیو ہویو کلام ہے"
  81,20,"جہڑو بڑی طاقت آلو ہے، عرش کا مالک کولے اس کو بڑو رتبو ہے"
  81,21,"اوتھ اس کی گال منّی جائے، امانتدار ہے"
  81,22,"تے یہ تھارے نال رہن آلو نبی مجنون نھیں ہے"
  81,23,"تے انھاں نے یقیناً اس نا آسمان کا صاف کنڈے ور دیکھِیو وی ہے"
  81,24,"تے یہ غیب کی دَسی ہوئی گلاں کا بارہ ما کنجوس نھیں ہے"
  81,25,"تے یہ قرآن کسے مردود شیطان کو کلام نھیں ہے"
  81,26,"پھر تم کِنگا جا رہے ہو؟"
  81,27,"یہ قرآن تاں بس سارا جہاناں واسطے ایک نصیحت ہے"
  81,28,"اس شخص واسطے جہڑو تھارے بیچوں سِدھے رستہ ور چلنو چاہے"
  81,29,"تے تم کجھ نھیں چاہ سکدا جے چر توڑی سارا جہاناں گو پروردگار اللہ تعالیٰ ہی نہ چاہے"
