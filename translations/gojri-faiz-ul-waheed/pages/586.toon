quran[29]{c,v,t}:
  81,1,"جس ویلہ دی پلے دی تو جائے گو۔"
  81,2,"تجس ویلہ تارا بے نور ہو جیں گا۔"
  81,3,"تجس ویلہ پاہر جلا دیتا جیں گا۔"
  81,4,"تجس ویلہ دس مینگی سونہ لی گبا نوٹھنی بکار چھوڑ دیتی جائے گی۔"
  81,5,"تجس ویلہ جنگلی جانور قبرانہاں کتھا ہو جیں گا۔"
  81,6,"تجس ویلہ سمندر ابال دیتا جیں گا۔"
  81,7,"تجس ویلہ ایک ایک ایک کسام کا لوگ قتا کیا جیں گا۔"
  81,8,"تجس ویلہ زمین مجیتی دبی بچینہ پچھو جائے گو۔"
  81,9,"جوہ کے سجور ما قتل کی گئی تجس"
  81,10,"ویلہ امال ناماں کھول دیتا جیں گا۔"
  81,11,"تجس ویلہ اسمان کی قل لادی تی جائے گی۔"
  81,12,"تجس ویلہ دوزخ پخائی جائے گی۔"
  81,13,"تجس ویلہ جننط نیدہ آنی جائے گی۔"
  81,14,"اس ویلہ ارشخص نپطو لگ جائے گو جو وہ اتکے لے گے آئے گے۔"
  81,15,"تجس ویلہ قسم کروں طاراگی جرہ پیشلونی یہ مور"
  81,16,"جیں۔ جرہ صدہ چلتا رہیں تجرہ چھاپ جیں۔"
  81,17,"تراتگی جس ویلہ و آ چاج"
  81,18,"ہے۔ تجس ویلگی جدوہ سالیں لگے۔"
  81,19,"جیو قرآن ایک مازز سنیہ لیانہ لہا فرشتا گو آنے وہ قلامے۔"
  81,20,"جیو بڑی تاقتالو ہے تجس ویلہ ارش کا مالک کو لے اُس کو بڑو رتبو"
  81,21,"ہے۔ اُت اُس کی گل منی جائے اماند دار ہے۔"
  81,22,"تجس ویلہ ارینہ لیانہ نبی مجنون نہیں"
  81,23,"ہے۔ تجس ویلہ نے یقینن وہ اسمان کا ساف کنڈاور دیکھو وی ہے۔"
  81,24,"تیئے غہب گی دسیوی گلنگ باراما کنجوز نہیںے۔"
  81,25,"تیو قرآن کسی مردوڈ شیتان کو قلام نہیں ہے۔"
  81,26,"فرطم کنگا جارے"
  81,27,"اوکران تبس دنیا جھانا لہا وسط ہے ایک نصیت ہے"
  81,28,"اوش شخص وسط ہے جو دھارہ بچو صدار استا ورچانن چاہا ہے"
  81,29,"تتم کوجنی چا سکتا جیچر توری جھانا کو پر برگار اللہ تعالی ہی نہ چاہا ہے"
