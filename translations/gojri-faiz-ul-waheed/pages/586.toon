quran[29]{c,v,t}:
  81,1,"جس ویلہ دی پلے دی تو جائے گو۔"
  81,2,"تے جس ویلہ تھارا بے نور ہو جیں گا۔"
  81,3,"تے جس ویلہ پاہر جلا دیتا جیں گا۔"
  81,4,"تے جس ویلہ دس مینگی سونہ لی گبا نوٹھنی بکار چھوڑ دیتی جائے گی۔"
  81,5,"تے جس ویلہ جنگلی جانور قبرانہاں کتھا ہو جیں گا۔"
  81,6,"تے جس ویلہ سمندر ابال دیتا جیں گا۔"
  81,7,"تے جس ویلہ ایک ایک ایک کسام کا لوگ قتا کیا جیں گا۔"
  81,8,"تے جس ویلہ زمین مجیتی دبی بچینہ پچھو جائے گو۔"
  81,9,"جوہ کے سجور ما قتل کی گئی تے جس"
  81,10,"ویلہ امال ناماں کھول دیتا جیں گا۔"
  81,11,"تے جس ویلہ اسمان کی قل لادی تی جائے گی۔"
  81,12,"تے جس ویلہ دوزخ پخائی جائے گی۔"
  81,13,"تے جس ویلہ جننط نیدہ آنی جائے گی۔"
  81,14,"اس ویلہ ارشخص نپطو لگ جائے گو جو وہ اتکے لے گے آئے گے۔"
  81,15,"تے جس ویلہ قسم کروں طاراگی جرہ پیشلونی یہ مور"
  81,16,"جیں۔ جرہ صدہ چلتا رہیں تجرہ چھاپ جیں۔"
  81,17,"تراتگی جس ویلہ و آ چاج"
  81,18,"ہے۔ تے جس ویلگی جدوہ سالیں لگے۔"
  81,19,"جیو قرآن ایک مازز سنیہ لیانہ لہا فرشتا گو آنے وہ قلامے۔"
  81,20,"جیو بڑی تاقتالو ہے تے جس ویلہ ارش کا مالک کو لے اُس کو بڑو رتبو"
  81,21,"ہے۔ اُت اُس کی گل منی جائے اماند دار ہے۔"
  81,22,"تے جس ویلہ ارینہ لیانہ نبی مجنون نہیں"
  81,23,"ہے۔ تے جس ویلہ نے یقینن وہ اسمان کا ساف کنڈاور دیکھو وی ہے۔"
  81,24,"تجیو"
  81,25,"قرآن کیسے مردو دشیتان کو قلام نہیں ہے۔"
  81,26,"فرطم کنگا جارے"
  81,27,"اوکران تبس دنیا جھانا لہا وسط ہے ایک نصیت ہے"
  81,28,"اوش شخص وسط ہے جو دھارہ بچو صدار استا ورچانن چاہا ہے"
  81,29,"تتم کوجنی چا سکتا جیچر توری جھانا کو پر برگار اللہ تعالی ہی نہ چاہا ہے"
