quran[22]{c,v,t}:
  85,1,"قسم ہے برجاں آلا آسمان کی"
  85,2,"تے قسم ہے وعدہ کیوا دیہاڑا کی"
  85,3,"تے آن آلا دیہاڑا کی، تے اس کی جس ما آویں"
  85,4,"برباد ہو گیا کھائیاں آلا، یعنی کھاتاں خندقاں آلا"
  85,5,"یعنی آگ کی خندقاں آلا، جہڑی لکڑیاں نال بھری ہوئی تھیں"
  85,6,"جس ویلے وہ ان کے کنڈے بیٹھا ہویا تھا"
  85,7,"تے اس ظلم نا دیکھ رہیا تھا، جو وہ مسلماناں نال کر رہیا تھا"
  85,8,"تے انھاں نے مسلماناں کولوں چھڑو اس ہی گال کو بدلو لیو، جو وہ اللہ ور ایمان لے آیا تھا، جہڑو زبردست ہے، صفتاں آلو ہے"
  85,9,"جس کی آسماناں تے زمین ما بادشاہی ہے، تے اللہ تعالیٰ ہر ایک چیز نا دیکھ رہیو ہے"
  85,10,"بلاشبہ جن لوگاں نے مسلمان مردان تے مسلمان کالسیریاں نا تکلیف پچائی، پھر انھاں نے توبہ نہیں کی، انھاں واسطے جہنم کو عذاب ہے، تے انھاں واسطے آگ ما سڑن کو عذاب ہے"
  85,11,"یقیناً جہڑا لوگ ایمان لے آیا تے انھاں نے چنگا عمل کیا، انھاں واسطے جنتاں ہیں، جن کا ہیٹھ نہراں وگتی ہونگی، یہ ہی ہے بڑی کامیابی"
  85,12,"بے شک تیرا رب کی پکڑ بڑی ڈاڈھی ہے"
  85,13,"وہی تاں پہلی واری بھی پیدا کرے، تے وہی دوہری واری پیدا کرے گو"
  85,14,"تے وہ ہے ہی بڑو بخشن آلو، محبت کرن آلو"
  85,15,"وہ عرش کو مالک ہے، اُچی شان آلو ہے"
  85,16,"وہ جو چاہے سو کر دے"
  85,17,"کیوں تمھاں نا انھاں لشکراں کی گال پہنچی؟"
  85,18,"یعنی فرعون تے ثمود کا لشکراں کی"
  85,19,"بلکہ یہ کافر لوگ قرآن نا جھوٹو کہن ما ہی لگیا ہویا ہیں"
  85,20,"حالانکہ اللہ نے انھاں نا چومکھی گھیر رکھیا ہے"
  85,21,"بلکہ یہ اُچی شان آلو قرآن ہے"
  85,22,"جہڑو لوحِ محفوظ ما لکھیا ہویا ہے"
