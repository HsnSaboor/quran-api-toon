quran[28]{c,v,t}:
  83,7,"انگو خیال بلکل تک نہیں گنا گارنگ عمال ناما سجین میں تتم"
  83,8,"را کے پتوں سجین کے چیز ہے"
  83,9,"وہ ایک لکھا وہ دفتر ہے"
  83,10,"اس تیارے کیامتنا چود کہنالا وستے بربادی بے گی"
  83,11,"جڑا بگل آلہ تیارا نہ چود کے"
  83,12,"تو اس تیارا کو انکار بس وہی کرے جڑو آدوم بڑے وہ گنا گارو ہے"
  83,13,"جس ویلے اُس کے سامرے ماری آئیت پڑی جیں وہ کہ یہ ترپیچل آلوں کا گا کیسا گاہنے"
  83,14,"بلکل نہیں بلکہ گلیا ہے جہونہگہ بورا عمل جڑا یہ کر رہے انہگہ دلہاور کھئی بانگہ بیس کیا ہے"
  83,15,"ہر گز نہیں بلہ شبہ یہ لوگوں کو اس تیارے اپنے رب گا دیدارتے روگ دیتا جنگا"
  83,16,"فیروے ضرور دوز خمام پویں گا"
  83,17,"فیرونہ نکیو جائے گو یا جنگا جنگا میں جس نا تم چود سمجھے تھا"
  83,18,"بلکل نہیں جیکنہ نیک لوگوں کا عمل ناما ایلیین میں تتم"
  83,19,"را کے باتوں کہ ایلیین کی چیز ہے"
  83,20,"وہ ایک لکیو لکھایا وہ دفتر ہے"
  83,21,"جسنا اللہ کو رب رکھنہ لہا فرستا دیکھیں"
  83,22,"نیک لوگ تباری ایش عرام ممینگا"
  83,23,"وہ تختور بیس کے نظارہ کرتا میں گا۔"
  83,24,"امخاطب تو انگا مکھنامور ایسا اش کی تازگی دیکھے"
  83,25,"گو۔ انہا اُت مور لگی بھی نیچ سچی شراب بلائی جائے گی۔"
  83,26,"اُس کی مور قصطوری گی رہگی۔ تریس کرنا لنا ایسی چیزمہ ایک دو جاتیں باد گئے ریس کرنی چایئے۔"
  83,27,"تا اسمان تسنیم کو رلو گئے گو۔"
  83,28,"یا تسنیم ایک با ہے یا نیچشمو آئے جس بچوں خداگا مقر بندہ پیئیں گا۔"
  83,29,"مجرم لوگت دنیا مائیمان آلانا ہاستے میں تھا۔"
  83,30,"توے مومن جسویلہ انا کلوں لنگے میں تھا یہ اناور اقمارے میں تھا۔"
  83,31,"تجسویلہ اپنے قراندر جمیں تھا اسے رہ گپلاتا جمیں تھا۔"
  83,32,"تجسویلہ یہ انا مومنانا دیکھیں میں تھا کہیں تھا جی یہ لوگت بلکو لیگ گمرا ہے۔"
  83,33,"آلان کے وہ بدمل اناور اپنے مور بڑاگا نہیں جل آئے گیا"
  83,34,"تھا۔ فیراج کیامت مائیمان آلالوگ انا کافرانا ہاسترے ہیں۔"
