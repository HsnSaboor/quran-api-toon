quran[23]{c,v,t}:
  56,77,"قسم ہے۔ یکیننیوں اچھا روطبالوں قرآن ہے"
  56,78,"ہے جو کے لوحی محفوز"
  56,79,"میں۔ اسناو ویلوک آتلا میں جڑا پاک"
  56,80,"میں۔ یہ سارا جاناگر رب کی ترفون نازل"
  56,81,"وہا ہے۔ فر کیو تم ایسا کلانت انکار"
  56,82,"کریں؟ تیاپ رہی ساما یا گل لے جتم اس کو انکار کرتا"
  56,83,"کرتا پھرے۔ تکیونی روکتا جد جان کنڈی توڑی آپ"
  56,84,"اُجھے۔ تتنگ اس ویلہ دیکتا"
  56,85,"میں تیاہاں اس ویلہ تارتے اُس کے زیادہ نیڈے میں وارتم دیکتا"
  56,86,"نہیں۔ فر جی قدیتاں کسے کا قابوما نہیں ہے۔"
  56,87,"تا اس جانا وابس مولیا جی کرتاں سچ ہے۔"
  56,88,"ہے۔ فر جی وہ مقرب لوگا"
  56,89,"مجھومو ہے۔ تا اس وستے عرام ترسک تے خوش وہ علام میوات انیمت پری جننط"
  56,90,"رہا۔ تجی وہ سجا پاسہ علام مجھومو ہے۔"
  56,91,"تا تیرہ وسنسیلام تی ہے جی تون سجا پاسہ علام"
  56,92,"مجھوم ہے۔ تجی قدی بھی انکار کرنا لہا گومرا مجھوم ہے۔"
  56,93,"تا عبلتا پانیگی مہمانی"
  56,94,"ویگی تو دوز اخمہ جانو پوے"
  56,95,"گو۔ بھیل اشوبہ یگل یکین انبار حکھ"
  56,96,"ہے۔ تین بی سل اللہ و لی باریو سلم کم اپنا ازمتالہ رب گا ناگی تصبی"
  57,1,"اللہ تعالیٰ کی بیان کریں ہر ویچیز جڑی اسمانا مات زمین میں ہے تیو غالب ہے حکمتالو ہے"
  57,2,"اُسے کی بات چایئے اسمانا مات زمین میں وہی زندگی دیا تو وہی مارے وہ ہر چیز پر قدرت رکھنا لو ہے"
  57,3,"پیلہ میں وہی ہے تو آخر میں وہی ہے باندہ میں وہی ہے تو آولہ میں وہی ہے تو وہ ہر چیزنا جانہ نالو ہے"
