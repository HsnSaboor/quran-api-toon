quran[24]{c,v,t}:
  55,17,"وہ دو آمہ سکانگورابے تے دو آمہ گربانگورابے"
  55,18,"تَتْمْ اَپْنَ رَبْگِ قِدِ قِدِ نِمَتِ مُنْقَرْوِنْگَ"
  55,19,"اُس نے دو سمندر جاری کیا جڑا آپس مرال جے"
  55,20,"ورونہ گبشکار ایک بنو ہے جس تے وی اگنی آسکتا"
  55,21,"تَتَم اپنے ربگی قیدی قیدی نمتے مُنْ کر مِنگا"
  55,22,"انا دو بجو موتی تا مونگا نکلے"
  55,23,"تَتَمْ اَپْلَ رَبْهِ قِدِ قِدِ نِمَتِ مُنْ کرْمِنگا"
  55,24,"تو سے گئی خطیار میں سمندرمہ پڑا آروں اچھا خلاوہ جاز"
  55,25,"تَتَمُ اَپنا رَبْگِ قِدِ قِدِ نِمَتِ مُنْقَرْوِنْگَ"
  55,26,"جو قدویر و از مینوار ہے فنعا نالو ہے"
  55,27,"تچھڑی تارہ رب کی ذات باکی رجے گی جڑوں ازمتالوں تئیز تالو ہے"
  55,28,"تَتْمْ اَپْرَ رَبْگِ قِدِ قِدِ نِمَتِ مُنْ کرْمِنگا"
  55,29,"ہر کوئی جڑو اسمان ماد زمین میں اُسے کنو مگے۔ ہر روز وہ کنوی شان موے۔"
  55,30,"تَتَمْ اَپْنَ رَبْگِ قِدِ قِدِ نِمَتِ مُنْ کرْمِنْغَ"
  55,31,"اے دو پاریج ماتو یعنے جنو انسانو امبلای یعنے اونیں ایتارہ در پوری طرح مطوح جو جنگا"
  55,32,"تتام اپنا ربگی کڑی کڑی نمتے مُن کرنے گا"
  55,33,"اے جنات اینسانا کی جماتو جے قدے تھارے کولے اسمان دزمین کا قندہ تھی بار نکلانگی تاکت ہے تا تم نکل جاو۔ تھی تم بڑی تاکت بغیر نہیں نکل سکتے۔"
  55,34,"تتام اپنا ربگی کڑی کڑی نمتے مُن کر میں گا"
  55,35,"تم دوہور اگہ لنبات سخ تو او جو جیگو فیر تم مقابلوں نہیں کر سکسیں"
  55,36,"تت تم اپنا ربگی کدی کدی نیمتے مون کر میں گا"
  55,37,"تجس و لئے اسمان پت جے گو اور وہ رتا چمڑا رو لال رتا جے گو"
  55,38,"تَتْمْ اَپْنَ رَبْهِ قِدِ قِدِ نَمَتِ مُنْقَرْمِلْقَ"
  55,39,"پھر اس تیارے کسے انسان تکیسے جن کولوں اس کا گنا انگو پچھوں نہیں جا سے"
  55,40,"تَتْمْ اَپْنَ رَبْهِ قِدِ قِدِ نِمَتِ مُنْقَرْمِنْغَ"
