quran[28]{c,v,t}:
  74,48,"فِر انھاں نا سفارش کرن آلاں کی سفارش وی کم نھیں آؤسی؛"
  74,49,"لیکن انھاں نا کے ہو گِیو ہے کہ نصیحت تیں منہ موڑیں؛"
  74,50,"جس طرح وِیہہ بدکے ہویا جنگلی گدھا ہوویں؛"
  74,51,"جہڑا شیر تیں بھجتا ہوویں؛"
  74,52,"بلکہ انھاں وچوں ہر اک شخص کی مرضی ہے کہ اس نا (اللہ آپ) کھلی کتاب دیوے؛"
  74,53,"ہرگز نھیں! (بلکہ اصل ما) یہ لوک آخرت تیں نھیں ڈرتا؛"
  74,54,"بیشک یوہ (قرآن) نصیحت ہے؛"
  74,55,"فِر جس کی مرضی ہووے، نصیحت پکڑ لوے؛"
  74,56,"پر وِیہہ وی نصیحت نھیں لے سکتا، جد تک اللہ تعالیٰ توفیق نہ دیوے؛ وہی (اللہ) خوف کا لائق ہے تے وہی ہے بخششن آلو وی!"
  75,1,"قسم ہے روزِ قیامت کی؛"
  75,2,"نالے قسم ہے (برائی ور) ٹوکن آلا (نفسِ لوامہ) کی؛"
  75,3,"بھلا انسان ایہہ سوچے کہ ہم اس کی ہڈیاں (دوبارہ) نھیں جوڑ سکاں؟"
  75,4,"کیوں نھیں! بلکہ ہم نا تاں اتنی قدرت ہے کہ ہم اس کی انگلیاں کا پور پور وی برابر کر لیاں گا؛"
  75,5,"بلکہ انسان کی تاں مرضی ہے کہ وہ اگے (آئندہ وی) گناہ کرتو رہے؛"
  75,6,"وہ (مخول نال) پچھے کہ (دیکھو مننا وی دسو) قیامت کد آوے گی؟"
  75,7,"پر جس گھڑی اکھ چندھی ہو جائیں گی؛"
  75,8,"تے چن نا گرہن لگ جاوے گو؛"
  75,9,"تے سورج تے چن جڑ جائیں گا؛"
  75,10,"اس دن انسان سوچے گو کہ، ہُن کتھے بھجوں!"
  75,11,"ہرگز نھیں، اج کوئی ٹھاہر نھیں؛"
  75,12,"اس دن صرف تیرا رب کول ہی (محفوظ) ٹھکانو ہووے گو؛"
  75,13,"اس دن انسان نا (سب کجھ) دَس دیو جاوے گو کہ اگے کے بھیجیو تے پچھے کے چھوڑیو تھا؛"
  75,14,"بلکہ انسان اپنے اوپر آپے ہی شاہد (گواہ) ہے؛"
  75,15,"بھانویں جتنا مرضی بہانا کرے؛"
  75,16,"(اے نبیؐ!) تم اس (قرآن نا یاد کرن واسطے) جلدی نہ کریا کرو؛"
  75,17,"بیشک اس نا (دل ما) جمع کرنو تے پڑھانو مھارے ذمے ہے؛"
  75,18,"بلکہ جد ہم پڑھ لیاں (جبرائیلؑ کی زبان تیں) فِر تم اسے طرح دہرایا کرو؛"
  75,19,"فِر یوہ سمجھا دینو وی بیشک مھاری ذمہ داری ہے؛"
