quran[28]{c,v,t}:
  74,48,"ہُن سفارش کرن آلیاں کی سفارش انھاں کا کجھ کام نھیں آسے"
  74,49,"پھر انھاں نا کے ہو گیو کہ یہ نصیحت تیں مُونھ موڑ رہے ہیں؟"
  74,50,"جنھیں یہ ترایہ ہویا جنگلی کھوتے ہیں"
  74,51,"جہڑا شیر تیں ڈر کے نسدا ہووے"
  74,52,"بلکہ انھاں وِچوں ہر ایک شخص یہ چاہے ہے کہ اس نا کھلی کتاب دِتی جائے"
  74,53,"ایسو کدے نھیں ہو سکے، اصل گل یہ ہے کہ یہ آخرت تیں نھیں ڈردا"
  74,54,"بالکل نھیں! یہ تاں ایک نصیحت ہے"
  74,55,"پھر جس کو دل کرے وہ نصیحت حاصل کر لے"
  74,56,"تے یہ نصیحت تاں ہی حاصل کر سکیں جد اللہ تعالیٰ چاہے، وہی ہے جس تیں ڈرنو چاہیے تے وہی معاف کرن آلو ہے"
  75,1,"میں قسم کروں قیامت کا دیہاڑا کی"
  75,2,"تے میں قسم کروں گناہ ور ملامت کرن آلا نفس کی"
  75,3,"کے انسان یہ سوچے ہے کہ ہم اس کی ہڈیاں کٹھی نھیں کر سکاں گا؟"
  75,4,"کیوں نھیں! ہم تاں اس کا پوٹا پوٹا نا وی ٹھیک بنا سکاں"
  75,5,"بلکہ انسان تاں یہ چاہے کہ اگے اگے ہور بدعنوانی کرتو جائے"
  75,6,"پُچھے ہے کہ قیامت کو دیہاڑو کد ہووے گو؟"
  75,7,"سو جس ویلے اکھیاں پتھرا جانگی یعنی چمکاریاں جانگی"
  75,8,"تے چَن بے نور ہو جائے گو"
  75,9,"تے سورج تے چَن کٹھا کر دِتا جاونگا"
  75,10,"اس دیہاڑے انسان کہے گو کہ ہُن کِنگا نسوں؟"
  75,11,"ہرگز نھیں! نسن کی کوئی جگہ نھیں"
  75,12,"اس دیہاڑے تاں تیرا رب کولے ہی ٹھکانو ہووے گو"
  75,13,"اس دیہاڑے انسان نا دَس دِتو جائے گو جو اس نے اگے کے ٹورِیو تے پیچھے کے چھوڑیو"
  75,14,"بلکہ انسان تاں آپ ہی اپنے اوپر دلیل ہے"
  75,15,"بھاویں کتنا ہی عذر بہانہ پیش کرے"
  75,16,"(اے نبیؐ) صلی اللہ علیہ وسلم! تم تاولاں قرآن یاد کرن واسطے اپنی زبان نا نہ ہلاؤ"
  75,17,"بے شک اس نا جمع کرنو تے پڑھا دینوں مھارے ذمے ہے"
  75,18,"لہٰذا جس ویلے ہم اس نا پڑھ لِیاں پھر تم بھی اسی طرح پڑھیا کرو"
  75,19,"پھر اس نا کھول کھول کے بیان کرنو مھارے ذمے ہے"
