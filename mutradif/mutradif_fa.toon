-40:78-41:14-41:35-41:43-41:47-42:14-42:23-42:48-42:51-43:7-43:20-43:23-43:27-43:48-43:58-43:59-43:66-43:67-43:86-44:8-44:35-44:39-44:42-44:56-45:17-45:24-45:25-45:32-46:3-46:9-46:17-46:21-46:25-46:35-47:18-47:19-48:15-50:18-51:42-51:52-51:56-53:4-53:23-53:26-53:28-53:29-53:32-53:39-54:34-54:50-55:33-55:60-56:26-56:79-57:20-57:22-57:27-58:2-58:7-58:10-59:14-59:22-59:23-60:4-64:11-64:13-65:1-65:7-67:9-67:19-67:20-68:52-69:36-69:37-70:22-70:30-71:6-71:21-71:24-71:27-71:28-72:23-72:27-73:2-73:9-74:24-74:25-74:31-74:39-74:56-76:30-78:25-78:30-78:38-79:46-81:27-81:29-83:12-84:25-85:8-87:7-88:6-88:23-92:15-92:20-95:6-98:4-98:5-103:3,609
1897,405,ع,غَیْر,«غَیْر» کا لفظ کبھی تو صرف نفی کے لیے آتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ ہُوَ فِی الۡخِصَامِ  غَیۡرُ  مُبِیۡنٍ» ( 43/18 )\nترجمه : آیا کسی را که در لابلای زینتها پرورش می‌یابد و به هنگام جدال قادر به تبیین مقصود خود نیست (فرزند خدا می‌خوانید)؟\nاور کبھی استثناء کے لیے آتا ہے ۔ اس صورت میں یہ نکرہ کی صفت بن سکتا ہے (مف)\nمثلاً : ارشاد باری تعالیٰ ہے :\n«ہَلۡ مِنۡ خَالِقٍ غَیۡرُ اللّٰہِ» ( 35/3 )\nترجمه : (به یاد آورید) هنگامی را که همسرِ «عمران» گفت: «خداوندا! آنچه را در رحم دارم، برای تو نذر کردم، که «محرَّر» (و آزاد، برای خدمت خانه تو) باشد. از من بپذیر، که تو شنوا و دانایی,«غَیْر» [کہ نہ] «غَیْر» اسدر استثناء کے ساتھ نفی کا مفہوم بھی پایا جاتا ہے ۔,کہ نہ / غیر از / برای غیر / نہ خواھان باشد / جزاو / بدون / غیر,غیر,1:7-2:59-2:173-2:230-2:240-3:83-3:85-3:154-4:12-4:24-4:25-4:46-4:56-4:81-4:82-4:95-4:115-4:140-5:1-5:3-5:5-5:77-5:106-6:14-6:40-6:46-6:68-6:93-6:99-6:114-6:141-6:145-6:164-7:53-7:59-7:65-7:73-7:85-7:140-7:162-8:7-9:2-9:3-9:39-10:15-11:46-11:50-11:57-11:61-11:63-11:65-11:76-11:84-11:101-11:108-11:109-13:4-14:37-14:48-16:21-16:52-16:115-17:73-20:22-22:5-22:31-23:6-23:23-23:32-24:27-24:29-24:31-24:60-26:29-27:12-27:22-28:32-28:38-28:71-28:72-30:55-33:53-35:3-35:37-39:28-39:64-41:8-43:18-47:15-47:38-50:31-51:36-52:35-52:43-56:86-68:3-70:28-70:30-74:10-84:25-95:6,101
1898,405,ع,دُوْن,«دَان» بمعنی خسیس ہونا ۔ کمزور ہونا ۔ اور «دُوْن» بمعنی پست ، نیچے ، قدر و منزلت میں کمتر ۔ اور «شَیْءٌ دُوْنٌ» بمعنی حقیر ۔ گھٹیا چیز (منجد) اور «دُوْن» بمعنی جو کسی چیز سے قاصر اور کوتاہ ہو (مف) اور «دُوْن» جب سوائے کا معنی دیتا ہے تو اس میں کمتری اور  کمزوری کا پہلو بھی پایا جاتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«یٰۤاَیُّہَا الَّذِیۡنَ اٰمَنُوۡا لَا تَتَّخِذُوۡا بِطَانَۃً مِّنۡ دُوۡنِکُمۡ» ( 3/118 )\nترجمه : ای کسانی که ایمان آورده‌اید! محرم اسراری از غیر خود، انتخاب نکنید! آنها از هرگونه شرّ و فسادی در باره شما، کوتاهی نمی‌کنند. آنها دوست دارند شما در رنج و زحمت باشید. (نشانه‌های) دشمنی از دهان (و کلام) شان آشکار شده؛ و آنچه در دلهایشان پنهان می‌دارند، از آن مهمتر است. ما آیات (و راه‌های پیشگیری از شرّ آنها) را برای شما بیان کردیم اگر اندیشه کنید\nاس میں مسلمانوں کے علاوہ دوسرے اہل مذاہب کی کمتری کا اظہار مقصود ہے ۔\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«اِنَّ اللّٰہَ لَا یَغۡفِرُ اَنۡ یُّشۡرَکَ بِہٖ وَ یَغۡفِرُ  مَا دُوۡنَ ذٰلِکَ لِمَنۡ یَّشَآءُ» ( 4/48 )\nترجمه : خداوند (هرگز) شرک را نمی‌بخشد! و پایین‌تر از آن را برای هر کس (بخواهد و شایسته بداند) می‌بخشد. و آن کسی که برای خدا، شریکی قرار دهد، گناه بزرگی مرتکب شده است\nاس میں ایسے گناہ مراد ہیں جو شرک سے کم درجہ کے ہیں ۔\nاسی طرح ارشاد باری تعالیٰ ہے :\n«مَا لَکُمۡ مِّنۡ دُوۡنِ اللّٰہِ مِنۡ وَّلِیٍّ وَّ لَا نَصِیۡرٍ» ( 2/107 )\nترجمه : آیا نمی‌دانستی که حکومت آسمانها و زمین، از آن خداست؟! (و حق دارد هر گونه تغییر و تبدیلی در احکام خود طبق مصالح بدهد؟!) و جز خدا، ولی و یاوری برای شما نیست. (و اوست که مصلحت شما را می‌داند و تعیین می‌کند)\nاس آیت میں بھی «دُوْن» سوائے کے علاوہ کمتری کا معنی دے رہا ہے ۔,«دُوْن» [برابر] «دُوْن» اسدر استثناء کے ساتھ  کمتری کا مفہوم پایا جاتا ہے ۔,برابر / دیگر / جز / جای / غیر / آیا می خواھید / غير,دون,2:23-2:94-2:107-2:165-3:28-3:64-3:79-3:118-4:48-4:116-4:117-4:119-4:123-4:139-4:144-4:173-5:76-5:116-6:51-6:56-6:70-6:71-6:108-7:3-7:30-7:37-7:81-7:168-7:194-7:197-7:205-8:60-9:16-9:31-9:116-10:18-10:37-10:38-10:66-10:104-10:106-11:13-11:20-11:55-11:101-11:113-12:40-13:11-13:14-13:16-16:20-16:35-16:73-16:86-17:2-17:56-17:97-18:14-18:15-18:26-18:27-18:43-18:50-18:58-18:93-18:102-19:17-19:48-19:49-19:81-21:24-21:29-21:43-21:66-21:67-21:82-21:98-22:12-22:62-22:71-22:73-23:63-25:3-25:17-25:18-25:55-26:93-27:24-27:43-27:55-28:23-28:81-29:17-29:22-29:25-29:41-29:42-31:11-31:30-32:4-32:21-33:17-33:50-34:22-34:41-35:13-35:40-36:23-36:74-37:23-37:86-39:3-39:15-39:36-39:38-39:43-39:45-40:20-40:66-40:74-42:6-42:9-42:31-42:46-43:45-43:86-45:10-46:4-46:5-46:28-46:32-48:27-52:47-53:58-55:62-60:4-62:6-67:20-71:25-72:11-72:22,141
1899,405,ع,وَرَاء,«وَرَاء» لغت اضداد سے ہے ۔ اس کے معنی آگے بھی اور پیچھے بھی ۔ اس پار بھی اس پار بھی ۔ اِدھر بھی اور اُدھر بھی ۔ اسی لحاظ سے یہ سوائے کا معنی بھی دے جاتا ہے ۔ یعنی ان سب اطراف یا چیزوں کے علاوہ ۔\nمثلاً در قرآن کریم آمده است :\n«فَمَنِ ابۡتَغٰی وَرَآءَ ذٰلِکَ فَاُولٰٓئِکَ ہُمُ الۡعٰدُوۡنَ» ( 23/7 )\nترجمه : گفتند: «پروردگارا! ما به خویشتن ستم کردیم! و اگر ما را نبخشی و بر ما رحم نکنی، از زیانکاران خواهیم بود!»\nجس کا مطلب یہ ہے کہ جو شخص خدا کے احکام کے علاوہ اِدھر اُدھر ، آگے یا پیچھے کچھ تلاش کرتا ہے تو وہ غلط کار ہے ۔\nنوٹ : (لغت اضداد ایسے الفاظ کو کہتے ہیں جن کے  دو الگ الگ معنیٰ ہوں اور وہ معنیٰ ایک دوسرے کے مخالف اور متضاد ہوں),«وَرَاء» [غیرآن است] «وَرَاء» ہمہ جہتی  (تمام اطراف) کی استثناء کے لیے آتا ہے ۔,غیرآن است / پشت سرشان / پس پشت ھایشان / جز / پسِ پشتِ سر خویش؟ / در پس آنان / پشت,وراء,2:91-2:101-3:187-4:24-4:102-6:94-11:71-11:92-14:16-14:17-18:79-19:5-23:7-23:100-33:53-42:51-45:10-49:4-57:13-59:14-70:31-76:27-84:10-85:20,24
1900,405,ع,اِسْتَثْنَاء ( ثنی ),«اِسْتَثْنَاء» بمعنی کسی چیز کو عام حکم سے خارج کرنا (منجد) اس مقصد کے لیے «اِلَّا» استعمال ہوتا ہے مگر شرعی اصطلاح میں کسی چیز کو مشیت الہی کے تابع سمجھ کر اسے عام حکم سے خارج کرتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ لَا تَقُوۡلَنَّ لِشَایۡءٍ  اِنِّیۡ  فَاعِلٌ ذٰلِکَ غَدًا اِلَّاۤ اَنۡ یَّشَآءَ اللّٰہُ» ( 18/23 )\nترجمه : و از آسمان، آبی به اندازه معیّن نازل کردیم؛ و آن را در زمین (در جایگاه مخصوصی) ساکن نمودیم؛ و ما بر از بین بردن آن کاملاً قادریم\nاور «اِسْتَثْنَاء» کا لفظ «اِنْ شَاءَ اللہ» کہنے کے بدل کے طور پر استعمال ہوتا ہے ۔\nمثلاً : ارشاد باری تعالیٰ ہے :\n«اِذۡ  اَقۡسَمُوۡا لَیَصۡرِمُنَّہَا مُصۡبِحِیۡنَ وَ لَا  یَسۡتَثۡنُوۡنَ» ( 68/17/18 )\nترجمه : جب انہوں نے قسمیں کھا کھا کر کہا کہ صبح ہوتے ہی باغ کا میوہ توڑ لیں گے ۔ اور ان شا اللہ نہ کہا ۔,«اِسْتَثْنَاء» ان شاء اللہ کہہ کر کسی چیز کو عام حکم سے خارج کرنا ۔,نگفتند / استثنا / استثناء / شاء / ان,استثناء ( ثنی ),68:18,1
1901,406,س,نَامَ,«نَامَ» بمعنی  (نیند) سونا معروف لفظ ہے اور اس کا استعمال عام ہے ( فل 292 ) سونا یا نیند بھی ایک قسم کی موت ہے جس میں روح نفسانی بدن سے جدا ہو کر سیر کرتی پھرتی ہے اور حواس خمسہ کی کارگزاری بہت حد تک کم ہو جاتی ہے کیونکہ وہ ماند پڑ جاتے ہیں ۔ دریں اثناء انسان کی تھکاوٹ دور ہو جاتی ہے ۔ اور وہ ذہنی اور جسمانی سکون کی وجہ سے راحت و آرام حاصل کرتا ہے ۔ «نَوْم» بمعنی نیند اور «مَنَام» بمعنی حالت خواب ۔ نیند کی حالت ۔\nمثلاً در قرآن کریم آمده است :\n«اَفَاَمِنَ اَہۡلُ الۡقُرٰۤی اَنۡ  یَّاۡتِیَہُمۡ  بَاۡسُنَا بَیَاتًا  وَّ ہُمۡ  نَآئِمُوۡنَ» ( 7/97 )\nترجمه : کیا بستی والے اس بات سے بے خوف ہو گئے کہ راتوں رات ان پر ہمارا عذاب آئے اور وہ سوئے ہوئے ہوں ۔,«نَامَ» [خوابت] «نَامَ» بمعنی  (نیند) سونا ، سونے کے لیے عام لفظ ہے ۔,خوابت / خوابیدن شما / خواب / خوابشان می گیرد / شب / مایه / مایۀ,نام,2:255-7:97-8:43-25:47-30:23-37:102-39:42-68:19-78:9,9
1902,406,س,ھَجَعَ,«ھَجَعَ» بمعنی غفلت کی نیند سونا ( فل 161 ) گھوڑے بیچ کر سونا ۔ سوتے میں دنیا و مافیہا سے بے خبر ہو جانا اور صاحبِ مُنْجِد «اَلْھَجَعَۃ» کے معنیٰ رات کے پہلے حصہ کی ہلکی نیند بتلاتے ہیں لیکن یہ صحیح معلوم نہیں ہوتا کیونکہ وہ خود ہی «اَلْھُجَعُ» کے معنی غافل ۔ بے وقوف اور بہت سونے والا کہتے ہیں (منجد) نیز قرآن سے بھی اس کی تائید نہیں ہوتی ۔ لہٰذا  صَاحِبِ فِقْہُ الْلُغَۃ کے معنی ہی صحیح معلوم ہوتے ہیں ۔ البتہ «ھَجُوْع» کا لفظ رات کو سونے سے مختص (خاص) ہے جیسے دوپہر کے سونے کو قیلولہ کہتے ہیں (م ق)\nمثلاً در قرآن کریم آمده است :\n«کَانُوۡا  قَلِیۡلًا مِّنَ الَّیۡلِ مَا یَہۡجَعُوۡنَ وَ  بِالۡاَسۡحَارِ ہُمۡ  یَسۡتَغۡفِرُوۡنَ» ( 51/17،18 )\nترجمه : یا هر مخلوقی که در نظر شما، از آن هم سخت‌تر است (و از حیات و زندگی دورتر می‌باشد، باز خدا قادر است شما را به زندگی مجدد بازگرداند). آنها بزودی می گویند: «چه کسی ما را بازمی‌گرداند؟!» بگو: «همان کسی که نخستین بار شما را آفرید.» آنان سر خود را (از روی تعجب و انکار،) به سوی تو خم می‌کنند و می‌گویند: «در چه زمانی خواهد بود؟!» بگو: «شاید نزدیک باشد,«ھَجَعَ» گہری اور غفلت کی نیند سونا ۔,اندکی / اندكى / شب / خفتند / خوابیدند,ھجع,51:17,1
1903,406,س,رَقَدَ,«رَقَدَ» بمعنی لمبی نیند سونا (فل 161) «اَلرُِّقَاد» بمعنی خوشگوار اور ہلکی سی نیند (مف) «اَلرُّقَدَۃُ» اور «اَلْيَرْقُوْدُ » بمعنی بہت سونے والا اور «اَلرُّقُوْد» بمعنی ہمیشہ سونے والا (منجد) ان سب باتوں سے یہ معلوم ہوتا ہے کہ «رَقَدَ» ایسی نیند ہے جو لمبی بھی ہو ، خوشگوار بھی اور ہلکی بھی ۔ یعنی انسان آہٹ سے جاگ اٹھے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ تَحۡسَبُہُمۡ اَیۡقَاظًا وَّ ہُمۡ رُقُوۡدٌ» ( 18/18 )\nترجمه : و (اگر به آنها نگاه می‌کردی) می‌پنداشتی بیدارند؛ در حالی که در خواب فرو رفته بودند! و ما آنها را به سمت راست و چپ میگرداندیم (تا بدنشان سالم بماند). و سگ آنها دستهای خود را بر دهانه غار گشوده بود (و نگهبانی می‌کرد). اگر نگاهشان می‌کردی، از آنان می‌گریختی؛ و سر تا پای تو از ترس و وحشت پر می‌شد,«رَقَدَ» [خفتہ اند] «رَقَدَ» لمبی اور ہلکی نیند سونا ۔,خفتہ اند / چپ / غار / سگشان / آستانه / آستانۀ,رقد,18:18,1
1904,406,س,قَالَ,«یَقِیْلُ قَیْلًا وَ قَیْلُوْلَۃً» دوپہر کو سونا ۔ دن کے وقت استراحت (آرام) کرنا ( فل 292 )\nمثلاً در قرآن کریم آمده است :\n«وَ کَمۡ مِّنۡ قَرۡیَۃٍ اَہۡلَکۡنٰہَا فَجَآءَہَا بَاۡسُنَا  بَیَاتًا  اَوۡ  ہُمۡ  قَآئِلُوۡنَ» ( 7/4 )\nترجمه : برای مردان، از آنچه پدر و مادر و خویشاوندان از خود بر جای می‌گذارند، سهمی است؛ و برای زنان نیز، از آنچه پدر و مادر و خویشاوندان می‌گذارند، سهمی؛ خواه آن مال، کم باشد یا زیاد؛ این سهمی است تعیین شده و پرداختنی,«قَالَ» دوپہر کو سونا ۔,خواب / شهرها / نيمروز / نیمروز / استراحت,قال,7:4,1
1905,406,س,ضَجَعَ,«ضَجَعَ» پہلو یا کروٹ کے بل لیٹنا ، سستانا ، آرام کرنا  خواہ اونگھ یا نیند آ جائے یا نہ آئے (منجد) ۔ نیم خوابی کی حالت ۔ اور «مَضَاجِع» بمعنی بچھونے ، بستر ، اور «اَضْجَعَہ» بمعنی اس کو سلایا ۔ (م ۔ ق)\nمثلاً در قرآن کریم آمده است :\n«تَتَجَافٰی جُنُوۡبُہُمۡ عَنِ الۡمَضَاجِعِ یَدۡعُوۡنَ رَبَّہُمۡ خَوۡفًا وَّ طَمَعًا» ( 32/16 )\nترجمه : پهلوهایشان از بسترها در دل شب دور می‌شود (و بپا می‌خیزند و رو به درگاه خدا می آورند) و پروردگار خود را با بیم و امید می‌خوانند، و از آنچه به آنان روزی داده‌ایم انفاق می‌کنند,«ضَجَعَ» [کشتار گاہ ھای شان] «ضَجَعَ» سستانے کے لیے پہلو کے بل لیٹنا ، خواہ نیند آ جائے یا نہ آئے ۔,کشتار گاہ ھای شان / خوابگاہ ھا / بسترھا / جاهلیت / جاهليت / بیم / بيم,ضجع,3:154-4:34-32:16,3
1906,406,س,تَھَجَّدَ,«هُجُوْد» بمعنی رات کو سونا بھی اور جاگنا بھی  کبھی سونا کبھی جاگنا (یہ لغت اضداد میں سے ہے ) ۔ اور سوتے جاگتے رات گزارنا  ۔ اور «ھَجَّدَ» بمعنی رات کو جاگ کر نماز پڑھنا (منجد)\nمثلاً در قرآن کریم آمده است :\n«وَ مِنَ الَّیۡلِ فَتَہَجَّدۡ بِہٖ نَافِلَۃً  لَّکَ» ( 17/79 )\nترجمه : و پاسی از شب را (از خواب برخیز، و) قرآن (و نماز) بخوان! این یک وظیفه اضافی برای توست؛ امید است پروردگارت تو را به مقامی در خور ستایش برانگیزد,«تَھَجَّدَ» [پس بگذران بہ بیداری] «تَھَجَّدَ» رات کو نماز تہجد وغیرہ کیلئے بیدار ہونا ، رات کو نماز پڑھنا تہجد پڑھنا ۔ ,مقام محمود جایگاه ستایش شده / پس بگذران بہ بیداری / پاسی / پاسى / مقامی / مقامى / شب,تھجد,17:79,1
1907,407,س,اَسْوَد,«اَسْوَد» کالا رنگ اسکی ضد «اَبْیْضَ» بمعنی سفید رنگ ہے ۔ «اَسْوَد» معروف معنوں میں مستعمل ہے اور اس کا استعمال عام ہے اور اسکی جمع «سُوْد» ہے اور اسکا  مؤنث «سَوْدَاء» ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ کُلُوۡا وَ اشۡرَبُوۡا حَتّٰی یَتَبَیَّنَ لَکُمُ الۡخَیۡطُ الۡاَبۡیَضُ مِنَ الۡخَیۡطِ الۡاَسۡوَدِ  مِنَ الۡفَجۡرِ» ( 2/187 )\nترجمه : آمیزش جنسی با همسرانتان، در شبِ روزهایی که روزه می‌گیرید، حلال است. آنها لباس شما هستند؛ و شما لباس آنها (هر دو زینت هم و سبب حفظ یکدیگرید). خداوند می‌دانست که شما به خود خیانت می‌کردید؛ (و این کارِ ممنوع را انجام می‌دادید؛) پس توبه شما را پذیرفت و شما را بخشید. اکنون با آنها آمیزش کنید، و آنچه را خدا برای شما مقرر داشته، طلب نمایید! و بخورید و بیاشامید، تا رشته سپید صبح، از رشته سیاه (شب) برای شما آشکار گردد! سپس روزه را تا شب، تکمیل کنید! و در حالی که در مساجد به اعتکاف پرداخته‌اید، با زنان آمیزش نکنید! این، مرزهای الهی است؛ پس به آن نزدیک نشوید! خداوند، این چنین آیات خود را برای مردم، روشن می‌سازد، باشد که پرهیزکار گردند,«اَسْوَد» [سیاہ] «اَسْوَد» بمعنی کالا رنگ ۔,سیاہ / سیاہ شدہ / سیاه / سياه / چهره / سپید / سپیدِ,اسود,2:187-3:106-16:58,3
1908,407,س,غَرَابِیْب,«غُرَاب» بمعنی کوّا اسکی جمع «غِرْبَان» ہے  ۔ اور «غِرْبِیْب» بمعنی کوے کی طرح بہت سیاہ اور اسکی جمع «غَرَابِیْب» ہے ۔ (مف) اور «غُرْبِیْب» بمعنی وہ آدمی جو (خضاب) لگا کر بالوں کو سیاہ کرے اسکی جمع «غَرَابِیْب» ہے (م ق)\nمثلاً در قرآن کریم آمده است :\n«وَ مِنَ الۡجِبَالِ جُدَدٌۢ  بِیۡضٌ وَّ حُمۡرٌ  مُّخۡتَلِفٌ اَلۡوَانُہَا وَ غَرَابِیۡبُ سُوۡدٌ» ( 35/27 )\nترجمه : و من (اکنون جنگ را صلاح نمی‌بینم،) هدیه گرانبهایی برای آنان می‌فرستم تا ببینم فرستادگان من چه خبر می‌آورند (و از این طریق آنها را بیازمایم)!»,«غَرَابِیْب» [و برخی کوہ ھا] «غَرَابِیْب» بمعنی بہت زیادہ سیاہ ۔,و برخی کوہ ھا / سیاه / سياه / سرخ / سفید / سفيد / گوناگون,غرابیب,35:27,1
1909,407,س,اَحْوٰی,«اَحْوٰی» سبزی مائل سیاہ رنگ یا سیاہی مائل سرخ رنگ (منجد) در قرآن کریم «غُثَآءً اَحْوٰی» کے الفاظ ہیں ۔ «غُثَآء» اُن ٹہنیوں ، پتوں اور کوڑا کرکٹ کو کہتے ہیں جو جھاگ میں پھنس جاتے ہیں اور دریا اس جھاگ ملے کوڑا کرکٹ کو کنارے پر پھینک دیتا ہے ۔ اور جب یہ کوڑا کرکٹ پاؤں تلے کچلا جاتا رہتا ہے اور اس کی رنگت سیاہی مائل ہو جاتی ہے تو یہ رنگت «اَحْوٰی» کہلاتی ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ الَّذِیۡۤ  اَخۡرَجَ  الۡمَرۡعٰی فَجَعَلَہٗ  غُثَآءً  اَحۡوٰی» ( 87/4،5 )\nترجمه : خداوند، معبودی جز او نیست! و به یقین، همه شما را در روز رستاخیز -که شکی در آن نیست- جمع می‌کند! و کیست که از خداوند، راستگوتر باشد؟,«اَحْوٰی» [سیاہ] «اَحْوٰی» بمعنی سبزی مائل سیاہ رنگ ۔,سیاہ / خشک / خشك / سیاه / سياه / گردانید / گردانيد,احوی,87:5,1
1910,407,س,اَدْھَم,«دَھَمَ» بمعنی کسی چیز کا تاریکی میں ڈھک جانا ۔ اور «اَلدُّھْمَۃ» بمعنی سیاہی  کہتے ہیں (م ۔ ل) ۔ «دَھَّمَتِ النَّارُ الْقِدْرَ» آگ نے ہنڈیا کو سیاہ کر دیا ۔\nمثلاً در قرآن کریم آمده است :\n«مُدۡہَآ  مَّتٰنِ» ( 55/64 )\nترجمه : وہ دونوں باغ خوب گہرے سبز ہوں گے جیسے سیاہ ہو رہے ہوں ۔,«اَدْھَم» بمعنی سیاہی مائل گہرا سبز رنگ ۔,سبزی / سبزى / سياهى / سیاهی / شدّت / شدت / سبز,ادھم,55:64,1
1911,407,س,قَتَرَۃ,«قَتَرَ النَّار» بمعنی آگ کا دھواں دینا (منجد) اور «قَتَرَۃ» بمعنی دھوئیں جیسے رنگ والا گردوغبار ، سیاہی ۔\nمثلاً در قرآن کریم آمده است :\n«وَ وُجُوۡہٌ  یَّوۡمَئِذٍ عَلَیۡہَا غَبَرَۃٌ تَرۡہَقُہَا قَتَرَۃٌ» ( 80/40،41 )\nترجمه : و برای شما در آنها منافع بسیاری (جز اینها) است، تا بوسیله آنها به مقصدی که در دل دارید برسید؛ و بر آنها و بر کشتیها سوار می‌شوید,«قَتَرَۃ» [سیاھی] «قَتَرَۃ» بمعنی  دھوئیں جیسا رنگ ۔,سیاھی / چهره / بهشتند / خواری / خوارى / افزون,قترۃ,10:26-80:41,2
1912,407,س,مِدَاد,«مَدَدْتُ الدَّوَاۃ» بمعنی دوات میں سیاہی یا روشنائی ڈالنا ۔ اور «مِدَادَ» سیاہی ، روشنائی جس سے لکھا جاتا ہے ۔ (مف)\nمثلاً در قرآن کریم آمده است :\n«قُلۡ لَّوۡ کَانَ الۡبَحۡرُ مِدَادًا لِّکَلِمٰتِ رَبِّیۡ لَنَفِدَ الۡبَحۡرُ  قَبۡلَ اَنۡ تَنۡفَدَ کَلِمٰتُ رَبِّیۡ» ( 18/109 )\nترجمه : ( اے پیغمبر لوگوں سے ) کہہ دو کہ : اگر میرے رب کی باتیں لکھنے کے لیے سمندر روشنائی بن جائے ، تو میرے رب کی باتیں ختم نہیں ہوں گی کہ اس سے پہلے سمندر خشک ہوچکا ہوگا ۔,«مِدَاد» [مرّکب] «مِدَاد» بمعنی سیاہی ، روشنائی جس سے لکھا جاتا ہے  ۔,شمردن سخنان الله غیرممکن است / مرّکب / کلمات / كلمات / مرکب / مركب / پایان,مداد,18:109,1
1913,408,س,مُسْتَقِیْم,«مُسْتَقِیْم» وہ چیز ہے جو سیدھی بھی ہو ۔ اور متوازن و معتدل بھی ۔ اور «قَامَ عَلَی الْاَمْر» بمعنی کسی بات پر قائم اور برقرار رہنا ۔ اور «اَقَامَ الشَّیْ» بمعنی کسی چیز کو کھڑا کرنا اور سیدھا کرنا ۔\nمثلاً در قرآن کریم آمده است :\n«وَ زِنُوۡا بِالۡقِسۡطَاسِ الۡمُسۡتَقِیۡمِ» ( 17/35 )\nترجمه : ما را به راه راست هدایت کن\nکیونکہ اگر ترازو کی ڈنڈی جو پہلے ہی سیدھی ہوتی ہے اگر افقی  لائن میں متوازی نہ رہے گی تو تول بھی متوازن نہ رہے گا حالانکہ ڈنڈی تو بہرحال سیدھی ہی ہوتی اور رہتی ہے خواہ ایک پلڑا نیچے جھکا ہوا ہو ۔ گویا یہاں سیدھی سے مراد فقی سمت میں سیدھی ہے یعنی وہ متوازی بھی رہے ۔ اور علم جیومیٹری کی رو سے دو نقاط یا دو مقامات کے درمیان کم سے کم فاصلہ کو خط مستقیم کہتے ییں گویا صراط مستقیم وہ راستہ ہے جو سیدھا بھی ہو اور اس میں کسی طرح کی جھول ، لچک اور ڈھلک بھی نہ ہو یعنی افراط و تفریط (کمی و زیادتی) سے پاک ہو ۔\nمثلاً : قرآن میں ہمیں یہ دعا سکھلائی گئی ہے :\n«اِہۡدِ نَا الصِّرَاطَ الۡمُسۡتَقِیۡمَ» ( 1/5 )\nترجمه : ای کسانی که ایمان آورده‌اید! به پیمانها (و قراردادها) وفا کنید! چهارپایان (و جنین آنها) برای شما حلال شده است؛ مگر آنچه بر شما خوانده می‌شود (و استثنا خواهد شد). و به هنگام احرام، صید را حلال نشمرید! خداوند هر چه بخواهد (و مصلحت باشد) حکم می‌کند,«مُسْتَقِیْم» [راست] «مُسْتَقِیْم» متوازن ، معتدل اور سیدھا ۔,راست / راست را / در حالی کہ راست است / راست تو / راست است / راست است؟ / راستِ,مستقیم,1:5-2:142-2:213-3:51-3:101-4:68-4:175-5:16-6:39-6:87-6:126-6:153-6:161-7:16-9:7-10:25-10:89-11:56-15:41-16:76-16:121-17:35-19:36-22:54-22:67-23:73-24:46-26:182-36:4-36:61-37:118-41:6-42:52-43:43-43:61-43:64-46:30-48:2-48:20-67:22-81:28,41
1914,408,س,سَوٰی ۔ سَوِیّ,«سَوِیَ یَسْوِی» بمعنی کسی چیز کا درست ہونا ۔ اور «سَوّٰی» بمعنی درست اور ہموار کرنا ۔ اور «سَوِیَ» بمعنی ہموار اور درست ، تندرست ۔\nمثلاً در قرآن کریم آمده است :\n«فَتَمَثَّلَ لَہَا بَشَرًا سَوِیًّا» ( 19/17 )\nترجمه : و میان خود و آنان حجابی افکند (تا خلوتگاهش از هر نظر برای عبادت آماده باشد). در این هنگام، ما روح خود را بسوی او فرستادیم؛ و او در شکل انسانی بی‌عیب و نقص، بر مریم ظاهر شد\nاور «صِرَاطًا سَوِیًّا» بھی ایسے راستے کو کہتے ہیں جو درست ، ہموار اور سیدھا ہو ۔ اس میں نہ اونچ نیچ ہو اور نہ ٹیڑھا پن ۔\nمثلاً : ارشاد باری تعالیٰ ہے :\n«فَاتَّبِعۡنِیۡۤ  اَہۡدِکَ صِرَاطًا سَوِیًّا» ( 19/43 )\nترجمه : آنها فرشتگان را که بندگان خداوند رحمانند مؤنّث پنداشتند؛ آیا شاهد آفرینش آنها بوده اند؟! گواهی آنان نوشته می‌شود و (از آن) بازخواست خواهند شد\nاور «سَوَاء» کا لفظ برابر کے معنوں میں آتا ہے ۔ یہ برابری اگر دونوں اطراف سے فاصلہ یا تعداد کے لحاظ سے ہو تو اس کے لیے وسط کا لفظ آئے گا ۔ اور اگر ہر لحاظ سے برابری مقصود ہو تو «سَوَاء» کا لفظ استعمال ہو گا گویا اس کا معنی مرکزی نقطہ یا بیچوں بیچ ہو گا ۔\nمثلاً در قرآن کریم آمده است :\n«خُذُوۡہُ فَاعۡتِلُوۡہُ  اِلٰی سَوَآءِ الۡجَحِیۡمِ» ( 44/47 )\nترجمه : (آنگاه به مأموران دوزخ خطاب می‌شود:) این کافر مجرم را بگیرید و به میان دوزخ پرتابش کنید\nاور «سَوَآءَ السَّبِیْل» کے معنی وہ راستہ ہو گا جو ہر طرح کی ضلالت ، کفر اور گمراہیوں کو اپنی اطراف میں چھوڑتا ہوا درمیان میں سے سیدھا نکل جاتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ لَمَّا تَوَجَّہَ  تِلۡقَآءَ مَدۡیَنَ قَالَ عَسٰی رَبِّیۡۤ   اَنۡ  یَّہۡدِیَنِیۡ  سَوَآءَ  السَّبِیۡلِ» ( 28/22\nترجمه : خدا از بنی اسرائیل پیمان گرفت. و از آنها، دوازده نقیب [= سرپرست‌] برانگیختیم. و خداوند (به آنها) گفت: «من با شما هستم! اگر نماز را برپا دارید، و زکات را بپردازید، و به رسولان من ایمان بیاورید و آنها را یاری کنید، و به خدا قرض الحسن بدهید [= در راه او، به نیازمندان کمک کنید]، گناهان شما را می‌پوشانم [= می بخشم‌]؛ و شما را در باغهایی از بهشت، که نهرها از زیر درختانش جاری است، وارد می‌کنم. اما هر کس از شما بعد از این کافر شود، از راه راست منحرف گردیده است,«سَوَیّ» ہموار ، سیدھا اور درست ۔\n«سَوَاء» درمیان سے گزرنے والا سیدھا راستہ ۔,روح / روحِ / دمیدم، / دميدم، / سجده / درست,سوی ۔ سوی,4:42-15:29-19:10-19:17-19:43-20:58-20:135-26:98-38:72-67:22-75:4-75:38-87:2,13
1915,408,س,قَصْد,«قَصْد» کسی چیز کے جائز استعمال کو قصْد کہتے ہیں ۔ مثلاً ایک شخص اگر ایک بالٹی پانی سے نہا سکتا ہے اگر وہ اتنا ہی استعمال کرے تو یہ قصد ہے تو اگر زیادہ استعمال کرے گا تو یہ اسراف ہے اور بالٹی سے کم پانی استعمال کرے گا تو یہ بخل ہے ۔ اور ہر معاملہ میں اس بات کا لحاظ رکھنے اور اسے عادت بنا لینے کا نام اقتصاد ہے ۔ اب معنوی لحاظ سے دیکھیے تو ہر جگہ نہ صرف نرمی سے کام نکل سکتا ہے اور نہ ہی سختی سے ۔ اب کسی جگہ کتنی سختی کی جائے یا کسی حد تک نرمی سے کام لیا جائے تاکہ منزل مقصود حاصل ہو سکے  تو یہ بتلانا شریعت کا کام ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ عَلَی اللّٰہِ  قَصۡدُ السَّبِیۡلِ وَ مِنۡہَا جَآئِرٌ» ( 16/9 )\nترجمه : و بر خداست که راه راست را (به بندگان) نشان دهد؛ امّا بعضی از راه‌ها بیراهه است! و اگر خدا بخواهد، همه شما را (به اجبار) هدایت می‌کند (؛ ولی اجبار سودی ندارد)\n«قَصْد» : کا معنیٰ درمیانی معتدل کرنے سے بھی صحیح مفہوم ادا نہیں ہوتا ۔ لہذا اس کا معنیٰ سیدھا ہی کر لیا جاتا ہے ۔,«قَصْد» [کوتاہ و آسان] «قَصْد» اقدار کی صحیح تعیین کرنے والا اور افراط و تفریط سے پاک سیدھا راستہ ۔,کوتاہ و آسان / نمودن / و میانہ باش / میانه / ميانه / سفری / سفرى,قصد,9:42-16:9-31:19,3
1916,408,س,سَدِیْدًا,«سَدُّ » بمعنی روک ۔ آڑ یا دیوار جو دو چیزوں کے درمیان بنائی گئی ہو ۔ اور «سُدٌّ» بمعنی پتھروں سے شگاف بند کرنا ۔ اور «سِدَاد» اس مسالہ کو کہتے ہیں جس سے رخنہ یا شگاف پُر کیا جائے اور «قَوْلاً سَدِیْدًا» وہ بات ہے جس میں کوئی رکاوٹ ، نقص یا خرابی یا کوئی  پیچیدگی  اور مکرو فریب نہ ہو ۔ صحیح درست سچی اور سیدھی بات ۔ اور اس کی ضد «قَوْلَ الزُّوْر» ہے جو جھوٹ سے بہت زیادہ وسیع مفہوم رکھتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«فَلۡیَتَّقُوا اللّٰہَ وَ لۡیَقُوۡلُوۡا قَوۡلًا سَدِیۡدًا» ( 4/9 )\nترجمه : کسانی که اگر فرزندان ناتوانی از خود بیادگار بگذارند از آینده آنان می‌ترسند، باید (از ستم درباره یتیمان مردم) بترسند! از (مخالفت) خدا بپرهیزند، و سخنی استوار بگویند,«سَدِیْدًا» [استوار] «سَدِیْدًا» ایسی چیز جس در کوئی رکاوٹ نہ ہو ۔ مضبوط ، صاف اور سیدھا ۔,استوار / استوار را / بترسند / سخنی / سخنى / درست / بگویند,سدیدًا,4:9-33:70,2
1917,409,س,سُلَّم,«سُلَّم» یہ لفظ معارج یا معراج سے عام ہے ۔ گو «سُلَّم» کا لفظ مکان میں اینٹ پتھر سے بنی ہوئی چھت پر جانے والی سیڑھی اور لکڑی کے زینہ کے لیے استعمال ہوتا ہے ۔ تاہم «سُلَّم» اس چیز کو کہہ سکتے ہیں جو کسی بلند جگہ تک پہنچنے کا وسیلہ بنے اور اسکی جمع «سَلاَلِمُ» اور «سَلَالِیْم» ہے ۔ اور «اَدْرَاجُ السُّلَم» بمعنی سیڑھی کے ڈنڈے یا اڈے (منجد)\nمثلاً در قرآن کریم آمده است :\n«فَاِنِ اسۡتَطَعۡتَ اَنۡ تَبۡتَغِیَ نَفَقًا فِی الۡاَرۡضِ اَوۡ  سُلَّمًا فِی السَّمَآءِ» ( 6/35 )\nترجمه : و اگر اعراض آنها بر تو سنگین است، چنانچه بتوانی نقبی در زمین بزنی، یا نردبانی به آسمان بگذاری (و اعماق زمین و آسمانها را جستجو کنی، چنین کن) تا آیه (و نشانه دیگری) برای آنها بیاوری! (ولی بدان که این لجوجان، ایمان نمی‌آورند!) امّا اگر خدا بخواهد، آنها را (به اجبار) بر هدایت جمع خواهد کرد. (ولی هدایت اجباری، چه سودی دارد؟) پس هرگز از جاهلان مباش,«سُلَّم» [نردبانی را] «سُلَّم» بمعنی  سیڑھی، زینہ ۔,نردبانی را / نردبانی است کہ / نردبانی / نردبانى / بیاوری / بياورى / مباش,سلم,6:35-52:38,2
1918,409,س,مَعَارِج,«مِعْرَاج» کی جمع «عَرَجَ» ہے  بمعنی لنگڑا کر چلنا ۔ اور «اَعْرَج» بمعنی لنگڑا «عَرَجَ فِی السُّلم» بمعنی سیڑھی پر چڑھنا ۔ اور «مِعْرَاج» بمعنی چڑھنے کی جگہ (منجد) گویا «مِعْرَاج» کا لفظ «سُلَّم» سے زیادہ خاص ہے ۔ اس میں سیڑھی کے ذریعہ کسی بلند مقام پر پہنچ جانے کا تصور پایا جاتا ہے جبکہ «سُلَّم» محض سیڑھی کو کہتے ہیں ۔ مثلاً در قرآن کریم آمده است :\n«وَّ مَعَارِجَ عَلَیۡہَا یَظۡہَرُوۡنَ» ( 43/33 )\nترجمه : اگر (تمکّن کفّار از مواهب مادی) سبب نمی‌شد که همه مردم امت واحد (گمراهی) شوند، ما برای کسانی که به (خداوند) رحمان کافر می‌شدند خانه‌هایی قرار می‌دادیم با سقفهایی از نقره و نردبانهایی که از آن بالا روند،,«مَعَارِج» [و نیز نردبان ھایی] «مَعَارِج» بمعنی چڑھنے کی جگہ ۔,و نیز نردبان ھایی / نقره / درجات / بالا / صاحب / صاحبِ,معارج,43:33-70:3,2
1919,410,س,تَعَلَّمَ,«عَلِمَ» بمعنی جاننا یا کسی چیز کی حقیقت کو پانا ہے ۔ اور «عَلَّمَ» بمعنی بار بار کثرت کے ساتھ کسی کو خبر دینا یعنی سکھلانا اور «تَعَلَّمَ» بمعنی آہستہ آہستہ کسی خبر کے اثر کو قبول کرتے جانا ہے ، سیکھتے جانا ، سیکھنا (مف)\nمثلاً در قرآن کریم آمده است :\n«وَ عَلَّمَ اٰدَمَ الۡاَسۡمَآءَ کُلَّہَا» ( 2/31 )\nترجمه : این آیات کتاب حکیم است (کتابی پرمحتوا و استوار)\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«فَیَتَعَلَّمُوۡنَ مِنۡہُمَا مَا یُفَرِّقُوۡنَ بِہٖ بَیۡنَ الۡمَرۡءِ  وَ زَوۡجِہٖ» ( 2/102 )\nترجمه : و (یهود) از آنچه شیاطین در عصر سلیمان بر مردم می‌خواندند پیروی کردند. سلیمان هرگز (دست به سحر نیالود؛ و) کافر نشد؛ ولی شیاطین کفر ورزیدند؛ و به مردم سحر آموختند. و (نیز یهود) از آنچه بر دو فرشته بابل «هاروت» و «ماروت»، نازل شد پیروی کردند. (آن دو، راه سحر کردن را، برای آشنایی با طرز ابطال آن، به مردم یاد می‌دادند. و) به هیچ کس چیزی یاد نمی‌دادند، مگر اینکه از پیش به او می‌گفتند: «ما وسیله آزمایشیم کافر نشو! (و از این تعلیمات، سوء استفاده نکن!)» ولی آنها از آن دو فرشته، مطالبی را می‌آموختند که بتوانند به وسیله آن، میان مرد و همسرش جدایی بیفکنند؛ ولی هیچ گاه نمی‌توانند بدون اجازه خداوند، به انسانی زیان برسانند. آنها قسمتهایی را فرامی‌گرفتند که به آنان زیان می‌رسانید و نفعی نمی‌داد. و مسلما می‌دانستند هر کسی خریدار این گونه متاع باشد، در آخرت بهره‌ای نخواهد داشت. و چه زشت و ناپسند بود آنچه خود را به آن فروختند، اگر می‌دانستند,«تَعَلَّمَ» [ولی می آمو ختند] «تَعَلَّم» بمعنی خود سیکھنا اور «عَلَّمَ» بمعنی کسی کو سکھلانا ۔,ولی می آمو ختند / و می آمو ختند / می دادید / کہ می آموزید بہ آنھا / بیاموزی بہ من / وھر آینہ خواھید دانست / آموخته,تعلم,2:31-2:32-2:102-2:129-2:151-2:251-2:282-3:48-3:79-3:164-4:113-5:4-5:110-6:91-12:6-12:21-12:68-12:101-16:103-18:65-18:66-20:71-21:80-26:49-27:16-36:69-44:14-53:5-55:2-55:4-62:2-96:4-96:5,33
1920,410,س,تَلَقّٰی,«لَقِیَ» بمعنی ملنا ، ملاقات کرنا ، پانا ، دیکھنا ، اور «تَلَقّٰی» بمعنی کسی کا استقبال کرنا ۔ اور «تَلَقَّی الشَّیْءُ مِنْہُ» کسی سے کچھ سیکھنے کے معنوں میں آتا ہے (منجد) اور «تَلَقّٰی» بمعنی اِلقاء یعنی دل میں بات ڈالنا اور اس سے کچھ سیکھنا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«فَتَلَقّٰۤی اٰدَمُ مِنۡ رَّبِّہٖ کَلِمٰتٍ فَتَابَ عَلَیۡہِ» ( 2/37 )\nترجمه : و به نهی‌کنندگان و (بازدارندگان),«تَلَقّٰی» [سپس دریافت کرد] «تَلَقّٰی» القاء کے ذریعہ سے کچھ سیکھنا ۔,سپس دریافت کرد / پس انداختہ شوی / القاء و آموختہ می شود بہ تو / دریافت / دريافت / ساحران / افكنى,تلقی,2:37-7:115-17:39-20:65-27:6-60:1,6
1921,410,س,کَلَّبَ,«کَلْب» بمعنی کتا ۔ اور «کَلَّبَ الْکَلْب» بمعنی کتے کو شکار کی تعلیم دینا اور سدھانا ہے ۔ اور «مُکَلِّب» اور «کَلَّاب» اس شخص کو کہتے ہیں جو شکار کرنے کی تعلیم دیتا یا سدھاتا ہو ۔ پھر «کَلَّب» کا استعمال صرف کتوں کو سکھلانے کے لیے ہی نہیں بلکہ دوسرے شکاری جانوروں ، پرندوں وغیرہ کے لیے بھی ہوتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ مَا عَلَّمۡتُمۡ مِّنَ الۡجَوَارِحِ مُکَلِّبِیۡنَ تُعَلِّمُوۡنَہُنَّ» ( 5/4 )\nترجمه : از تو سؤال می‌کنند چه چیزهایی برای آنها حلال شده است؟ بگو: «آنچه پاکیزه است، برای شما حلال گردیده؛ (و نیز صید) حیوانات شکاری و سگهای آموخته (و تربیت یافته) که از آنچه خداوند به شما تعلیم داده به آنها یاد داده‌اید، (بر شما حلال است؛) پس، از آنچه این حیوانات برای شما (صید می‌کنند و) نگاه می‌دارند، بخورید؛ و نام خدا را (به هنگام فرستادن حیوان برای شکار،) بر آن ببرید؛ و از (معصیت) خدا بپرهیزید که خداوند سریع الحساب است!»,«کَلَّبَ» [در حالی کہ آموزندگان سگ ھای شکارید] «کَلَّب» شکاری جانوروں کو شکار کی تعلیم دینا سکھلانا سدھانا ۔,درباره حیوانات آموزش دیده برای شکار / در حالی کہ آموزندگان سگ ھای شکارید / شکاری / شكارى / پرسند / حیوانات / حيوانات,کلب,5:4,1
1922,411,ش,فَرَعَ,«فَرَعَ» بمعنی شاخ اسکی ضد «اصل» بمعنی جڑ ہے ۔ «فَرَعَ» کی جمع «فُرُوْع» ہے ۔ بمعنی ( درخت کی ) ٹہنیاں ۔ اور امام راغب کہتے ہیں کہ ہر چیز کا اوپر کا حصہ جو جڑ سے نکلا ہو وہ «فَرَعُ الشَّجَر» ہے (مف)\nمثلاً در قرآن کریم آمده است :\n«مَثَلًا کَلِمَۃً طَیِّبَۃً  کَشَجَرَۃٍ  طَیِّبَۃٍ اَصۡلُہَا ثَابِتٌ وَّ فَرۡعُہَا فِی  السَّمَآءِ» ( 14/24 )\nترجمه : آیا ندیدی چگونه خداوند «کلمه طیبه» (و گفتار پاکیزه) را به درخت پاکیزه‌ای تشبیه کرده که ریشه آن (در زمین) ثابت، و شاخه آن در آسمان است؟\nاور اس لفظ کا استعمال مادی اور معنوی دونوں شکلوں میں ہوتا ہے ۔ فروعی مسائل ایسے مسائل کو کہتے ہیں جو کسی دوسری چیز ( اصل ) پر مبنی ہوں اور اس پر ان کو قیاس کیا گیا ہو ۔ مگر اس کی مثال قرآن میں نہیں ہو۔,«فَرَعَ» [و شاخہ اش] «فَرَعَ» کسی چیز کی اصل کے علاوہ جو کچھ اس سے نکلے وہ اس کی «فَرَع» ہے ۔,و شاخہ اش / شاخه / ریشه / ريشه / ندیدی / نديدى / درختى,فرع,14:24,1
1923,411,ش,شُعَب,«شُعْبَۃ» کی جمع «شَعْب» ہے اور اسکے معنی میں دو باتیں بنیادی طور پر پائی جاتی ہیں ۔ (1) افتراق یعنی جدا ہونا اور (2) اِجماع یعنی جمع ہونا ۔ لیکن یہ لغت اضداد سے نہیں ہے بلکہ ہر ایسی چیز پر ہر اس لفظ کا اطلاق ہوتا ہے جو آگے جا کر کئی حصوں میں بٹ جائے (م ۔ ل) مثلاً «تَشَعَّبُ النَّھْر» بمعنی نہر سے کئی شاخیں نکلنا یا جیسے ہاتھ کی انگلیاں ، اور «شَعْبُ» بمعنیٰ بڑا قبیلہ  (منجد)\nمثلاً در قرآن کریم آمده است :\n«اِنۡطَلِقُوۡۤا  اِلٰی ظِلٍّ  ذِیۡ ثَلٰثِ شُعَبٍ» ( 77/30 )\nترجمه : ایسے سائے کی طرف چلو جس کی تین شاخیں ہیں ۔ ( یعنی آگے جا کر تین حصوں میں بٹ گیا ہے ۔,«شُعَب» [شعبہ است] «شُعْبَہ» کسی چیز کا کئی حصوں در اس طرح  بٹنا کہ اصل سے تعلق بدستور باقی رہے ۔,شعبہ است / سه / بروید / برويد / سایه / سایۀ / شاخه,شعب,77:30,1
1924,411,ش,اَفْنَان,«اَفْنَان» جمع ہے «فَنَن» کی اور «فَنَن» بمعنی درخت کی بہت موٹی اور لمبی شاخ  اور «شَجَرَۃٌ فَنَانٌ» بمعنی بہت موٹی اور لمبی شاخوں والا درخت (م ق)\nمثلاً در قرآن کریم آمده است :\n«ذَوَاتَاۤ   اَفۡنَانٍ» ( 55/48 )\nترجمه : (آن دو باغ بهشتی) دارای انواع نعمتها و درختان پرطراوت است,«اَفْنَان» [با شاخہ ھای گوناگون] «اَفْنَان» بمعنیٰ ٹہنیاں اور شاخیں ۔,با شاخہ ھای گوناگون / دارای / داراى / درختان / انواع / باغ,افنان,55:48,1
1925,412,ش,رَوَاح,«رَوَاح» زوال آفتاب یعنی ظہر کے بعد یہ وقت شروع ہو جاتا ہے ۔ «رَوَاح» بمعنی پچھلا پہر اور اس کی ضد «غُدُوّ» یا «غُدْوَۃ» ہے بمعنی صبح کا وقت ( فل 292 ) اور «اَلْغُدُوُّ وَ الرَّوَاح» پہلے اور پچھلے پہر کی آمد و رفت کے لیے استعمال ہوتے ہیں ۔\nمثلاً در قرآن کریم آمده است :\n«وَ لِسُلَیۡمٰنَ الرِّیۡحَ غُدُوُّہَا شَہۡرٌ وَّ رَوَاحُہَا شَہۡرٌ» ( 34/12 )\nترجمه : پروردگارش دعای او را اجابت کرد؛ و مکر آنان را از او بگردانید؛ چرا که او شنوا و داناست,«رَوَاح» [و باز گشت شبانگاھی اش] «رَوَاح» بمعنی سہ پہر زوال آفتاب کے بعد سے مغرب تک کا وقت ۔,و باز گشت شبانگاھی اش / مس / سلیمان / سليمان / باد / چشمه / چشمۀ,رواح,34:12,1
1926,412,ش,اَصِیْلًا,«اَصِیْلًا» کی جمع «اٰصَال» ہے ۔ «اَصِیْلًا» شام یعنی عصر کے بعد کے وقت کو کہتے ہیں ۔ اور اس کی ضد «بُکْرَۃ» ہے بمعنی صبح کا وقت  ( ف ل 292 )\nمثلاً در قرآن کریم آمده است :\n«وَ اذۡکُرِ اسۡمَ  رَبِّکَ بُکۡرَۃً  وَّ اَصِیۡلًا» ( 76/25 )\nترجمه : و نام پروردگارت را هر صبح و شام به یاد آور,«اَصِیْلًا» [و شام] «اَصِیْلًا» عصر کے بعد کے وقت کو کہتے ہیں ۔,و شام / و شامگاہ / شام / صبح / بامدادان / شامگاهان,اصیلًا,7:205-13:15-24:36-25:5-33:42-48:9-76:25,7
1927,412,ش,عَشِیًّا,«عَشِی» کا وقت غروب آفتاب سے پہلے شروع ہو جاتا ہے اور اس کی ضد «اِشْرَاق» ہے  اور اسکی ضد «غُدُوّ» بھی آتی ہے اور «بُکْرَۃ» بھی ۔\n اب ان کی مثالیں دیکھیے :\nمثال 1 - ارشاد باری تعالیٰ ہے :\n«اَلنَّارُ یُعۡرَضُوۡنَ عَلَیۡہَا غُدُوًّا وَّ عَشِیًّا» ( 40/46 )\nترجمه : عذاب آنها آتش است که هر صبح و شام بر آن عرضه می‌شوند؛ و روزی که قیامت برپا شود (می‌فرماید:) «آل فرعون را در سخت‌ترین عذابها وارد کنید!»\nمثال 2 - ارشاد باری تعالیٰ ہے :\n«وَ لَا تَطۡرُدِ الَّذِیۡنَ یَدۡعُوۡنَ رَبَّہُمۡ بِالۡغَدٰوۃِ  وَ الۡعَشِیِّ  یُرِیۡدُوۡنَ وَجۡہَہٗ» ( 6/52 )\nترجمه : و کسانی را که صبح و شام خدا را می‌خوانند، و جز ذات پاک او نظری ندارند، از خود دور مکن! نه چیزی از حساب آنها بر توست، و نه چیزی از حساب تو بر آنها! اگر آنها را طرد کنی، از ستمگران خواهی بود\nمثال 3 - ارشاد باری تعالیٰ ہے :\n«وَ اذۡکُرۡ رَّبَّکَ کَثِیۡرًا وَّ سَبِّحۡ بِالۡعَشِیِّ وَ الۡاِبۡکَارِ » ( 3/41 )\nترجمه : کتابی که آیاتش هر مطلبی را در جای خود بازگو کرده، در حالی که فصیح و گویاست برای جمعیّتی که آگاهند\nاور عشاء کی نماز کا وقت جو متعین و مقرر ہے وہ رات کا اندھیرا چھا جانے سے لے کر آدھی رات تک ہے ۔\nمثلاً در قرآن کریم آمده است :\n«مِنۡ قَبۡلِ صَلٰوۃِ  الۡفَجۡرِ وَ حِیۡنَ تَضَعُوۡنَ ثِیَابَکُمۡ مِّنَ الظَّہِیۡرَۃِ وَ مِنۡۢ بَعۡدِ صَلٰوۃِ الۡعِشَآءِ   ۟ ؕ ثَلٰثُ عَوۡرٰتٍ لَّکُمۡ» ( 24/58 )\nترجمه : نماز فجر سے پہلے اور دوپہر کو جب تم کپڑے اتارتے ہو اور عشا کی نماز کے بعد یہ تین وقت تمہارے پردے ( کے ) ہیں ۔\nشام  کے لیے «اَمْسَا ( مسو )» کا لفظ آیا ہے ۔,«عَشِیًّا» [و شام] «عَشِیًّا» نماز مغرب کے بعد سے پوری تاریکی تک کا وقت ، وقت عشاء ۔ ,و شام / و پایان روز / شامگاهان / صبح / شام / تسبیح / تسبيح,عشیًا,3:41-6:52-12:16-18:28-19:11-19:62-24:58-30:18-38:18-38:31-40:46-40:55-43:36-79:46,14
1928,412,ش,اَمْسَاَ,«مَسَا» بمعنی شام کا وقت ۔ اور «اَمْسَاَ» بمعنی شام کرنا ، شام میں داخل ہونا یا شام کے وقت کوئی کام کرنا اور اس کی ضد «اَصْبَحَ» ہے ۔ یعنی صبح ، صبح کرنا ، صبح میں داخل ہونا یا صبح کے وقت کوئی کام کرنا ۔\nمثلاً در قرآن کریم آمده است :\n«فَسُبۡحٰنَ اللّٰہِ  حِیۡنَ تُمۡسُوۡنَ وَ حِیۡنَ تُصۡبِحُوۡنَ» ( 30/17 )\nترجمه : به یقین، پروردگارت روزی را برای هر کس بخواهد، گشاده یا تنگ می‌دارد؛ او نسبت به بندگانش، آگاه و بیناست,«اَمْسَاَ» بمعنی شام کرنا ۔,صبح / آييد / آیید / بامداد / تسبیح / تسبيح,امسا,30:17,1
1929,413,ش,عَسٰی,«عَسٰی» افعال مقاربہ میں سے ہے اور جامد  ہے (یعنی وہ کلمہ جو کسی دوسرے کلمے سے  نہ نکلا ہو) اور صرف ماضی کے لیے استعمال ہوتا ہے مضارع (مستقبل) کے لیے نہیں آتا ۔ پسندیدہ چیز میں امید غالب کے لیے اور ناپسندیدہ چیز میں خوف کے لیے آتا ہے (منجد)\nمحبوب چیز میں امید غالب کے لیے :\nمثلاً در قرآن کریم آمده است :\n«عَسٰی رَبِّیۡۤ   اَنۡ  یَّہۡدِیَنِیۡ  سَوَآءَ  السَّبِیۡلِ» ( 28/22 )\nترجمه : و هنگامی که متوجّه جانب مدین شد گفت: «امیدوارم پروردگارم مرا به راه راست هدایت کند!»\nاور مکروہ چیز میں خوف کے لیے :\nمثلاً : ارشاد باری تعالیٰ ہے :\n«فَہَلۡ  عَسَیۡتُمۡ  اِنۡ تَوَلَّیۡتُمۡ  اَنۡ تُفۡسِدُوۡا فِی  الۡاَرۡضِ وَ تُقَطِّعُوۡۤا  اَرۡحَامَکُمۡ» ( 47/22 )\nترجمه : اگر (از این دستورها) روی گردان شوید، جز این انتظار می‌رود که در زمین فساد و قطع پیوند خویشاوندی کنید؟\nنوٹ : افعال مقاربہ  وہ افعال جو خبر کو اسم کے قریب کردیتے ہیں ۔,«عَسٰی» [وچہ بسا] «عَسٰی» امیدِ غالب کے لیے آتا ہے ۔,وچہ بسا / و چہ بسا / ممکن است کہ شما / بدانید بسا / باشد کہ / کہ امید است / امید,عسی,2:216-2:246-4:19-4:84-4:99-5:52-7:129-7:185-9:18-9:102-12:21-12:83-17:8-17:51-17:79-18:24-18:40-19:48-27:72-28:9-28:22-28:67-47:22-49:11-60:7-66:5-66:8-68:32,28
1930,413,ش,لَعَلَّ,«لَعَلَّ» یہ حرف مشبہ بہ فعل ہے ۔ صرف غالب امکان کے لیے آتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ مَا یُدۡرِیۡکَ لَعَلَّ  السَّاعَۃَ   تَکُوۡنُ  قَرِیۡبًا» ( 33/63 )\nترجمه : مردم از تو درباره (زمان قیام) قیامت سؤال می‌کنند، بگو: «علم آن تنها نزد خداست!» و چه می‌دانی شاید قیامت نزدیک باشد\nاور جب اس کی نسبت اللہ تعالیٰ کی طرف ہو تو اس کے معنی واجب کے ہوتے ہیں ۔\nمثلاً : ارشاد باری تعالیٰ ہے :\n«لَا تَدۡرِیۡ  لَعَلَّ اللّٰہَ  یُحۡدِثُ بَعۡدَ ذٰلِکَ  اَمۡرًا» ( 65/1 )\nترجمه : ای پیامبر! هر زمان خواستید زنان را طلاق دهید، در زمان عدّه، آنها را طلاق گویید [= زمانی که از عادت ماهانه پاک شده و با همسرشان نزدیکی نکرده باشند]، و حساب عدّه را نگه دارید؛ و از خدایی که پروردگار شماست بپرهیزید؛ نه شما آنها را از خانه‌هایشان بیرون کنید و نه آنها (در دوران عدّه) بیرون روند، مگر آنکه کار زشت آشکاری انجام دهند؛ این حدود خداست، و هر کس از حدود الهی تجاوز کند به خویشتن ستم کرده؛ تو نمی‌دانی شاید خداوند بعد از این، وضع تازه (و وسیله اصلاحی) فراهم کند\nنوٹ : (حروف مشبه به فعل : وہ حروف ہیں جو فعل سے مشابہت رکھتے ہیں اور جملہ اسمیہ پر داخل ہو کر مبتدا کو نصب اور خبر کو رفع دیتے ہیں ۔ یہ چھ حروف ہیں) «إن . أن. كان . لكن ، ليت . لعل» ۔,«لَعَلَّ» [باشد کہ شما] «لَعَلَّ» امکانِ غالب کے لیے آتا ہے ۔,باشد کہ شما / و باشد کہ شما / و باشد کہ / باشد کہ آنان / با شد کہ آنان / و باشد کہ آنان / شاید,لعل,2:21-2:52-2:53-2:56-2:63-2:73-2:150-2:179-2:183-2:185-2:186-2:187-2:189-2:219-2:221-2:242-2:266-3:72-3:103-3:123-3:130-3:132-3:200-5:6-5:35-5:89-5:90-5:100-6:42-6:51-6:65-6:69-6:151-6:152-6:153-6:154-6:155-7:26-7:57-7:63-7:69-7:94-7:130-7:158-7:164-7:168-7:171-7:174-7:176-7:204-8:26-8:45-8:57-9:12-9:122-11:12-12:2-12:46-12:62-13:2-14:25-14:37-16:14-16:15-16:44-16:78-16:81-16:90-18:6-20:44-20:113-20:130-21:13-21:31-21:58-21:61-21:111-22:36-22:77-23:49-23:100-24:1-24:27-24:31-24:56-24:61-26:3-26:40-26:129-27:7-27:46-28:29-28:38-28:43-28:46-28:51-28:73-30:41-30:46-32:3-32:21-33:63-35:12-36:45-36:74-39:27-39:28-40:36-40:67-41:26-42:17-43:3-43:10-43:28-43:48-44:58-45:12-46:27-49:10-51:49-57:17-59:21-62:10-65:1-80:3,125
1931,414,ش,خَمْر,«خَمْر» یہ لفظ شراب کے لیے بولا جاتا ہے «خَمَرَ» بمعنی ڈھانپنا ۔ اور «خِمَار» کی جمع  «خُمُر» ہے ۔ بمعنی اوڑھنی دوپٹہ جس سے چہرہ وغیرہ ڈھانپا جا سکے ۔ اور شراب کو بھی «خَمْر» اس لیے کہتے ہیں کہ وہ عقل و حواس پر پردہ ڈال کر اسے زائل کر دیتی ہے ۔\nمثلاً در قرآن کریم آمده است :\n«اِنَّمَا الۡخَمۡرُ وَ الۡمَیۡسِرُ وَ الۡاَنۡصَابُ وَ الۡاَزۡلَامُ رِجۡسٌ مِّنۡ  عَمَلِ الشَّیۡطٰنِ» ( 5/90 )\nترجمه : آیا او گمان می‌کند که هیچ کس نمی‌تواند بر او دست یابد؟,«خَمْر» [شراب] «خَمْر» ہر قسم کی شراب جو عقل و حواس کھو دیتی ہے کے لیے عام لفظ ہے ۔,شراب / انگور را / شرابی کہ / قمار / پرندگان / یکی / يكى,خمر,2:219-5:90-5:91-12:36-12:41-47:15,6
1932,414,ش,مَعِیْن,«مَعَنَ الْمَاءَ» بمعنی پانی کا آہستہ آہستہ سطح زمین پر بہنا اور «مَعَنَ النَّظْر فِی الْاَمْر» کسی معاملہ میں گہرائی تک سوچنا (منجد) اور «مَعِیْن» ایسے پانی کو کہتے ہیں جو خوش ذائقہ ، میٹھا اور صاف شفاف ہو ۔\nمثلاً در قرآن کریم آمده است :\n«اَرَءَیۡتُمۡ  اِنۡ  اَصۡبَحَ مَآؤُکُمۡ غَوۡرًا فَمَنۡ یَّاۡتِیۡکُمۡ بِمَآءٍ مَّعِیۡنٍ» ( 67/30 )\nترجمه : بگو: «به من خبر دهید اگر آبهای (سرزمین) شما در زمین فرو رود، چه کسی می‌تواند آب جاری و گوارا در دسترس شما قرار دهد؟!»\nمگر درج ذیل آیت میں «کَاْس» ( بھرا ہوا جام ) کا لفظ «مَعِیْن» کے معنیٰ کو خوشگوار شراب کے معنی میں بدل دیتا ہے ۔ ایسی شراب جو «خَمْر» کے نقصان سے پاک ہو ۔ کیونکہ «کاس» کا لفظ عمومًا شراب کے بھرے ہوئے جام کے لیے آتا ہے اور شراب کے لیے بھی ۔\nمثلاً در قرآن کریم آمده است :\n«یَطُوۡفُ عَلَیۡہِمۡ وِلۡدَانٌ مُّخَلَّدُوۡنَ - بِاَکۡوَابٍ وَّ اَبَارِیۡقَ  ۬ ۙ وَ کَاۡسٍ مِّنۡ مَّعِیۡنٍ» (18-17 /56)\nترجمه : با قدحها و کوزه‌ها و جامهایی از نهرهای جاری بهشتی (و شراب طهور) نوجوانانی جاودان (در شکوه و طراوت) پیوسته گرداگرد آنان می‌گردند،,«مَعِیْن» [و آبی روان] «مَعِیْن» خوش ذائقہ اور خوشگوار شراب جو نقصان سے پاک ہو اوروہ جنت در ملے گی ۔,و آبی روان / شرابی روان / شرابی صاف / روان / مادرش / جامی / جامى,معین,23:50-37:45-56:18-67:30,4
1933,414,ش,رَحِیْقٍ,«رَحِیْق» بمعنی خالص ، شفاف اور خوشبودار شراب ( فل 56 ) اور جس میں کسی قسم کا میل کچیل یا ذرات نہ ہوں ۔\nمثلاً در قرآن کریم آمده است :\n«یُسۡقَوۡنَ مِنۡ  رَّحِیۡقٍ مَّخۡتُوۡمٍ خِتٰمُہٗ  مِسۡکٌ» ( 83/25،26 )\nترجمه : انھیں خالص اور شفاف سر بمہر شراب پینے کو دی جائے گی جس کی مہر کستوری کی ہو گی ۔,«رَحِیْقٍ» [شرابِ خالصِ] «رَحِیْق» اعلٰی ، تر قسم کی خوشبودار شراب جو نقصان سے پاک ہو اوروہ جنت در ملے گی ۔,شراب ناب ممهور / شرابِ خالصِ / سيراب / سیراب / مُهر / مهر / ناب,رحیقٍ,83:25,1
1934,415,ش,اِسْتِحْیَاءَ,«حَیِیَ یَحْیٰی حَیٰوۃً» بمعنی زندہ ہونا ۔ اور «حَیَّ یَحَیُّ حَیًّاء» بمعنی شرمندہ ہونا اور شرمانا ۔ ان دونوں سے باب استفعال سے «اِسْتِحْیَاء» آتا ہے ۔ ’’ کسی کو زندہ چھوڑنے اور کسی سے شرم محسوس کرنے ‘‘ دونوں معنوں میں قرآن میں استعمال ہوتا ہے ۔ مادی اور معنوی دونوں معنوں میں استعمال ہوتا ہے ۔\nمادی استعمال کی مثال : ارشاد باری تعالیٰ ہے :\n«فَجَآءَتۡہُ  اِحۡدٰىہُمَا تَمۡشِیۡ عَلَی اسۡتِحۡیَآءٍ» ( 28/25 )\nترجمه : ناگهان یکی از آن دو (زن) به سراغ او آمد در حالی که با نهایت حیا گام برمی‌داشت، گفت: «پدرم از تو دعوت می‌کند تا مزد آب دادن (به گوسفندان) را که برای ما انجام دادی به تو بپردازد.» هنگامی که موسی نزد او [= شعیب‌] آمد و سرگذشت خود را شرح داد، گفت: «نترس، از قوم ظالم نجات یافتی!»\nاور معنوی استعمال کی مثال : ارشاد باری تعالیٰ ہے :\n«اِنَّ اللّٰہَ لَا یَسۡتَحۡیٖۤ اَنۡ یَّضۡرِبَ مَثَلًا مَّا بَعُوۡضَۃً فَمَا فَوۡقَہَا» ( 2/26 )\nترجمه : خداوند از این که (به موجودات ظاهرا کوچکی مانند) پشه، و حتی کمتر از آن، مثال بزند شرم نمی‌کند. (در این میان) آنان که ایمان آورده‌اند، می‌دانند که آن، حقیقتی است از طرف پروردگارشان؛ و اما آنها که راه کفر را پیموده‌اند، (این موضوع را بهانه کرده) می‌گویند: «منظور خداوند از این مثل چه بوده است؟!» (آری،) خدا جمع زیادی را با آن گمراه، و گروه بسیاری را هدایت می‌کند؛ ولی تنها فاسقان را با آن گمراه می‌سازد,«اِسْتِحْیَاءَ» [شرم و حیا] «اِسْتِحْیَاءَ» بمعنی حیا کی وجہ سے کسی کا شرمانا ۔,شرم و حیا / شرم / پدرم / پشه / پشّه / خوردید / خورديد,استحیاء,2:26-28:25-33:53,3
1935,415,ش,اِسْتِنْکَفَ,«نَکِفَ» بمعنی ناک بھوؤں چڑھانا ۔ اور «اِسْتَنْکَفَ» بمعنی ازراہ تکبر کسی چیز کو باعث شرم و عار سمجھنا (منجد)\nمثلاً در قرآن کریم آمده است :\n«لَنۡ یَّسۡتَنۡکِفَ الۡمَسِیۡحُ اَنۡ یَّکُوۡنَ عَبۡدًا لِّلّٰہِ» ( 4/172 )\nترجمه : هرگز مسیح از این ابا نداشت که بنده خدا باشد؛ و نه فرشتگان مقرّب او (از این ابا دارند). و آنها که از عبودیّت و بندگی او، روی برتابند و تکبّر کنند، بزودی همه آنها را (در قیامت) نزد خود جمع خواهد کرد,«اِسْتِنْکَفَ» [ابا ورزیدند] «اِسْتِنْکَفَ» مذموم صفت ہے یعنی ازراہ تکبر جھجک محسوس کرنا اور شرمانا ۔ عار سمجھنا ۔,اوج درجه در تعظیم در برابر خداوند است / ابا ورزیدند / مقرّب / مقرب / مسیح / مسيح / ابا,استنکف,4:172-4:173,2
1936,416,ش,بَدَاَ,«بَدَاَ» دو معنوں میں آتا ہے (1) کسی کام کا آغاز کرنا ، افتتاح کرنا ، ابتداء کرنا  (2)  کوئی کام پہلے کرنا ۔ اور اگر اس کی نسبت اللہ تعالیٰ کی طرف ہو تو اس کے معنی پہلی بار پیدا کرنا ہوتے ہیں ( اسکی ضد عود ہے بمعنی پھر وہی کام کرنا )\nمثلاً در قرآن کریم آمده است :\n«فَبَدَاَ بِاَوۡعِیَتِہِمۡ قَبۡلَ وِعَآءِ اَخِیۡہِ» ( 12/76 )\nترجمه : در این هنگام، (یوسف) قبل از بار برادرش، به کاوش بارهای آنها پرداخت؛ سپس آن را از بارِ برادرش بیرون آورد؛ این گونه راه چاره را به یوسف یاد دادیم! او هرگز نمی‌توانست برادرش را مطابق آیین پادشاه (مصر) بگیرد، مگر آنکه خدا بخواهد! درجات هر کس را بخواهیم بالا می‌بریم؛ و برتر از هر صاحب علمی، عالمی است\nاس آیت میں «بَدَاَ» کے دونوں معنی پائے جاتے ہیں ۔ ایک مفہوم تو یہ ہے کہ تلاشی کا کام دوسرے بھائیوں کے سامان سے شروع کیا ۔ اور دوسرے یہ کہ اپنے بھائی کے سامان کی تلاشی سے پہلے دوسرے بھائیوں کے سامان کی تلاشی لے لی ۔\nنیز ارشاد باری تعالیٰ ہے :\n«اِنَّہٗ  ہُوَ  یُبۡدِئُ وَ یُعِیۡدُ» ( 85/13 )\nترجمه : اوست که آفرینش را آغاز می‌کند و بازمی‌گرداند،,«بَدَاَ» [آفریدتان] «بَدَاَ» کسی کام کا آغاز کرنا ۔,آفریدتان / آغاز کردند کارزار با شما را / آغاز می کند / آغاز کند / پس جستجو آغاز کرد / آغاز کردیم ما / آغاز,بدا,2:117-6:101-7:29-9:13-10:4-10:34-12:76-21:104-27:64-29:19-29:20-30:11-30:27-32:7-34:49-85:13,16
1937,416,ش,طَفِقَ,«طَفِقَ» فعل ناقص ہے جو اپنے ساتھ دوسرا فعل چاہتا ہے (منجد ) کلام مثبت (Positive) میں استعمال ہوتا ہے ۔ بمعنی  شروع کرنا ۔\nمثلاً در قرآن کریم آمده است :\n«وَ طَفِقَا یَخۡصِفٰنِ عَلَیۡہِمَا مِنۡ وَّرَقِ الۡجَنَّۃِ» ( 7/22 )\nترجمه : و اینکه رستاخیز آمدنی است، و شکّی در آن نیست؛ و خداوند تمام کسانی را که در قبرها هستند زنده می‌کند\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«فَطَفِقَ مَسۡحًۢا بِالسُّوۡقِ وَ الۡاَعۡنَاقِ» ( 38/33 )\nترجمه : (آنها به قدری جالب بودند که گفت:) بار دیگر آنها را نزد من بازگردانید! و دست به ساقها و گردنهای آنها کشید (و آنها را نوازش داد)\nنوٹ : فعل ناقص: وہ فعل ہوتا ہے جو کسی کام کے پورا ہونے کو ظاہر نہیں کرتا یا کسی بات کو مکمل نہیں کرتا۔  جب تک فاعل کے علاوہ کوئی اور اسم یا صفت اس کے ساتھ نہ ملایاجائے ۔,«طَفِقَ» [وشروع کردند بہ آنکہ] «طَفِقَ» فعل ناقص ہے یعنی اصل کام تو کوئی اور ہوتا ہے ۔ یہ اس کے ساتھ مل کر اس فعل کے آغاز کا معنی دیتا ہے ۔,وشروع کردند بہ آنکہ / و آغاز کردند / پس شروع کرد / درخت / درختِ / شروع / برگ,طفق,7:22-20:121-38:33,3
1938,417,ش,فَرْج,«فَرْج» کی جمع «فُرُوْج» ہے اور «فَرْج» میں کشادگی کا تصور پایا جاتا ہے ۔ «فَرَجَ» بمعنی کھولنا ، کشادہ کرنا کھلا کرنا (منجد) اور «فَرْج» بمعنی دو چیزوں یا ایک چیز کے دو حصوں کے درمیان وسعت ۔ اور «فَرْجُ الطَّرِیْق» بمعنی راستہ کا درمیانی حصہ ۔ دیوار میں شگاف کو بھی «فَرْج» کہتے ہیں ۔ اور دو ٹانگوں کے درمیان کشادگی کو بھی ۔ پھر کنایہ کے طور پر «فَرْج» کا لفظ شرم گاہ پر بھی بولا جاتا ہے ۔ اور کثرت استعمال کی وجہ سے اسے حقیقی معنی سمجھا جانے لگا (مف)\nمثلاً در قرآن کریم آمده است :\n«وَ الَّذِیۡنَ ہُمۡ  لِفُرُوۡجِہِمۡ حٰفِظُوۡنَ» ( 23/5 )\nترجمه : (ولی) دو نفر از مردانی که از خدا می‌ترسیدند، و خداوند به آنها، نعمت (عقل و ایمان و شهامت) داده بود، گفتند: «شما وارد دروازه شهر آنان شوید! هنگامی که وارد شدید، پیروز خواهید شد. و بر خدا توکل کنید اگر ایمان دارید!»,«فَرْج» [شرمگاہ خود را] «فَرْج» دو چیزوں کے درمیان کھلی جگہ (شرم گاہ) ۔,شرمگاہ خود را / شرمگاہ ھایش را / شرمگاہ ھای خود را / شرمگاہ ھای خویش / دامن خود را / دامن ھایشان را / نگاه,فرج,21:91-23:5-24:30-24:31-33:35-66:12-70:29,7
1939,417,ش,سَوْءَۃَ,«سَوْء ، سُوْء» بمعنی ہر وہ چیز جو عقلی یا شرعی لحاظ سے بری ہو یا دیکھنے میں بری معلوم ہو ، اسی لحاظ سے انسان کے ستر کی چیزیں اگر ننگی ہوں تو اسے «سَوْءَۃَ» کہا جاتا ہے ۔ اور «سَوْءَۃَ» کا اطلاق صرف شرم گاہ پر ہی نہیں ہوتا بلکہ تمام ستر کی چیزوں مثلاً عورت کے بدن اور پستانوں وغیرہ پر بھی اگر وہ ننگے ہوں تو ہوتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«یٰبَنِیۡۤ  اٰدَمَ  قَدۡ  اَنۡزَلۡنَا عَلَیۡکُمۡ  لِبَاسًا یُّوَارِیۡ سَوۡاٰتِکُمۡ وَ رِیۡشًا» ( 7/26 )\nترجمه : آیا آنان به زمین نگاه نکردند که چقدر از انواع گیاهان پرارزش در آن رویاندیم؟\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«فَلَمَّا ذَاقَا الشَّجَرَۃَ بَدَتۡ لَہُمَا سَوۡاٰتُہُمَا» ( 7/22 )\nترجمه : و اینکه رستاخیز آمدنی است، و شکّی در آن نیست؛ و خداوند تمام کسانی را که در قبرها هستند زنده می‌کند\nپھر اسی لحاظ سے «سَوْءَۃَ» کا لفظ انسان کی لاش کے لیے بھی استعمال ہوا ہے کہ وہ بھی کچھ عرصہ گزرنے پر اگر دفن نہ کی جائے تو کریہہ المنظر بن جاتی ہے ۔\nمثلاً در قرآن کریم آمده است :\n«فَبَعَثَ اللّٰہُ غُرَابًا یَّبۡحَثُ فِی الۡاَرۡضِ لِیُرِیَہٗ کَیۡفَ یُوَارِیۡ سَوۡءَۃَ اَخِیۡہِ» ( 5/31 )\nترجمه : آنان بر طریق هدایت از پروردگارشانند، و آنانند رستگاران,«سَوْءَۃَ» [جسد] «سَوْءَۃَ» ستر کی چیزیں اگر کھلی ہوں اور ہر وہ چیز جس کا ظاہر ہونا برا ہو ۔,جسد / درخت / درختِ / آدم / شیطان / شيطان / برگ,سوءۃ,5:31-7:20-7:22-7:26-7:27-20:121,6
1940,418,ش,خَلِیْط,«خَلَطَ» بمعنی ایک چیز کو دوسری میں ملانا اسکی ضد «خَلَصَ» بمعنی خالص کھرا اور صاف ہونا ہے ۔ «اَلْخَلْط» بمعنی لوگوں سے میل جول رکھنے والا ۔ «خَلِیْط» وہ لوگ جن کا معاملہ ایک ہو ۔ اور «اَلْخُلْطَۃ» شرکت کو کہتے ہیں (منجد) اور اصطلاحی معنوں میں «خَلِیْط» بمعنی ’’ جزوی شرک کار ‘‘  یعنی ایسے شریک جن کے کچھ انتظامات تو اجتماعی ہوں اور کچھ الگ الگ ہوں ۔ مثلاً زید اور بکر دونوں کے پاس الگ الگ ریوڑ ہیں جو ان کی اپنی ملکیت ہیں لیکن ان کی حفاظت کے لیے انہوں نے جگہ مشترکہ طور پر کرایہ پر لے رکھی ہے یا چرواہے کو مشترکہ معاوضہ ادا کرتے ہیں تو ایسے شریک کار «خَلَیْط» کہلاتے ہیں ( احادیث صحیحہ کی رو سے ایسے «خُلَطَاء» کے مشترکہ مال پر زکوۃ عائد ہوتی ہے )\nمثلاً در قرآن کریم آمده است :\n«اِنَّ کَثِیۡرًا مِّنَ الۡخُلَطَآءِ لَیَبۡغِیۡ  بَعۡضُہُمۡ عَلٰی بَعۡضٍ» ( 38/24 )\nترجمه : (داوود) گفت: «مسلّماً او با درخواست یک میش تو برای افزودن آن به میشهایش، بر تو ستم نموده؛ و بسیاری از شریکان (و دوستان) به یکدیگر ستم می‌کنند، مگر کسانی که ایمان آورده و اعمال صالح انجام داده‌اند؛ امّا عدّه آنان کم است!» داوود دانست که ما او را (با این ماجرا) آزموده‌ایم، از این رو از پروردگارش طلب آمرزش نمود و به سجده افتاد و توبه کرد,«خَلِیْط» جزوی شریک کار یعنی وہ لوگ جن کا معاملہ ایک ہو ۔,میش / ميش / اعتراف / شریکان / شريكان / افتاد,خلیط,9:102-38:24,2
1941,418,ش,شَرِیْک,«شَرِیْک» بمعنی ساجھی جو ایک دوسرے سے الگ نہ ہو سکیں ۔ شراکت مادی بھی ہوتی ہے اور معنوی بھی ۔ مادی یہ ہے کہ مثلاً دو آدمی ایک کاروبار میں شریک ہیں اور ان کی ذمہ داریاں اس طرح کی ہیں کہ کسی ایک کے نکل جانے سے نہ کاروبار کا آغاز ہو سکتا ہے اور نہ چل سکتا ہے ۔\nاسی مفہوم میں ارشاد باری تعالیٰ ہے :\n«وَّ لَمۡ  یَکُنۡ لَّہٗ  شَرِیۡکٌ فِی الۡمُلۡکِ  وَ لَمۡ یَکُنۡ لَّہٗ  وَلِیٌّ  مِّنَ الذُّلِّ» ( 17/111 )\nترجمه : و بگو: «ستایش برای خداوندی است که نه فرزندی برای خود انتخاب کرده، و نه شریکی در حکومت دارد، و نه بخاطر ضعف و ذلّت، (حامی و) سرپرستی برای اوست!» و او را بسیار بزرگ بشمار\nاور معنوی شراکت یہ ہے جیسے انسان اور گھوڑا حیوانیت میں شریک ہیں ۔ یہ شراکت صفاتی ہوئی ۔ اللہ تعالیٰ اس سے بھی پاک ہے جیسا کہ بہت سی آیتوں سے واضح ہے۔,«شَرِیْک» [شریکی] «شَرِیْک» کسی ایک کام در مکمل اشتراک رکھنے والا ۔,شریکی / ھیچ شریکی / شريكى / فرزندی / فرزندى / فرمانروايى / فرمانروایی,شریک,6:163-17:111-25:2,3
1942,418,ش,اَنْدَادًا,«نِدّ» بمعنی سخت نفرت کرنا اور بھاگنا ۔ اور «نَادَّہٗ» بمعنی اس نے مخالفت کی (م ۔ ق) اور بمعنی کسی ذات یا جوہر میں شریک ہونا (مف) گویا «نِدّ» ساجھی نہیں بلکہ مد مقابل یا رقیب کی حیثیت رکھتا ہے ۔ یعنی ایک کی تمام تر صفات یا تھوڑی بہت دوسروں میں بھی پائی جاتی ہیں ۔ نظیر ۔ ( لغت اضداد ) بمعنی مخالف اور حریف بھی اور نظیر اور مثل بھی (ک ض) ۔\nمثلاً در قرآن کریم آمده است :\n«فَلَا تَجۡعَلُوۡا لِلّٰہِ اَنۡدَادًا وَّ اَنۡتُمۡ تَعۡلَمُوۡنَ» ( 2/22 )\nترجمه : آن کس که زمین را بستر شما، و آسمان [= جو زمین‌] را همچون سقفی بالای سر شما قرار داد؛ و از آسمان آبی فرو فرستاد؛ و به وسیله آن، میوه‌ها را پرورش داد؛ تا روزی شما باشد. بنابر این، برای خدا همتایانی قرار ندهید، در حالی که می‌دانید (هیچ یک از آنها، نه شما را آفریده‌اند، و نه شما را روزی می‌دهند),«اَنْدَادًا» [ھمتایانی را] «نَدّ» ذات اور جوہر در شریک ، مد مقابل ، نظیر کو کہتے ہیں ۔,ھمتایانی را / ھمتا یانی را / ھمتا یانی / همتایانی / همتايانى / پشیمانی / پشيمانى,اندادًا,2:22-2:165-14:30-34:33-39:8-41:9,6
1943,419,ش,لَھَب,«لَھَب» بمعنی آگ کا حرکت کرنا اور بلند ہونا ، اور بمعنی آگ کی زبان بلند ہونا (م ۔ ل) شعلہ معروف معنوں میں مستعمل ہے اور شعلہ کے لیے عام لفظ ہے ۔\nمثلاً در قرآن کریم آمده است :\n«سَیَصۡلٰی نَارًا ذَاتَ  لَہَبٍ» (111/3)\nترجمه : و بزودی وارد آتشی شعله‌ور و پرلهیب می‌شود؛,«لَھَب» [زبانۂ آتش را] «لَھَب» شعلہ کے لیے عام لفظ ہے ، آگ کا شعلہ ۔,زبانۂ آتش را / شعله / سایه / سايه / ور / آتشی / آتشى,لھب,77:31-111:3,2
1944,419,ش,شُوَاظ ۔ نُحَاس,«شُوَاظ» ایسے شعلہ کو کہتے ہیں جس میں دھوئیں کی آمیزش نہ ہو (مف) اور اگر دھوئیں کی آمیزش ہو تو اسے «نُحَاس» کہتے ہیں ۔ بشرطیکہ دھوئیں کی آمیزش کم اور آگ زیادہ ہو تو چونکہ اس کا رنگ تانبے جیسا ہو جاتا ہے لہذا اسے «نُحَاس» بمعنی تانبہ کہتے ہیں ۔\nمثلاً در قرآن کریم آمده است :\n«یُرۡسَلُ عَلَیۡکُمَا شُوَاظٌ مِّنۡ نَّارٍ  ۙ وَّ نُحَاسٌ فَلَا  تَنۡتَصِرٰنِ» ( 55/35 )\nترجمه : تم پر آگ کا شعلہ اور تانبے کے رنگ کا دھواں چھوڑا جائے گا ، پھر تم اپنا بچاؤ نہیں کرسکو گے ۔,«شُوَاظ» ایسا شعلہ جس در دھواں نہ ہو ۔\n«نُحَاس» ایسا شعلہ جس در دھوئیں کی آمیزش ہو مگر آگ زیادہ ہو ۔,جرقه آتش و به دنبال آن دود / مس / مِس / گداخته / شراره / دود,شواظ ۔ نحاس,55:35,1
1945,419,ش,مَارِج,«مَارِج» شعلہ کا اوپر کا گرم ترین حصہ جو دھوئیں سے پاک ہوتا ہے ، آگ کی لپٹ ( فل 58 ) ۔\nمثلاً در قرآن کریم آمده است :\n«وَ  خَلَقَ  الۡجَآنَّ مِنۡ مَّارِجٍ  مِّنۡ نَّارٍ» ( 55/15 )\nترجمه : و جنّ را از شعله‌های مختلط و متحرّک آتش خلق کرد,«مَارِج» [شعلۂ بی دود] «مَارِج» شعلہ کے اوپر کا گرم ترین حصہ ۔,شعلۂ بی دود / جن / جنّ / شعله / خلق / آتش,مارج,55:15,1
1946,419,ش,شَرَر,«شَرَر» آگ کے بڑے شعلے سے کٹ کر اڑنے والے چھوٹے چھوٹے حصے ۔ چنگارے ، چنگاریاں ، شرارے (مف)\nمثلاً در قرآن کریم آمده است :\n«اِنَّہَا  تَرۡمِیۡ  بِشَرَرٍ  کَالۡقَصۡرِ» ( 77/32 )\nترجمه : شراره‌هایی از خود پرتاب می‌کند مانند یک کاخ,«شَرَر» [شرارہ ھایی را] «شَرَر» کسی شعلہ سے کٹ کر اڑنے والی چھوٹی چھوٹی چنگاریاں ۔,شرارہ ھایی را / شراره / پرتاب / كاخى / کاخی / کاخ / كاخ,شرر,77:32,1
1947,420,ش,شَکّ,«شَکّ» دو نظریات کا ذہن میں مساوی اور برابر ہونا جبکہ کسی ایک کو ترجیح دینے کے لیے کوئی دلیل نہ ہو ۔ گویا شک کی بنیاد جہالت یا کم علمی ہوتی ہے (مف)\nمثلاً در قرآن کریم آمده است :\n«اَفِی اللّٰہِ شَکٌّ فَاطِرِ السَّمٰوٰتِ وَ الۡاَرۡضِ» ( 14/10 )\nترجمه : سپس شما را جانشینان آنها در روی زمین -پس از ایشان- قرار دادیم؛ تا ببینیم شما چگونه عمل می‌کنید,«شَکّ» دو نظریات در سے کسی ایک کو کم علمی کی بناء پر ترجیح نہ دے سکنا ۔,شک / شك / شکی / شکّی / تردید / ترديد / اختلاف,شک,4:157-10:94-10:104-11:62-11:110-14:9-14:10-27:66-34:21-34:54-38:8-40:34-41:45-42:14-44:9,15
1948,420,ش,شَبَّہَ,«شَبَّہَ» بمعنی دو یا زیادہ چیزوں کی آپس میں اس قدر مماثلت ہوں کہ ان میں صحیح طرح سے تمیز نہ ہو سکے اور یہ شبہ رنگ یا اوصاف میں ہوتا ہے ( م ۔ ل )\nمثلاً در قرآن کریم آمده است :\n«وَ مَا قَتَلُوۡہُ وَ مَا صَلَبُوۡہُ وَ لٰکِنۡ شُبِّہَ لَہُمۡ» ( 4/157 )\nترجمه : و گفتارشان که: «ما، مسیح عیسی بن مریم، پیامبر خدا را کشتیم!» در حالی که نه او را کشتند، و نه بر دار آویختند؛ لکن امر بر آنها مشتبه شد. و کسانی که در مورد (قتل) او اختلاف کردند، از آن در شک هستند و علم به آن ندارند و تنها از گمان پیروی می‌کنند؛ و قطعاً او را نکشتند\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«اِنَّ الۡبَقَرَ تَشٰبَہَ عَلَیۡنَا» ( 2/70 )\nترجمه : این عذاب مخصوص کافران است، و هیچ کس نمی‌تواند آن را دفع کند،,«شَبَّہَ» [درحالی کہ ھمگون است] «شَبَّہَ» بمعنی دو یا زیادہ چیزوں کی آپس در اس قدر مماثلت ہوں کہ ان در صحیح طرح سے تمیز نہ ہو سکے ۔,درحالی کہ ھمگون است / مشتبہ شدہ است / ھمسان گشت / متشابھات اند / متشابہ است / مشتبہ شد امر / مشتبه,شبہ,2:25-2:70-2:118-3:7-4:157-6:99-6:141-13:16-39:23,9
1949,420,ش,مِرْیَۃ,«مِرْیَۃ» کے معنی میں دو باتیں بنیادی ہیں (1) کسی حقیقت یا نظریہ کا مُسَلَّم ہونا (2) اس حقیقت کو مشکوک باتوں سے مشکوک کرتے رہنا ۔ (م ل) اسی لیے یہ لفظ جھگڑا کرنے کے معنوں میں بھی آیا ہے ۔ اور اس جھگڑا کی بنیاد یہی شک کی باتیں ہوتی ہیں ۔\nمثلاً در قرآن کریم آمده است :\n«فَبِاَیِّ  اٰلَآءِ  رَبِّکَ  تَتَمَارٰی» ( 53/55 )\nترجمه : پس کدامین نعمتهای پروردگارتان را انکار می‌کنید؟\nاور «مِرْیَۃ» کہتے ہیں حقیقت کے متعلق لوگوں کے پیدا کردہ شکوک ۔\nمثلاً : ارشاد باری تعالیٰ ہے :\n«فَلَا تَکُنۡ فِیۡ مِرۡیَۃٍ  مِّنۡ لِّقَآئِہٖ» ( 32/23 )\nترجمه : ما به موسی کتاب آسمانی دادیم؛ و شک نداشته باش که او آیات الهی را دریافت داشت؛ و ما آن را وسیله هدایت بنی اسرائیل قرار دادیم,«مِرْیَۃ» [تردیدی] «مِرْیَۃ» کسی مسلمہ (تسلیم شدہ) حقیقت کو ظنی (خیالی) اور مشکوک باتوں سے مشکوک کر دینا ۔,تردیدی / ھیچ تردیدی / تردید اند / شک / شکّ / پدرانشان / کاست,مریۃ,11:109-22:55-32:23-41:54,4
1950,420,ش,مَرِیْج,«مَرَجَ» بمعنی دو نظریات کا رل مل جانا ۔ اور «غُصْنٌ مَّرِیْجٌ» باہم گتھی ہوئی ٹہنی کو کہتے ہیں (مف) بے ترتیب ہونا (منجد) معاملہ کا گڈ مڈ اور پیچیدہ ہونا ۔ اور «مَرَجَ» بمعنی کسی خیال کا آنا اور جانا اور اضطراب (بےچین) ہونا (م ۔ ل) گویا یہ لفظ تردد اور اضطراب کا مجموعہ ہے ۔\nمثلاً در قرآن کریم آمده است :\n«بَلۡ کَذَّبُوۡا بِالۡحَقِّ لَمَّا جَآءَہُمۡ فَہُمۡ  فِیۡۤ اَمۡرٍ  مَّرِیۡجٍ» ( 50/5 )\nترجمه : آنها حقّ را هنگامی که به سراغشان آمد تکذیب کردند؛ از این رو پیوسته در کار پراکنده خود متحیّرند,«مَرِیْج» [آشفتہ اند] «مَرِیْج» کبھی ایک خیال آنا کبھی دوسرا اور پھر پہلا اوراس بناء پر شک در رہنا ۔,آشفتہ اند / کاری / كارى / آشفته / بلکه / بلكه / سردرگم,مریج,50:5,1
1951,420,ش,لَبْس,«لَبَسَ» بمعنی مخالطت اور مداخلت (یعنی ایک چیز کا دوسری کے ساتھ مل جانا اور ایک دوسرے میں شامل ہوجانا) (م ۔ ل) یعنی دو چیزوں کو آپس میں خلط ملط کر دینا اور کسی چیز میں دوسری کو داخل کرنا ۔ جیسے حق میں باطل کی آمیزش اور جھوٹ میں کچھ سچ ملا دینا اور اس طرح حقیقت کو ایسا مشکوک کر دینا کہ حق و باطل کی تمیز نہ ہو سکے ۔ اور اسی طرح کے  شک و شبہ میں پڑے ہوئے کو «لَبْس» کہتے ہیں ۔ اور اس لفظ کا استعمال اعراض میں اور کلام کی صورت میں ہوتا ہے (فق ل 249)\nمثلاً در قرآن کریم آمده است :\n«بَلۡ ہُمۡ فِیۡ لَبۡسٍ مِّنۡ خَلۡقٍ جَدِیۡدٍ» ( 50/15 )\nترجمه : آیا ما از آفرینش نخستین عاجز ماندیم (که قادر بر آفرینش رستاخیز نباشیم)؟! ولی آنها (با این همه دلایل روشن) باز در آفرینش جدید تردید دارند\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«وَ لَا تَلۡبِسُوا الۡحَقَّ بِالۡبَاطِلِ» ( 2/42 )\nترجمه : عسق,«لَبْس» [ور درنیا میزید] «لَبْس» دو نظریات کو ایسے ملا کر مشتبہ کر دینا کہ کسی ایک کی بھی تمیز نہ ہو سکے ۔,ور درنیا میزید / درمی آمیزید / و ھر آینہ مشتبہ می کردیم / خود مشتبہ می کنند / درآمیزد =درگیر کند شما را / و تا مشتبہ گردانند / مشتبه,لبس,2:42-3:71-6:9-6:65-6:82-6:137-50:15,7
1952,420,ش,رَیْب,«رَیْب» ایسا شک جس میں اضطرار (بے چینی) کا عنصر بھی شامل ہو ۔ «رَیْبُ الدَّھْر» گردش زمانہ ۔ حوادث زمانہ اور «رَیْبُ الْمَنُوْن» بمعنی زندگی کے خطرات (م ل) اور «رَیْب» ایسا شک ہے جو بے چینی، تردد اور کھٹکا پیدا کردے ۔ کہتے ہیں «دَعْ مَا یُرِیْبَکَ اِلٰی مَا لَا یُرِیْبَکَ» یعنی ایسی بات چھوڑ دے جو دل میں تردد اور اندیشہ پیدا کرے اور وہ اختیار کر جس میں کوئی تردد اور اندیشہ نہ ہو ۔ «رَیْبَۃ» بمعنی رنج و افسوس ۔ اضطراب (بےچینی) (م ۔ ق)\nمثلاً در قرآن کریم آمده است :\n«اِنَّہُمۡ لَفِیۡ شَکٍّ  مِّنۡہُ  مُرِیۡبٍ» ( 41/45 )\nترجمه : ما به موسی کتاب آسمانی دادیم؛ سپس در آن اختلاف شد؛ و اگر فرمانی از ناحیه پروردگارت در این باره صادر نشده بود (که باید به آنان مهلت داد تا اتمام حجّت شود)، در میان آنها داوری می‌شد (و به کیفر می‌رسیدند)؛ ولی آنها هنوز درباره آن شکّی تهمت‌انگیز دارند\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«ذٰلِکَ  الۡکِتٰبُ لَا رَیۡبَ فِیْہِ» ( 2-2 )\nترجمه :  یہ ایسی کتاب ہے جس میں کوئی شک ( وخطر ) نہیں ۔,«رَیْب» [ھیچ تردیدی] «رَیْب» ایسا شک جس در اضطراب بے چینی اور تردُد بھی شامل ہو ۔,ھیچ تردیدی / تردید / ھیچ شکی / و تردید نمودہ است / تردیدشان اضطر ابشان / مایہ تردید / شکی,ریب,2:2-2:23-3:9-3:25-4:87-6:12-9:45-9:110-10:37-17:99-18:21-22:5-22:7-32:2-40:59-42:7-45:26-45:32,18
1953,421,ص,ھَیْئَۃ,«ھَیْئَت» کسی چیز کی رف سی ابتدائی شکل و صورت کو کہا جاتا ہے خواہ یہ شکل محسوسہ ( جو حواس خمسہ میں سے کسی حس کے ذریعے معلوم ہو) یا معقولہ (عقل کے ذریعہ سے معلوم ہو) (مف) یعنی مادی طور پر موجود ہو یا صرف ذہن میں ہو ۔ اور «ھَیْئَۃ» اور «ھِیْئَۃ» بمعنی چیز کی حالت ۔ کیفیت ۔ شکل و صورت (منجد)\nمثلاً در قرآن کریم آمده است :\n«اَنِّیۡۤ  اَخۡلُقُ لَکُمۡ مِّنَ الطِّیۡنِ کَہَیۡئَۃِ الطَّیۡرِ» ( 3/49 )\nترجمه : آنها که صدای خود را نزد رسول خدا کوتاه می‌کنند همان کسانی هستند که خداوند دلهایشان را برای تقوا خالص نموده، و برای آنان آمرزش و پاداش عظیمی است,«ھَیْئَت» کسی چیز کی رف سی ابتدائی شکل و صورت کو کہا جاتا ہے ۔,جذام / پرنده / مادرزاد / مردگان / کور / كور,ھیئۃ,3:49-5:110,2
1954,421,ص,شَکْل,«مُشَاکِلَۃ» بمعنی شکل و صورت میں مشابہ ہونا (مف) اور اشکال بمعنی کسی معاملہ میں ایسی پیچیدگی جس میں کئی ملتی جلتی صورتیں سامنے آ جائیں ۔ اور مشکل ایسے ہی پیچیدہ امر کو کہتے ہیں ۔ اور «شَکَلَ الْاَمْر» بمعنی مشتبہ ہونا ۔ اور «شَکْل» بمعنی مشابہت ۔ مثل ۔ نظیر ۔ اور اشکال بمعنی موتی یا چاندی کے زیورات جو ایک دوسرے سے ملتے جلتے ہوں ۔ (منجد)\nمثلاً در قرآن کریم آمده است :\n«وَّ اٰخَرُ  مِنۡ شَکۡلِہٖۤ  اَزۡوَاجٌ» ( 38/58 )\nترجمه : اور اسی طرح کے اور بہت سے عذاب ہوں گے ۔,«شَکْل» [ھمانند آن] «شَکْل» شکل و صورت در مشابہت رکھنے والی چیزیں ۔,ھمانند آن / انواع / گونه، / دیگری / ديگری / گوناگون,شکل,38:58,1
1955,421,ص,صُوْرَت,«صُوْرَت» بمعنی کسی مادی چیز کے ظاہری خدوخال جس سے اسے پہچانا جا سکے ۔ اور دوسری چیزوں سے اس کا امتیاز ہو سکے (مف)\nمثلاً در قرآن کریم آمده است :\n«فِیۡۤ  اَیِّ صُوۡرَۃٍ  مَّا شَآءَ  رَکَّبَکَ» ( 82/8 )\nترجمه : و در هر صورتی که خواست تو را ترکیب نمود,«صُوْرَت» کسی مادی چیز کے ظاہری خدوخال جس سے اسے پہچانا جا سکے اور دوسری چیزوں سے اس کا امتیاز ہو سکے ۔,ترکیب / تركيب / صورتی / صورتى / خواست، / خواست,صورت,82:8,1
1956,421,ص,تَمْثَال,"«تَمْثَال» جمع «تَمَاثِیْل ، مَثُلَ» ہے بمعنی کسی دوسری چیز کی شکل و صورت اختیار کرنا اور سیدھا کھڑا ہونا اور «مُمَثَّل» وہ چیز ہے جو نمونہ (sample) کے مطابق بنائی جائے ۔ اور «تَمَثَّلَ» کسی کی شکل بن جانا , کسی کا روپ دھار لینا (مف) ۔ اور «تَمْثَال» بمعنی تصویر ، صورت یا کسی چیز کا مجسمہ (مف)\nمثلاً در قرآن کریم آمده است :\n«اِذۡ قَالَ لِاَبِیۡہِ وَ قَوۡمِہٖ مَا ہٰذِہِ التَّمَاثِیۡلُ  الَّتِیۡۤ  اَنۡتُمۡ  لَہَا  عٰکِفُوۡنَ» ( 21/52 )\nترجمه : کسانی که ایمان آوردند و فرزندانشان به پیروی از آنان ایمان اختیار کردند، فرزندانشان را (در بهشت) به آنان ملحق می‌کنیم؛ و از (پاداش) عملشان چیزی نمی‌کاهیم؛ و هر کس در گرو اعمال خویش است",«تَمْثَال» کسی اصل چیز کی نقل ، تصویر ، مورت ، مجسمہ وغیرہ ۔,مجسمه / مجسّمه / ساختند / پدرش / سپاسگزارند,تمثال,21:52-34:13,2
1957,421,ص,صَوَّرَ,«صَوَّرَ» بمعنی تصویر کھینچنا ۔ شکل بنانا (منجد) اس لفظ کا اطلاق بالعموم جاندار اشیاء پر ہوتا ہے اور جاندار اشیاء کی صورت بنانا اللہ تعالیٰ کا خاصہ ہے ۔\nمثلاً در قرآن کریم آمده است :\n«ہُوَ  الَّذِیۡ یُصَوِّرُکُمۡ  فِی الۡاَرۡحَامِ  کَیۡفَ یَشَآءُ» ( 3/6 )\nترجمه : او کسی است که شما را در رحمِ (مادران)، آنچنان که می‌خواهد تصویر می‌کند. معبودی جز خداوندِ توانا و حکیم، نیست,«صَوَّرَ» [چھرہ نگاری می کند شما را] «صَوَّرَ» بمعنی تصویر کھینچنا شکل بنانا ۔,چھرہ نگاری می کند شما را / چھرہ نگاری کردیم شما را / و صورت پردازی کرد شما را / صورت ھای شما را / و صورتگری کرد شما را / صورتگرى / صورتگری,صور,3:6-7:11-40:64-64:3,4
1958,421,ص,خَلَّقَ,«خَلَّقَ»  مادہ پر صورت کی تکمیل سے پہلے کے ابتدائی نقش و نگار بنانا ۔\nمثلاً در قرآن کریم آمده است :\n«ثُمَّ مِنۡ مُّضۡغَۃٍ مُّخَلَّقَۃٍ» ( 22/5 )\nترجمه : ای مردم! اگر در رستاخیز شک دارید، (به این نکته توجّه کنید که:) ما شما را از خاک آفریدیم، سپس از نطفه، و بعد از خون بسته شده، سپس از «مضغه» [= چیزی شبیه گوشت جویده شده‌]، که بعضی دارای شکل و خلقت است و بعضی بدون شکل؛ تا برای شما روشن سازیم (که بر هر چیز قادریم)! و جنین‌هایی را که بخواهیم تا مدّت معیّنی در رحم (مادران) قرارمی‌دهیم؛ (و آنچه را بخواهیم ساقظ می‌کنیم؛) بعد شما را بصورت طفل بیرون می‌آوریم؛ سپس هدف این است که به حدّ رشد و بلوغ خویش برسید. در این میان بعضی از شما می‌میرند؛ و بعضی آن قدر عمر می‌کنند که به بدترین مرحله زندگی (و پیری) می‌رسند؛ آنچنان که بعد از علم و آگاهی، چیزی نمی‌دانند! (از سوی دیگر،) زمین را (در فصل زمستان) خشک و مرده می‌بینی، اما هنگامی که آب باران بر آن فرو می‌فرستیم، به حرکت درمی‌آید و می‌روید؛ و از هر نوع گیاهان زیبا می‌رویاند,«خَلَّقَ» [آفرید شما را] «خَلَّقَ» ابتدائی نقش و نگار بنانا ۔,آفرید شما را / آفرید / آفرینش / آفریدہ است / می آفریند / می سازم / آفریده,خلق,2:21-2:29-2:164-2:228-3:47-3:49-3:59-3:190-3:191-4:1-4:28-4:119-5:17-5:18-5:110-6:1-6:2-6:73-6:94-6:100-6:101-6:102-7:11-7:12-7:54-7:69-7:181-7:185-7:189-7:191-9:36-10:3-10:4-10:5-10:6-10:34-11:7-11:119-13:5-13:16-14:19-14:32-15:26-15:27-15:28-15:33-15:85-16:3-16:4-16:5-16:8-16:17-16:20-16:48-16:70-16:81-17:49-17:51-17:61-17:70-17:98-17:99-18:37-18:48-18:51-19:9-19:67-20:4-20:50-20:55-21:16-21:33-21:37-21:104-22:5-22:73-23:12-23:14-23:17-23:91-23:115-24:45-25:2-25:3-25:49-25:54-25:59-26:78-26:166-26:184-27:60-27:64-28:68-29:17-29:19-29:20-29:44-29:61-30:8-30:11-30:20-30:21-30:22-30:27-30:30-30:40-30:54-31:10-31:11-31:25-31:28-32:4-32:7-32:10-34:7-35:1-35:3-35:11-35:16-35:40-36:36-36:42-36:68-36:71-36:77-36:78-36:79-36:81-37:11-37:96-37:125-37:150-38:27-38:71-38:75-38:76-39:4-39:5-39:6-39:38-39:62-40:57-40:62-40:67-41:9-41:15-41:21-41:37-42:29-42:49-43:9-43:12-43:16-43:19-43:87-44:38-44:39-45:4-45:22-46:3-46:4-46:33-49:13-50:15-50:16-50:38-51:49-51:56-52:35-52:36-53:45-54:49-55:3-55:14-55:15-56:57-56:59-57:4-59:24-64:2-64:3-65:12-67:2-67:3-67:14-70:19-70:39-71:14-71:15-74:11-75:38-76:2-76:28-77:20-78:8-79:27-80:18-80:19-82:7-86:5-86:6-87:2-88:17-89:8-90:4-92:3-95:4-96:1-96:2-113:2,210
1959,421,ص,تَمَثَّلَ,«تَمَثَّلَ» بمعنی اپنی شکل و صورت میں تبدیلی پیدا کر کے کسی دوسرے کی شکل و صورت کی طرح بن جانا ۔ روپ دھارنا ۔\nمثلاً در قرآن کریم آمده است :\n«فَاَرۡسَلۡنَاۤ  اِلَیۡہَا رُوۡحَنَا فَتَمَثَّلَ لَہَا بَشَرًا سَوِیًّا» ( 19/17 )\nترجمه : و میان خود و آنان حجابی افکند (تا خلوتگاهش از هر نظر برای عبادت آماده باشد). در این هنگام، ما روح خود را بسوی او فرستادیم؛ و او در شکل انسانی بی‌عیب و نقص، بر مریم ظاهر شد,«تَمَثَّلَ» [پس جلوہ گرشد] «تَمَثَّلَ» بمعنی  روپ دھارنا ۔,پس جلوہ گرشد / روح / روحِ / پرده / اندام / فرستادیم / فرستاديم,تمثل,19:17,1
1960,422,ش,فُطُوْر,«فَطَرَ» بمعنی کسی چیز کو لمبائی کے رُخ پر پھاڑنا  یا چیرنا ہے ( مف ) ۔ اور «اِنْفَطَر» کے معنی چر جانا ہے ۔ (عثمانی) گویا «فُطُوْر» ایسے شگاف کو کہتے ہیں جس کی چوڑائی لمبائی کے مقابلہ میں بہت کم ہو ۔ دراڑ ، شگاف ، جِھری ۔\nمثلاً در قرآن کریم آمده است :\n«فَارۡجِعِ  الۡبَصَرَ ۙ ہَلۡ  تَرٰی مِنۡ فُطُوۡرٍ» ( 67/3 )\nترجمه : همان کسی که هفت آسمان را بر فراز یکدیگر آفرید؛ در آفرینش خداوند رحمان هیچ تضادّ و عیبی نمی‌بینی! بار دیگر نگاه کن، آیا هیچ شکاف و خللی مشاهده می‌کنی؟,«فُطُوْر» [شکاف و رخنہ ای را] «فُطُوْر» وہ لمبا شگاف ہے جو کسی چیز کے پھٹنے یا چِرنے سے پیدا ہو ۔,عیب / شکاف و رخنہ ای را / هفت / بینی؟ / بينى؟ / خلل / آفرینش,فطور,67:3,1
1961,422,ش,فُرُوْج,«فَرْج» کے معنی میں کشادگی کا تصور پایا جاتا ہے ، پھٹنے یا چرنے کا نہیں ۔ «فَرَجَ» بمعنی کھولنا ۔ کشادہ کرنا ۔ کُھلا کرنا (منجد) «فَرَجَ» بمعنی دو چیزوں یا ایک ہی چیز کے دو حصوں کے درمیان وسعت اور «فَرَجَ الطَّرِیْق»  بمعنی راستہ کا درمیانی حصہ (منجد ۔ مف) سوراخ یا شگاف خواہ پیدائشی ہو یا بعد میں واقع ہو ۔\nمثلاً در قرآن کریم آمده است :\n«اَفَلَمۡ  یَنۡظُرُوۡۤا  اِلَی السَّمَآءِ  فَوۡقَہُمۡ کَیۡفَ بَنَیۡنٰہَا وَ زَیَّنّٰہَا وَ مَا لَہَا مِنۡ فُرُوۡجٍ» ( 50/6 )\nترجمه : بگو: «من نمی‌گویم خزاین خدا نزد من است؛ و من، (جز آنچه خدا به من بیاموزد،) از غیب آگاه نیستم! و به شما نمی‌گویم من فرشته‌ام؛ تنها از آنچه به من وحی می‌شود پیروی می‌کنم.» بگو: «آیا نابینا و بینا مساویند؟! پس چرا نمی‌اندیشید؟!»,«فُرُوْج» [شکافی] «فُرُوْج» صرف درمیان در کھلی جگہ کو کہتے ہیں خواہ یہ شگاف پیدائشی ہو یا بعد در واقع ہو ۔,شکافی / سرشان / بالاى / بالای / شكافى / نیست؟ / نيست؟,فروج,50:6,1
1962,423,ش,مَدِیْنَۃ,«مَدَن» بمعنی اقامت کرنا ۔ شہر میں بسنا ۔ اور «تَمَدَّن» بمعنی مہذب و شائستہ ہونا (منجد) اور «مَدِیْنَۃ» ہر ایسی شہر کو کہتے ہیں جہاں لوگ مل جل کر اصول و قواعد کے تحت رہتے ہوں ۔ جمع «مَدَائِن» ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ جَآءَ مِنۡ اَقۡصَا الۡمَدِیۡنَۃِ  رَجُلٌ یَّسۡعٰی» ( 36/20 )\nترجمه : و مردی (با ایمان) از دورترین نقطه شهر با شتاب فرا رسید، گفت: «ای قوم من! از فرستادگان (خدا) پیروی کنید,«مَدِیْنَۃ» [این شھر] «مَدِیْنَۃ» ایسی بستی جہاں لوگ اصول و قواعد کے تحت رہتے ہوں ۔,این شھر / مدینہ / شھر بودند / شھر / آن شھر / در شھر / شهر,مدینۃ,7:123-9:101-9:120-12:30-15:67-18:19-18:82-27:48-28:15-28:18-28:20-33:60-36:20-63:8,14
1963,423,ش,بَلَد,«بَلَد» اسکی جمع «بِلاَد» ہے ۔  ہر وہ مقام جس کی حد بندی کی گئی ہو اور وہاں لوگ آباد ہوں (مف)\nمثلاً در قرآن کریم آمده است :\n«لَاۤ  اُقۡسِمُ  بِہٰذَا الۡبَلَدِ» ( 90/1 )\nترجمه : میں اس شہر ( مکہ معظمہ ) کی قسم کھاتا ہوں ۔,«بَلَد» [سرزمینی] «بَلَد» وہ شہر جس کی حد بندی کی گئی ہو ۔,سرزمینی / بہ سوی سرزمینی / و سرزمین / سرزمین را / سرزمینی کہ / زمین / مرده,بلد,2:126-7:57-7:58-14:35-16:7-25:49-27:91-34:15-35:9-43:11-50:11-90:1-90:2-95:3,14
1964,423,ش,مِصْر,«مِصْر» اسکی جمع  «مُصُوْر» ہے ۔ بمعنی حد ۔ کہتے ہیں «اِشْتَرٰی فُلَانُ الدَّار بِمُصُوْرِھَا» فلاں نے وہ مکان اس کی حدود تک خرید کیا ۔ اور «مِصْر» بمعنی پرگنہ (وہ زمین جس سے مالگُزاری و خراج لی جائے)  تحصیل ( جس کی حد بندی کی گئی ہو ) اور بعض کے نزدیک «مِصْر» ایسا شہر ہے جہاں مال فے اور صدقات تقسیم ہوتے ہوں (م ۔ ل) اور بعض کے نزدیک یہ فصیل (چار دیواری) والا شہر ہوتا ہے ۔ نیز «مِصْر» ایک ملک کا نام بھی ہے :\nمثلاً در قرآن کریم آمده است :\n«اِہۡبِطُوۡا مِصۡرًا فَاِنَّ لَکُمۡ مَّا سَاَلۡتُمۡ» ( 2/61 )\nترجمه : و (نیز به خاطر بیاورید) زمانی را که گفتید: «ای موسی! هرگز حاضر نیستیم به یک نوع غذا اکتفا کنیم! از خدای خود بخواه که از آنچه زمین می‌رویاند، از سبزیجات و خیار و سیر و عدس و پیازش، برای ما فراهم سازد.» موسی گفت: «آیا غذای پست‌تر را به جای غذای بهتر انتخاب می‌کنید؟! (اکنون که چنین است، بکوشید از این بیابان) در شهری فرود آئید؛ زیرا هر چه خواستید، در آنجا برای شما هست.» و (مهر) ذلت و نیاز، بر پیشانی آنها زده شد؛ و باز گرفتار خشم خدائی شدند؛ چرا که آنان نسبت به آیات الهی، کفر می‌ورزیدند؛ و پیامبران را به ناحق می‌کشتند. اینها به خاطر آن بود که گناهکار و متجاوز بودند,«مِصْر» [بہ شھری] «مِصْر» ایسا شہرجس کی حد بندی کی گئی ہو اور فصیل یعنی چار دیواری بھی ہو ۔,مصر / بہ شھری / در مصر / اھل مصر / بہ مصر / یوسف / يوسف,مصر,2:61-10:87-12:21-12:99-43:51,5
1965,423,ش,دِیَار,«دِیَار» جمع ہے «دَار» کی  اور اس کی جمع «دُوْر» بھی آتی ہے ۔ «دُوْر» بمعنی کسی چیز کا چاروں طرف سے گھرا ہونا اور «دَار» بمعنی گھر ۔ مکان ۔ اور «دَیْر» بمعنی کسی عابد (عبادت گزار) کی رہائش گاہ ۔ اور «دَار» بمعنی رہائش کے لحاظ سے اس کا مفہوم بڑا وسیع ہے جس کا اطلاق کسی بستی ، قصبہ ، شہر اور ملک سب پر ہوتا ہے ۔ «دَارُ الْحَرْب» بمعنی دشمن کا ملک «دَارُ الْقَرَار» بمعنی آخرت «دَارُ الدُّنْیَا» بمعنی دنیا کا گھر ۔ تمام دنیا ۔ اور «دَارَان» یا «دَارَیْن» بمعنی دنیا یا آخرت ۔\nمثلاً در قرآن کریم آمده است :\n«فَاِذَا جَآءَ وَعۡدُ اُوۡلٰىہُمَا بَعَثۡنَا عَلَیۡکُمۡ  عِبَادًا  لَّنَاۤ   اُولِیۡ  بَاۡسٍ  شَدِیۡدٍ فَجَاسُوۡا خِلٰلَ الدِّیَارِ» ( 17/5 )\nترجمه : آنها که گفتند: «خدا، همان مسیح بن مریم است»، بطور مسلّم کافر شدند؛ بگو: «اگر خدا بخواهد مسیح بن مریم و مادرش و همه کسانی را که روی زمین هستند هلاک کند، چه کسی می‌تواند جلوگیری کند؟ (آری،) حکومت آسمانها و زمین، و آنچه میان آن دو قرار دارد از آن خداست؛ هر چه بخواهد، می‌آفریند؛ (حتّی انسانی بدون پدر، مانند مسیح؛) و او، بر هر چیزی تواناست.»,«دِیَار» [خانہ ھا] «دِیَار» کا اطلاق گھر، گاؤں ، قصبہ ، شہر، ملک اور پوری دنیا پر بھی ہو سکتا ہے ۔,خانہ ھا / خانه / رانده / بیرون / بيرون / کاشانه,دیار,2:84-2:85-2:243-2:246-3:195-4:66-8:47-11:67-11:94-17:5-22:40-33:27-59:2-59:8-60:8-60:9,16
1966,423,ش,قَرْیَۃ,«قَرْیَۃ» کی جمع «قُرٰی» ہے ۔ اور اسکے دو بمعنی ہیں ۔ (1) بستی (2) بستی میں رہنے والے لوگ ۔ اس لفظ کا اطلاق الگ الگ معنوں میں بھی ہوتا ہے اور مجموعی طور پر بھی (مف) بستی خواہ بڑی ہو یا چھوٹی ، گاؤں ہو یا شہر ۔ سب پر اس کا اطلاق ہوتا ہے ۔ اور صاحب منجد کے نزدیک اس کا اطلاق صرف بڑی بستی پر ہوتا ہے (منجد) مثلاً در قرآن کریم آمده است :\n«وَ کَاَیِّنۡ  مِّنۡ  قَرۡیَۃٍ  عَتَتۡ عَنۡ اَمۡرِ رَبِّہَا وَ رُسُلِہٖ» ( 65/8 )\nترجمه : چه بسیار شهرها و آبادیها که اهل آن از فرمان خدا و رسولانش سرپیچی کردند و ما بشدّت به حسابشان رسیدیم و به مجازات کم‌نظیری گرفتار ساختیم\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«تِلۡکَ الۡقُرٰۤی اَہۡلَکۡنٰہُمۡ  لَمَّا ظَلَمُوۡا» ( 18/59 )\nترجمه : ای کسانی که ایمان آورده‌اید از (مخالفت) خدا بپرهیزید؛ و هر کس باید بنگرد تا برای فردایش چه چیز از پیش فرستاده؛ و از خدا بپرهیزید که خداوند از آنچه انجام می‌دهید آگاه است,«قَرْیَۃ» [آبادی] «قَرْیَۃ» بڑی بستی شہر یا گاؤں اور اس کے رہنے والے لوگ ۔,آبادی / آبادی ای / ھیچ آبادی ای / مردم ھیچ آبادیی / از اھل این آبادی / آبادی ای را / شهری,قریۃ,2:58-2:259-4:75-6:123-7:4-7:82-7:88-7:94-7:161-7:163-10:98-12:82-15:4-16:112-17:16-17:58-18:77-21:6-21:11-21:74-21:95-22:45-22:48-25:40-25:51-26:208-27:34-27:56-28:58-29:31-29:34-34:34-36:13-43:23-43:31-47:13-65:8,37
1967,424,ش,زُجَاجَۃ,«زُجَاجَۃ» بمعنی شیشہ ( GLASS ) کانچ ۔ بلور ۔ معروف لفظ ہے ۔ شیشہ کا ٹکڑا یا شیشے کا برتن سب کے لیے مستعمل ہے ۔ «اَلزُّجَاجِی» بمعنی شیشہ بیچنے والا ۔ اور مثلاً در قرآن کریم آمده است :\n«اَلۡمِصۡبَاحُ فِیۡ زُجَاجَۃٍ ؕ اَلزُّجَاجَۃُ کَاَنَّہَا کَوۡکَبٌ دُرِّیٌّ» ( 24/35 )\nترجمه : خداوند نور آسمانها و زمین است؛ مثل نور خداوند همانند چراغدانی است که در آن چراغی (پر فروغ) باشد، آن چراغ در حبابی قرار گیرد، حبابی شفاف و درخشنده همچون یک ستاره فروزان، این چراغ با روغنی افروخته می‌شود که از درخت پربرکت زیتونی گرفته شده که نه شرقی است و نه غربی؛ (روغنش آنچنان صاف و خالص است که) نزدیک است بدون تماس با آتش شعله‌ور شود؛ نوری است بر فراز نوری؛ و خدا هر کس را بخواهد به نور خود هدایت می‌کند، و خداوند به هر چیزی داناست,«زُجَاجَۃ» [شیشہ ای است] «زُجَاجَۃ» بمعنی شیشہ ، کانچ ، بلور جس کے آرپار دیکھا جا سکے ۔,مثلی برای نور ایمان / شیشہ ای است / آن شیشہ / چراغ / چراغی / چراغى / چراغدانی,زجاجۃ,24:35,1
1968,424,ش,قَوَارِیْر,«قَوَارِیْر» جمع ہے «قَارُوْرَہ » کی  بمعنی کوئی پینے کی چیز (مشروب) یا کھجور یا چھوہارے رکھنے کا برتن (منجد) شیشے کا برتن ۔ اور حکیموں کی اصطلاح میں شیشے کا وہ برتن (بوتل) جس میں ڈاکٹر یا حکیم مریض کے پیشاب معائنہ کرے ۔ اور «قَارُوْرَہ» ہر اس شیشہ کو کہتے ہیں جو کسی غرض کے لیے بنایا گیا ہو خواہ یہ چہرہ دیکھنے کا ہو یا عمارتوں کی زیبائش کے لیے رنگدار بنایا گیا ہو یا برتن سازی میں استعمال ہو ۔\nمثلاً در قرآن کریم آمده است :\n«وَ یُطَافُ عَلَیۡہِمۡ  بِاٰنِیَۃٍ  مِّنۡ  فِضَّۃٍ وَّ اَکۡوَابٍ کَانَتۡ قَؔوَارِیۡرَا۠» ( 76/15 )\nترجمه : و ویرانه‌های سرزمین آنها، بر سر راه (کاروانها)، همواره ثابت و برقرار است؛,«قَوَارِیْر» [بلور] «قَوَارِیْر» وہ شیشہ ہے جس کو کسی غرض کے لیے بنایا جائے ۔ شیشہ کی مصنوعات ۔ خواہ پھولدار اور رنگین ہوں ۔,بلور / بلورین / بلور ھای / آبگینه / آبگينه / پنداشت / بلورين,قواریر,27:44-76:15-76:16,3
1969,425,ص,مَحَّصَ,«مَحَّصَ» کسی ایسی چیز کو صاف کرنا جس میں ملاوٹ رچ بس گئی ہو ۔ مادی اشیاء میں اس کا اطلاق مرکبات ( COMPOUNDS ) کو الگ کرنے کے لیے ہوتا ہے ۔ جیسے «مَحَّصَ الذَّھْب» بمعنی سونے کو کٹھالی  میں ڈال کر دوسری دھاتوں کی ملاوٹ اور گندگی دور کر دینا ۔ اور معنوی لحاظ سے اس کا اطلاق کسی کو رنج و مصائب  میں مبتلا کر کے اسے پاک و صاف بنانا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ لِیُمَحِّصَ اللّٰہُ الَّذِیۡنَ اٰمَنُوۡا وَ یَمۡحَقَ الۡکٰفِرِیۡنَ» ( 3/141 )\nترجمه : و تا خداوند، افراد باایمان را خالص گرداند (و ورزیده شوند)؛ و کافران را به تدریج نابود سازد\nنوٹ : (کٹھالی (cupel) اس چھوٹی سی پیالی کو کہتے ہیں جس میں سونا چاندی رکھ کر پگھلائی جاتی ہے),«مَحَّصَ» [و تاخالص گرداند] «مَحَّصَ» کسی ایسی چیز کو صاف کرنا جو چند چیزوں کو ملا کر بنائی گئی ہو اورملاوٹ اس در رچ بس گئی ہو ۔,و تاخالص گرداند / و تا خالص گرداند / خالص / جاهلیت / جاهليت / شدیم / شديم,محص,3:141-3:154,2
1970,425,ص,طَھَرَ,«طَھَّرَ» اسکی ضد «دَنَسَ» بمعنی میل کچیل ہے ۔ «طَھَّرَ» یعنی میل کچیل کو دور کرنا ۔ اور «طَھُوْر» بمعنی میل کچیل اور غلاظت سے پاک ۔ صاف نتھرا ہوا ۔ شفاف ۔\nمثلاً در قرآن کریم آمده است :\n«وَ اَنۡزَلۡنَا مِنَ السَّمَآءِ مَآءً  طَہُوۡرًا» ( 25/48 )\nترجمه : او کسی است که بادها را بشارتگرانی پیش از رحمتش فرستاد، و از آسمان آبی پاک‌کننده نازل کردیم,«طَھَرَ» [پاکیزہ] «طَھَّرَ» ظاہری نجاست کو پانی وغیرہ سے صاف کرنا ۔,پاکیزہ / پاکیزہ گرادنید / پاک شوند / پاکی ورزیدند غسل کردند / پاکی ورزان را / و پاکیزہ تر / پاک,طھر,2:25-2:125-2:222-2:232-3:15-3:42-3:55-4:57-5:6-5:41-7:82-8:11-9:103-9:108-11:78-22:26-25:48-27:56-33:33-33:53-56:79-58:12-74:4-76:21-80:14-98:2,26
1971,425,ص,صَفَّا,«صَفّا» ایسی چیزوں کو گندگی اور ملاوٹ سے پاک صاف کرنا جن کو الگ کرنا کیمیاوی عمل کے بغیر ممکن ہو ۔ یعنی آمیزہ ( MIXTURE ) جیسے شہد کو موم اور چھتہ وغیرہ سے پاک و صاف کرنا یا نمکین پانی کو گرم کر کے پانی اور نمک کو الگ الگ کر دینا ۔\nمثلاً در قرآن کریم آمده است :\n«وَ اَنۡہٰرٌ مِّنۡ عَسَلٍ مُّصَفًّی» ( 47/15 )\nترجمه : هر گونه غلِّ [= حسد و کینه و دشمنی‌] را از سینه آنها برمی‌کنیم (و روحشان را پاک می‌سازیم)؛ در حالی که همه برابرند، و بر تختها روبه‌روی یکدیگر قرار دارند,«صَفّا» ایسی چیزوں کو گندگی اور ملاوٹ سے پاک صاف کرنا جن کو الگ کرنا کیمیاوی عمل کے بغیر ممکن ہو ۔,نوشیدنی های بهشتی / نوشندگان / بهشتی / بهشتى / عسل / مزه,صفا,47:15,1
1972,425,ص,مَسَحَ,«مَسَحَ» بمعنی کسی چیز پر ہاتھ پھیر کر اس کے گرد اور گندگی وغیرہ کو دور کرنا ۔ جھاڑنا ، پونچھنا ۔\nمثلاً در قرآن کریم آمده است :\n«فَطَفِقَ مَسۡحًۢا بِالسُّوۡقِ وَ الۡاَعۡنَاقِ» ( 38/33 )\nترجمه : (آنها به قدری جالب بودند که گفت:) بار دیگر آنها را نزد من بازگردانید! و دست به ساقها و گردنهای آنها کشید (و آنها را نوازش داد)\nاور شرعی اصطلاح میں مسح کا معنی پاک مٹی یا پانی کو پہلے کسی جگہ پر ملنا یا لگانا پھر اسے جھاڑ کر صاف کر دینا ہے ۔\nمثلاً : ارشاد باری تعالیٰ ہے :\n«فَتَیَمَّمُوۡا صَعِیۡدًا طَیِّبًا فَامۡسَحُوۡا بِوُجُوۡہِکُمۡ وَ اَیۡدِیۡکُمۡ مِّنۡہُ» ( 5/6 )\nترجمه : ای کسانی که ایمان آورده‌اید! هنگامی که به نماز می‌ایستید، صورت و دستها را تا آرنج بشویید! و سر و پاها را تا مفصل [= برآمدگی پشت پا] مسح کنید! و اگر جنب باشید، خود را بشویید (و غسل کنید)! و اگر بیمار یا مسافر باشید، یا یکی از شما از محل پستی آمده [= قضای حاجت کرده‌]، یا با زنان تماس گرفته (و آمیزش جنسی کرده‌اید)، و آب (برای غسل یا وضو) نیابید، با خاک پاکی تیمم کنید! و از آن، بر صورت [= پیشانی‌] و دستها بکشید! خداوند نمی‌خواهد مشکلی برای شما ایجاد کند؛ بلکه می‌خواهد شما را پاک سازد و نعمتش را بر شما تمام نماید؛ شاید شکر او را بجا آورید,«مَسَحَ» [پس باآن مسح کنید] «مَسَحَ» ہاتھ پھیر کر گرد اور گندگی وغیرہ کو پونچھنا ۔ جھاڑنا ۔ صاف کرنا ۔,پس باآن مسح کنید / و مسح کنید / پس با آن مسح کنید / بہ ذبح وپی کردن / غسل / مسح / تیمم,مسح,4:43-5:6-38:33,3
1973,426,ص,صَبَرَ,«صَبْر» بمعنی کسی تکلیف یا صدمہ پہنچنے پر اسے برداشت کر جانا اور بیقراری ، بے صبری اور گریہ و زاری کا اظہار نہ کرنا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«فَصَبَرُوۡا عَلٰی مَا کُذِّبُوۡا وَ اُوۡذُوۡا حَتّٰۤی اَتٰہُمۡ  نَصۡرُنَا» ( 6/34 )\nترجمه : کسانی که به ایشان علم داده شده، آنچه را از سوی پروردگارت بر تو نازل شده حق می دانند و به راه خداوند عزیز و حمید هدایت می‌کند,«صَبَرَ» [از شکیبا یی] «صَبْر» مصائب و مشکلات پڑنے پر برداشت کر جانا ۔,از شکیبا یی / تاب نمی آوریم / از شکیبایی / شکیبایان است / شکیبا یند / شکیبایی را / صبر,صبر,2:45-2:61-2:153-2:175-2:250-3:120-3:125-3:186-3:200-4:25-6:34-7:87-7:126-7:128-7:137-8:46-10:109-11:11-11:49-11:115-12:18-12:83-12:90-13:22-13:24-14:12-14:21-16:42-16:96-16:110-16:126-16:127-18:28-18:67-18:68-18:72-18:75-18:78-18:82-20:130-23:111-25:20-25:42-25:75-28:54-29:59-30:60-31:17-32:24-38:6-38:17-40:55-40:77-41:24-41:35-42:43-46:35-49:5-50:39-52:16-52:48-68:48-70:5-73:10-74:7-76:12-76:24-90:17-103:3,69
1974,426,ص,قَانِع,«قاَنِع» بمعنی قناعت یعنی جو کچھ حصہ میں آئے جائے اس پر صبر کرنا (منجد) اور «قَنَاعَت» بمعنی ضروریات زندگی سے متعلق تھوڑی چیز پر راضی ہونا (مف) تھوڑی چیز پر صبر شکر کرنا اور کسی کے سامنے شکوہ شکایت نہ کرنا ہے (مف)\nمثلاً در قرآن کریم آمده است :\n«فَاِذَا وَجَبَتۡ جُنُوۡبُہَا فَکُلُوۡا مِنۡہَا وَ اَطۡعِمُوا الۡقَانِعَ وَ الۡمُعۡتَرَّ» ( 22/36 )\nترجمه : و شترهای چاق و فربه را (در مراسم حج) برای شما از شعائر الهی قرار دادیم؛ در آنها برای شما خیر و برکت است؛ نام خدا را (هنگام قربانی کردن) در حالی که به صف ایستاده‌اند بر آنها ببرید؛ و هنگامی که پهلوهایشان آرام گرفت (و جان دادند)، از گوشت آنها بخورید، و مستمندان قانع و فقیران را نیز از آن اطعام کنید! این گونه ما آنها را مسخّرتان ساختیم، تا شکر خدا را بجا آورید,«قَانِع» [نیازمند خویشتن دار] «قاَنِع» قناعت کرنے والا، اکتفا کرنے والا، صابر شاکر، جو کچھ حصّے در آئے اُسی پر صبر و شکر ادا کرنا ۔ ,شتر نشانه قدرت خداوند است / نیازمند خویشتن دار / شعائر / شعاير / شتران / ایستاده / ايستاده,قانع,22:36,1
1975,427,ص,صُلْح,«اَلْاِصْلَاح» اسکی کی ضد فساد بمعنی بگاڑ ہے ۔ اور «اَصْلَحَ» بمعنی بگاڑ کو درست کرنا ۔ اور «صُلْح» ان فریقین کے درمیان باہمی سمجھوتہ کو کہتے ہیں جن میں پہلے سے بگاڑ ، جھگڑا یا لڑائی موجود ہو ۔\nمثلاً در قرآن کریم آمده است :\n«وَ اِنۡ طَآئِفَتٰنِ مِنَ الۡمُؤۡمِنِیۡنَ اقۡتَتَلُوۡا فَاَصۡلِحُوۡا بَیۡنَہُمَا» ( 49/9 )\nترجمه : بعضی از آنها می‌گویند: «به ما اجازه ده (تا در جهاد شرکت نکنیم)، و ما را به گناه نیفکن»! آگاه باشید آنها (هم اکنون) در گناه سقوط کرده‌اند؛ و جهنم، کافران را احاطه کرده است\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«وَ اِنِ امۡرَاَۃٌ خَافَتۡ مِنۡۢ بَعۡلِہَا نُشُوۡزًا اَوۡ اِعۡرَاضًا فَلَا جُنَاحَ عَلَیۡہِمَاۤ  اَنۡ یُّصۡلِحَا بَیۡنَہُمَا صُلۡحًا ؕ وَ الصُّلۡحُ  خَیۡرٌ» ( 4/128 )\nترجمه : و اگر زنی، از طغیان و سرکشی یا اعراضِ شوهرش، بیم داشته باشد، مانعی ندارد با هم صلح کنند (و زن یا مرد، از پاره‌ای از حقوق خود، بخاطر صلح، صرف نظر نماید.) و صلح، بهتر است؛ اگر چه مردم (طبق غریزه حبّ ذات، در این گونه موارد) بخل می‌ورزند. و اگر نیکی کنید و پرهیزگاری پیشه سازید (و بخاطر صلح، گذشت نمایید)، خداوند به آنچه انجام می‌دهید، آگاه است (و پاداش شایسته به شما خواهد داد),«صُلْح» [اصلاح گرانیم] «صُلْح» جھگڑے کے بعد فریقین کے درمیان باہمی سمجھوتہ کو کہتے ہیں ۔,اصلاح گرانیم / واصلاح کردند فساد کاری ھایشان را / آنگاہ آشتی دھد / اصلاح / شایستہ کار / و اصلاح کنید / اصلاحِ,صلح,2:11-2:160-2:182-2:220-2:224-2:228-3:89-4:16-4:35-4:114-4:128-4:129-4:146-5:39-6:48-6:54-7:35-7:56-7:85-11:88-17:142-7:170-8:1-10:81-11:117-13:23-16:119-21:90-24:5-26:152-27:48-28:19-33:71-40:8-42:40-46:15-47:2-47:5-49:9-49:10,40
1976,427,ص,سَلَم,«اَلسَّلْم» بمعنی سلامتی ۔ تابعداری اور «سَلَم» بمعنی نجات پانا ، محفوظ ہونا ۔ اور «سَلَم» صلح کرانے والے کو بھی کہتے ہیں (منجد) اور ایسے سمجھوتہ یا صلح کو بھی جو لڑائی یا بگاڑ پیدا ہونے سے پہلے ہی ہو جائے ۔ مطیع ہونا ۔\nمثلاً در قرآن کریم آمده است :\n«فَاِنِ اعۡتَزَلُوۡکُمۡ فَلَمۡ یُقَاتِلُوۡکُمۡ  وَ اَلۡقَوۡا اِلَیۡکُمُ السَّلَمَ ۙ فَمَا جَعَلَ اللّٰہُ لَکُمۡ عَلَیۡہِمۡ  سَبِیۡلًا» ( 4/90 )\nترجمه : که ما انسان را در رنج آفریدیم (و زندگی او پر از رنجهاست),«سَلَم» [طرح سازش را] «سَلَم» ایسا سمجھوتہ یا صلح جو لڑائی یا بگاڑ پیدا ہونے سے پہلے ہی ہو جائے ۔,طرح سازش را / طرح آشتی را / بہ صلح / سرتسلیم را / سر تسلیم / سازش / صلح,سلم,4:90-4:91-8:61-16:28-16:87-47:35,6
1977,428,ض,کَفِیْل,«کَفَلَ» بمعنی کسی کے نان و نفقہ اور خبر گیری کا ذمہ دار ہونا ۔ ضامن ہونا (مف) اور «کَفِیْل» میں کسی مجرم کی ضمانت لینے کے معنی بھی پائے جاتے ہیں ۔\nمثلاً در قرآن کریم آمده است :\n«وَ مَا کُنۡتَ لَدَیۡہِمۡ  اِذۡ  یُلۡقُوۡنَ اَقۡلَامَہُمۡ اَیُّہُمۡ یَکۡفُلُ مَرۡیَمَ» ( 3/44 )\nترجمه : که ما آن را در شبی پر برکت نازل کردیم؛ ما همواره انذارکننده بوده‌ایم\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«وَ قَدۡ جَعَلۡتُمُ اللّٰہَ  عَلَیۡکُمۡ  کَفِیۡلًا» ( 16/91 )\nترجمه : و هنگامی که با خدا عهد بستید، به عهد او وفا کنید! و سوگندها را بعد از محکم ساختن نشکنید، در حالی که خدا را کفیل و ضامن بر (سوگند) خود قرار داده‌اید، به یقین خداوند از آنچه انجام می‌دهید، آگاه است,«کَفِیْل» [ضامن] «کَفِیْل» ایسا ضامن جو نان و نفقہ اور خبر گیری کا ذمہ دار ہو ۔ ,ضامن / سرپرستی / سرپرستى / مریم / مريم / مادرت / خواهرت,کفیل,3:37-3:44-16:91-20:40-28:12-38:23,6
1978,428,ض,زَعِیْم,«زُعَامَۃ» بمعنی  سرداری ، سربراہی ، لیڈری ، لیڈر شپ ، قیادت «زَعِیْم» وہ شخص ہے جو حکومت کی طرف سے کسی بات کا ذمہ دار یا ضامن ہو ۔\nمثلاً در قرآن کریم آمده است :\n«قَالُوۡا نَفۡقِدُ صُوَاعَ  الۡمَلِکِ  وَ لِمَنۡ  جَآءَ بِہٖ  حِمۡلُ  بَعِیۡرٍ  وَّ اَنَا  بِہٖ  زَعِیۡمٌ» ( 12/72 )\nترجمه : گفتند: «پیمانه پادشاه را! و هر کس آن را بیاورد، یک بار شتر (غلّه) به او داده می‌شود؛ و من ضامن این (پاداش) هستم!»,«زَعِیْم» [ضامنم] «زَعِیْم» وہ ضامن جو حکومت کی طرف سے کسی بات کا ذمہ دار ہو ۔,ضامنم / ضامن است / ضامن / بپرس / گم / شتر,زعیم,12:72-68:40,2
1979,429,ط,طَاقَت,«طَاقَت» معروف لفظ ہے اور اس کا استعمال عام ہے ۔ بمعنی ہمت ، سکت ( POWER ) جو کسی کام کے لیے درکار ہو (مف)  ۔\nمثلاً در قرآن کریم آمده است :\n«رَبَّنَا وَ لَا  تُحَمِّلۡنَا مَا لَا طَاقَۃَ لَنَا بِہٖ» ( 2/286 )\nترجمه : خداوند هیچ کس را، جز به اندازه تواناییش، تکلیف نمی‌کند. (انسان،) هر کار (نیکی) را انجام دهد، برای خود انجام داده؛ و هر کار (بدی) کند، به زیان خود کرده است. (مؤمنان می‌گویند:) پروردگارا! اگر ما فراموش یا خطا کردیم، ما را مؤاخذه مکن! پروردگارا! تکلیف سنگینی بر ما قرار مده، آن چنان که (به خاطر گناه و طغیان،) بر کسانی که پیش از ما بودند، قرار دادی! پروردگارا! آنچه طاقت تحمل آن را نداریم، بر ما مقرّر مدار! و آثار گناه را از ما بشوی! ما را ببخش و در رحمت خود قرار ده! تو مولا و سرپرست مایی، پس ما را بر جمعیّت کافران، پیروز گردان,«طَاقَت» عام لفظ ہے ۔ اتنی سکت جو کسی کام کے لیے درکار ہو ۔,پیروز / پيروز / طالوت / جالوت / تکلیف / تكليف,طاقت,2:249-2:286,2
1980,429,ط,قُوَّۃ,«قُوَّۃ» بمعنی زور ( FORCE )  استعداد اور صلاحیت جو کسی چیز کے اندر پائی جائے (مف) اور اسکی ضد «ضُعْف» بمعنی کمزوری ہے (مف)\nمثلاً در قرآن کریم آمده است :\n«اِنَّ مَفَاتِحَہٗ  لَتَنُوۡٓاُ بِالۡعُصۡبَۃِ  اُولِی الۡقُوَّۃِ» ( 28/76 )\nترجمه : قارون از قوم موسی بود، اما بر آنان ستم کرد؛ ما آنقدر از گنجها به او داده بودیم که حمل کلیدهای آن برای یک گروه زورمند مشکل بود! (به خاطر آورید) هنگامی را که قومش به او گفتند: «این همه شادی مغرورانه مکن، که خداوند شادی‌کنندگان مغرور را دوست نمی‌دارد,«قُوَّۃ» [با جدیت تمام] «قُوَّۃ» وہ استعداد (قابلیت) اور صلاحیت جو کسی چیز کے اندر موجود ہو ۔,با جدیت تمام / با جد و جھد تمام / تمام قدرت / باجد وجھد / با جدو جھد / نیرو / نیرومندتر,قوۃ,2:63-2:93-2:165-7:145-7:171-8:60-9:69-11:52-11:80-16:92-18:39-18:95-19:12-27:33-28:76-28:78-30:9-30:54-35:44-40:21-40:82-41:15-47:13-51:58-81:20-86:10,26
1981,429,ط,مِرَّۃ,«مِرَّۃ» بمعنی شدت ۔ کسی چیز کی دائمی حالت ۔ طاقت ۔ مضبوطی ۔ (منجد) شدت اور عزم (ق ۔ ج) اور «ذُوْمِرَّۃ» محاورہ ہے یعنی مضبوط اور طاقتور ۔ توانا ۔ بڑا زور آور ۔ اور «مَرِیْر» بمعنی بٹی ہوئی رسی (مف)\nمثلاً در قرآن کریم آمده است :\n«عَلَّمَہٗ  شَدِیۡدُ الۡقُوٰی ذُوۡ مِرَّۃٍ ؕ  فَاسۡتَوٰی» ( 53/5،6 )\nترجمه : آنها که ایمان آورده‌اند می‌گویند: «آیا این (منافقان) همانها هستند که با نهایت تأکید سوگند یاد کردند که با شما هستند؟! (چرا کارشان به اینجا رسید؟!)» (آری،) اعمالشان نابود گشت، و زیانکار شدند,«مِرَّۃ» بمعنی شدت ۔ کسی چیز کی دائمی حالت ۔ طاقت ۔ مضبوطی ۔ ,ایستاد / ايستاد / توانمندى / توانمندی / نیرومندی / نيرومندى / مسلّط,مرۃ,53:6,1
1982,429,ط,رُکْن,«رُکْن» کسی جماعت یا انجمن یا ادارے کا ممبر، کسی گروہ کا ایک فرد ۔ اور بمعنی ستون ۔ قلعہ ، آسرا، سہارا، حمایت کے لیے استعمال ہوتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«قَالَ لَوۡ اَنَّ لِیۡ بِکُمۡ قُوَّۃً  اَوۡ اٰوِیۡۤ اِلٰی رُکۡنٍ  شَدِیۡدٍ» ( 11/80 )\nترجمه : هرگز چنین نیست که آنها می‌پندارند؛ این (قرآن) تذکّر و یادآوری است،,«رُکْن» [تکیہ گاھی] «رُکْن» کسی جماعت یا انجمن یا ادارے کا ممبر، کسی گروہ کا ایک فرد ۔,تکیہ گاھی / کہ میل کنی / تکیه / تكيه / کاش / كاش / پناه,رکن,11:80-11:113-17:74,3
1983,429,ط,مَحُلَ,«مَحُل» بمعنی کسی کے خلاف قوت اور سختی کے ساتھ بری تدبیر کرنا (مف ۔ منجد) گویا «مَحْل» کے معنی میں «قُوَّۃ» اور «حِیْلَۃ» دو باتیں پائی جاتی ہیں ۔ یعنی کسی شخص پر حیلہ اور تدبیر سے گرفت اور پکڑ شدید کرتے جانا ۔ اور «مَحْل» بمعنی دھوکا ۔ مکر ۔ دشمنی ۔ شدت ۔ قحط ۔ سخت بھوک (منجد)\nمثلاً در قرآن کریم آمده است :\n«وَ ہُمۡ  یُجَادِلُوۡنَ فِی اللّٰہِ ۚ وَ ہُوَ  شَدِیۡدُ الۡمِحَالِ» ( 13/13 )\nترجمه : و رعد، تسبیح و حمد او می‌گوید؛ و (نیز) فرشتگان از ترس او! و صاعقه‌ها را می‌فرستد؛ و هر کس را بخواهد گرفتار آن می‌سازد، (در حالی که آنها با مشاهده این همه آیات الهی، باز هم) درباره خدا به مجادله مشغولند! و او قدرتی بی‌انتها (و مجازاتی دردناک) دارد,«مَحُلَ» [کیفر است] «مَحُل» کسی کے خلاف قوت اور سختی کے ساتھ بری تدبیر کرنا ۔,مردم اعتصابی / کیفر است / صاعقه / صاعقۀ / رعد / مجادله / تسبیح,محل,13:13,1
1984,429,ط,اَطَاق,«اَطَاق» بمعنی کسی کام کی ہمت اور طاقت رکھنا ۔ معروف لفظ ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ عَلَی الَّذِیۡنَ یُطِیۡقُوۡنَہٗ فِدۡیَۃٌ طَعَامُ مِسۡکِیۡنٍ» ( 2/184 )\nترجمه : چند روز معدودی را (باید روزه بدارید!) و هر کس از شما بیمار یا مسافر باشد تعدادی از روزهای دیگر را (روزه بدارد) و بر کسانی که روزه برای آنها طاقت‌فرساست؛ (همچون بیماران مزمن، و پیرمردان و پیرزنان،) لازم است کفّاره بدهند: مسکینی را اطعام کنند؛ و کسی که کارِ خیری انجام دهد، برای او بهتر است؛ و روزه داشتن برای شما بهتر است اگر بدانید,«اَطَاق» کسی چیز پر قادر ہونا، طاقت رکھنا ۔,روزهای / روزهاى / بیمار / بيمار / روزه / کفاره / کفّاره,اطاق,2:184,1
1985,429,ط,اِسْتِطَاعَ,«اِسْتِطَاعَ الْاَمْر» بمعنی کسی کام کی طاقت رکھنا ۔ لائق ہونا (منجد) اور بمعنی کسی کام کو سرانجام دینے کے لیے جن اسباب کی ضرورت ہوتی ہے ان سب کا موجود ہونا (مف) طاقت کا تعلق محض کسی کی اپنی ذات تک محدود ہے جبکہ استطاعت کا تعلق ذاتی طاقت کے علاوہ بعض دوسرے اسباب و ذرائع سے بھی متعلق ہے ۔ جیسے حج کے لیے خرچ ، سواری ، راستہ کا پر امن ہونا ، گھر والوں کے لیے خرچ وغیرہ ۔\nمثلاً در قرآن کریم آمده است :\n«وَ لِلّٰہِ عَلَی النَّاسِ حِجُّ الۡبَیۡتِ مَنِ اسۡتَطَاعَ اِلَیۡہِ سَبِیۡلًا» ( 3/97 )\nترجمه : در آن، نشانه‌های روشن، (از جمله) مقام ابراهیم است؛ و هر کس داخل آن [= خانه خدا] شود؛ در امان خواهد بود، و برای خدا بر مردم است که آهنگ خانه (او) کنند، آنها که توانایی رفتن به سوی آن دارند. و هر کس کفر ورزد (و حج را ترک کند، به خود زیان رسانده)، خداوند از همه جهانیان، بی‌نیاز است\nاسی لیے «اِسْتِطَاعَ» کا معنی طاقت و قدرت رکھنا ، توفیق رکھنا یا کسی کام کو کر سکنا کیا جاتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«فَمَا اسۡطَاعُوۡۤا اَنۡ یَّظۡہَرُوۡہُ  وَ مَا اسۡتَطَاعُوۡا  لَہٗ  نَقۡبًا» ( 18/97 )\nترجمه : در آن، نشانه‌های روشن، (از جمله) مقام ابراهیم است؛ و هر کس داخل آن [= خانه خدا] شود؛ در امان خواهد بود، و برای خدا بر مردم است که آهنگ خانه (او) کنند، آنها که توانایی رفتن به سوی آن دارند. و هر کس کفر ورزد (و حج را ترک کند، به خود زیان رسانده)، خداوند از همه جهانیان، بی‌نیاز است\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«اِذۡ  قَالَ الۡحَوَارِیُّوۡنَ یٰعِیۡسَی ابۡنَ  مَرۡیَمَ ہَلۡ یَسۡتَطِیۡعُ رَبُّکَ اَنۡ یُّنَزِّلَ عَلَیۡنَا مَآئِدَۃً مِّنَ السَّمَآءِ» ( 5/112 )\nترجمه : اور (ذرایاد کرو اس واقعے کو) جب حواریوں نے کہا کہ اے عیسیٰ ابن مریم کیا آپ کے رب کو یہ قدرت حاصل ہے کہ ہم پر آسمان سے ایک دستر خوان اتارے ؟,«اِسْتِطَاعَ» [بتواند] «اِسْتِطَاعَ» بمعنی کسی کام کی طاقت رکھنا ۔,بتواند / توانند / توانید / توانيد / توانایی / توانائی / توان,استطاع,2:217-2:273-2:282-3:97-4:25-4:98-4:129-5:112-6:35-7:192-7:197-8:60-9:42-10:38-11:13-11:20-11:88-16:73-17:48-17:64-18:41-18:67-18:72-18:75-18:78-18:97-18:101-21:40-21:43-25:9-25:19-26:211-36:50-36:67-36:75-51:45-55:33-58:4-64:16-68:42,40
1986,430,ط,طَرِیْقَۃ,«طَرِیْقَۃ» بمعنی عادت ۔ حالت ۔ مذہب (منجد) ہر اس ملک اور مذہب کو «طَرِیْق» کہا جاتا ہے ۔ جو انسان کوئی کام اختیار کرنے کے لیے کرتا ہے ۔ خواہ وہ کام اچھا ہو یا بُرا (مف)\nمثلاً در قرآن کریم آمده است :\n«وَ یَذۡہَبَا بِطَرِیۡقَتِکُمُ  الۡمُثۡلٰی» ( 20/63 )\nترجمه : گفتند: «این دو (نفر) مسلّماً ساحرند! می‌خواهند با سحرشان شما را از سرزمینتان بیرون کنند و راه و رسم نمونه شما را از بین ببرند\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«اِذۡ یَقُوۡلُ اَمۡثَلُہُمۡ طَرِیۡقَۃً اِنۡ لَّبِثۡتُمۡ اِلَّا یَوۡمًا» ( 20/104 )\nترجمه : ما به آنچه آنها می‌گویند آگاهتریم، هنگامی که نیکوروش‌ترین آنها می‌گوید: «شما تنها یک روز درنگ کردید!»\nگویا شرعی اصطلاح میں طریقہ ، لوگوں کی ان رسوم و عادات کو کہتے ہیں جنھیں لوگوں نے مذہبی شعار کا درجہ دے رکھا ہو ۔,«طَرِیْقَۃ» [راہ راست] «طَرِیْقَۃ» وہ رسم و رواج جنھیں انسان مذہبی امور سمجھنے لگتا ہے ۔,راہ راست / سرزمینتان / سرزمينتان / پایداری / پايدارى / فراوان / آيين,طریقۃ,20:63-20:104-72:16,3
1987,430,ط,سُنَّۃ,«سَنَّ» بمعنی کسی چیز کا جاری ہونا اور اس کا درست طور پر چلنا (م ۔ ل) لازم و متعدی دونوں طرح استعمال ہوتا ہے ۔ «جیسے مَنْ سَنَّ سُنَّۃً» جس کسی نے کوئی بات ( طریقہ ، رسم ، دستور ) رائج کیا ۔ جب اس کی نسبت اللہ تعالیٰ کی طرف ہو تو اس سے قانون الہی ( جسے عمومًا قانون قدرت کہہ دیتے ہیں ) مراد ہو گا ۔\nمثلاً در قرآن کریم آمده است :\n«فَہَلۡ یَنۡظُرُوۡنَ  اِلَّا سُنَّتَ الۡاَوَّلِیۡنَ ۚ فَلَنۡ تَجِدَ لِسُنَّتِ اللّٰہِ تَبۡدِیۡلًا» ( 35/43 )\nترجمه : اینها همه بخاطر استکبار در زمین و نیرنگهای بدشان بود؛ امّا این نیرنگها تنها دامان صاحبانش را می‌گیرد؛ آیا آنها چیزی جز سنّت پیشینیان و (عذابهای دردناک آنان) را انتظار دارند؟! هرگز برای سنّت خدا تبدیل نخواهی یافت، و هرگز برای سنّت الهی تغییری نمی‌یابی\nاور جب صرف لفظ سنت بولا جائے تو اس سے مراد بالعموم وہ طریقہ ہے جو رسول اکرم ﷺ نے رائج فرمایا ہو اور اسکی جمع «سُنَن» ہے ۔ اسوہ رسول ﷺ ۔,«سُنَّۃ» [شیوۂ] «سُنَّۃ» وہ قوانین الہی جو کائنات در جاری و ساری ہیں ۔ یا وہ طریقہ جس کی کوئی داغ بیل ڈالے اور وہ چل نکلے ۔,شیوۂ / بہ شیوۂ / روش / مانند روش / طبق سنّت / برای سنت / سنت,سنۃ,8:38-15:13-17:77-18:55-33:38-33:62-35:43-40:85-48:23,9
1988,430,ط,اُمَّۃ,«اُمَّۃ» ایک ہی عقیدہ یا نظریہ کے ہم خیال لوگوں کو امت کہتے ہیں (مف) پھر اس لفظ کا اطلاق اس عقیدہ یا نظریہ پر بھی ہوتا ہے جس پر لوگ ہم خیال ہو جائیں خواہ یہ عقیدہ یا نظریہ غلط ہو یا درست ۔\nمثلاً در قرآن کریم آمده است :\n«اِنَّا وَجَدۡنَاۤ  اٰبَآءَنَا عَلٰۤی  اُمَّۃٍ  وَّ اِنَّا عَلٰۤی اٰثٰرِہِمۡ  مُّقۡتَدُوۡنَ» ( 43/23 )\nترجمه : هیچ امتی بر اجل و سر رسید حتمی خود پیشی نمی‌گیرد، و از آن تأخیر نیز نمی‌کند,«اُمَّۃ» [امتی] «اُمَّۃ» کسی ہم خیال جماعت کا نظریہ یا عقیدہ اور اس کے ہم خیال لوگ ۔,امتی / گرو ھی کہ / امتی کہ / گروھی / گروھی اند / گروھی اند کہ / امتى,امۃ,2:143-2:213-3:104-3:110-3:113-4:41-5:48-5:66-6:38-6:42-6:108-7:34-7:38-7:159-7:160-7:164-7:168-7:181-10:19-10:47-10:49-11:8-11:48-11:118-12:45-13:30-15:5-16:36-16:63-16:84-16:89-16:92-16:93-16:120-21:92-22:34-22:67-23:43-23:44-23:52-27:83-28:23-28:75-29:18-35:24-35:42-40:5-41:25-42:8-43:22-43:23-43:33-45:28-46:18,54
1989,430,ط,شَرِیْعَۃ,«شَرَع» بمعنی کسی چیزکا کِھچ کر یا بلند ہو کر سامنے آجانا یا ظاہر ہوجانا کہتے ہیں ۔ «شَرَعَ الْبَعِیْرُ عُنُقَہٗ» اونٹ نے گردن اس طرح بلند کی کہ وہ نمایاں طور پر نظر آنے لگی (م ۔ ل) اور «شَرَعَ لِلْقَوْم» بمعنی قوم کے لیے قانون بنانا ۔ اور «شَرِیْعَۃ» بمعنی اسلامی قانون ۔ خدائی احکام ۔ ضابطہ (منجد) اور شریعت اسلامیہ اسلامی قوانین کے معنوں میں استعمال ہوتا ہے ۔ اور «شَرِیْعَۃ» بمعنی واضح اور متعین راستہ ۔ لیکن اس کا اطلاق صرف احکام الہیہ  پر ہوتا ہے (مف) ہمارے خیال میں امام راغب کی تعریف یا معنیٰ زیادہ صحیح ہے یعنی لفظ شریعت کے معنی اسلامی قانون نہیں بلکہ اللہ کے احکام ہیں ۔ کیونکہ رسول اکرم ﷺ نے فرمایا کہ دین تو سب انبیاء و رسل کا ایک ہی رہا ہے مگر شریعت میں زمانہ  کے لحاظ تبدیلی ہوتی رہی ہے ۔ دین کی حیثیت باپ کی ہے اور شریعت کی حیثیت ماں کی ۔ آپ ﷺ نے فرمایا :’’ ہم انبیاء کا باپ تو ایک ہی ہے مگر مائیں الگ الگ ہیں ۔ گویا دین ایسے غیر متبدل (جوتبدیل نہ ہو سکے) احکامات الہیہ پر مشتمل ہے جو ابتدائے تخلیق آدم سے ایک ہی رہے ہیں جیسے ایمان بالغیب ، اللہ پر ، اسکے فرشتوں اور اس کی کتابوں پر ایمان اور قانون جزا و سزا وغیرہ ، نماز روزہ ، زکوۃ کے احکام اور حدود تعزیرات وغیرہ اور شریعت کے احکام کی مثال یوں سمجھیے جیسے نمازوں کی تعداد ، ان کی رکعتیں اور طریقہِ ادائیگی ۔ شریعت ہر صاحب شریعت نبی یا رسول کی الگ تھی مگر دین ایک ہی رہا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«ثُمَّ جَعَلۡنٰکَ عَلٰی شَرِیۡعَۃٍ  مِّنَ الۡاَمۡرِ» ( 45/18 )\nترجمه : (ای پیامبر!) زندگی دنیا را برای آنان به آبی تشبیه کن که از آسمان فرو می‌فرستیم؛ و بوسیله آن، گیاهان زمین (سرسبز می‌شود و) در هم فرومیرود. امّا بعد از مدتی می‌خشکد؛ و بادها آن را به هر سو پراکنده می‌کند؛ و خداوند بر همه چیز تواناست\nاس آیت سے واضح ہے کہ آپ ﷺ کو الگ شریعت دی گئی تھی ۔,«شَرِیْعَۃ» ایسے قوانین الہیہ جو ضرورت اور حالات کے تحت تبدیل کیے جاتے رہے ۔,اختلاف / مشرکان / مشركان / دین / دين / عیسی / عيسى,شریعۃ,5:48-42:13-42:21-45:48,4
1990,430,ط,مِنْھَاج,«نَھَجَ الْاَمْرُ وَ الطَّرِیْق» بمعنی کام یا راستہ کا واضح ہونا ( منجد ) اور «مِنْھَاج» بمعنی واضح دستور العمل ہے ( مف ) یعنی شرعی احکام کی ادائیگی کا طریق کار ۔ اور یہ طریق کار بھی انبیاء کو اللہ ہی کی طرف سے بتلا دیا جاتا ہے جیسا کہ احادیث صحیحہ سے ثابت ہے کہ جبریلؑ رسول اللہ ﷺ کو دو دن آ کر دن کی پانچوں نمازیں پڑھاتے رہے ۔ پہلے دن اول اوقات میں اور دوسرے دن آخر اوقات میں ۔ اور بتلایا ، ان اوقات کے درمیان کسی وقت بھی نماز ہو سکتی ہے ۔ یہ منہاج ہے ۔ گویا شریعت ہی کی وسعت اور وضاحت کا نام «مِنْھَاج» ہے ( فق ل 11 )\nمثلاً در قرآن کریم آمده است :\n«لِکُلٍّ جَعَلۡنَا مِنۡکُمۡ شِرۡعَۃً وَّ مِنۡہَاجًا» ( 5/48 )\nترجمه : و این کتاب [= قرآن‌] را به حق بر تو نازل کردیم، در حالی که کتب پیشین را تصدیق می‌کند، و حافظ و نگاهبان آنهاست؛ پس بر طبق احکامی که خدا نازل کرده، در میان آنها حکم کن! از هوی و هوسهای آنان پیروی نکن! و از احکام الهی، روی مگردان! ما برای هر کدام از شما، آیین و طریقه روشنی قرار دادیم؛ و اگر خدا می‌خواست، همه شما را امت واحدی قرارمی‌داد؛ ولی خدا می‌خواهد شما را در آنچه به شما بخشیده بیازماید؛ (و استعدادهای مختلف شما را پرورش دهد). پس در نیکیها بر یکدیگر سبقت جویید! بازگشت همه شما، به سوی خداست؛ سپس از آنچه در آن اختلاف می‌کردید؛ به شما خبر خواهد داد,«مِنْھَاج» [و راھی را] «مِنْھَاج» شرعی احکام کی ادائیگی کا طریق کار ۔ وضاحت اور وسعت ۔,قانون / و راھی را / امت / امّت / اختلاف / خواست / تصدیق,منھاج,5:48,1
1991,430,ط,مَنْسَکَ,«نَسَکَ» معنی عبادت گزار بننا ۔ درویش بننا ۔ اور «نَسَکَ لِلّٰہِ» بمعنی اللہ کے لیے قربانی کرنا (منجد) «مَنْسَک» کا لفظ «مِنْھَاج» سے زیادہ خاص ہے اور اس سے مراد صرف وہ طریقہِ کار ہے جو عبادات سے تعلق رکھتا ہو ۔\nمثلاً در قرآن کریم آمده است :\n«لِکُلِّ اُمَّۃٍ جَعَلۡنَا مَنۡسَکًا ہُمۡ نَاسِکُوۡہُ» ( 22/67 )\nترجمه : برای هر امّتی عبادتی قرار دادیم، تا آن عبادت را (در پیشگاه خدا) انجام دهند؛ پس نباید در این امر با تو به نزاع برخیزند! بسوی پروردگارت دعوت کن، که بر هدایت مستقیم قرار داری (و راه راست همین است که تو می‌پویی)\n«مَنَسَک» کا لفظ بالعموم حج کے شعائر و احکام اور ادائیگی سے مختص ہو گیا ہے ۔ مناسک حج ، بمعنی اعمال حج ادا کرنے کے مقامات ، قاعدے اور طریقے ۔ اور «نُسُک» اس قربانی کو کہتے ہیں جو حج کے دوران کی جاتی ہے ۔\nمثلاً در قرآن کریم آمده است :\n«فَمَنۡ کَانَ مِنۡکُمۡ مَّرِیۡضًا اَوۡ بِہٖۤ اَذًی مِّنۡ رَّاۡسِہٖ فَفِدۡیَۃٌ مِّنۡ صِیَامٍ اَوۡ صَدَقَۃٍ اَوۡ نُسُکٍ» ( 2/196 )\nترجمه : و حج و عمره را برای خدا به اتمام برسانید! و اگر محصور شدید، (و مانعی مانند ترس از دشمن یا بیماری، اجازه نداد که پس از احرام‌بستن، وارد مکه شوید،) آنچه از قربانی فراهم شود (ذبح کنید، و از احرام خارج شوید)! و سرهای خود را نتراشید، تا قربانی به محلش برسد (و در قربانگاه ذبح شود)! و اگر کسی از شما بیمار بود، و یا ناراحتی در سر داشت، (و ناچار بود سر خود را بتراشد،) باید فدیه و کفّاره‌ای از قبیل روزه یا صدقه یا گوسفندی بدهد! و هنگامی که (از بیماری و دشمن) در امان بودید، هر کس با ختم عمره، حج را آغاز کند، آنچه از قربانی برای او میسّر است (ذبح کند)! و هر که نیافت، سه روز در ایام حج، و هفت روز هنگامی که باز می‌گردید، روزه بدارد! این، ده روز کامل است. (البته) این برای کسی است که خانواده او، نزد مسجد الحرام نباشد [= اهل مکّه و اطرافِ آن نباشد]. و از خدا بپرهیزید! و بدانید که او، سخت‌کیفر است,«مَنْسَکَ» [مناسک حج تان را] «مَنْسَک» عبادات اور بالخصوص حج کے شعائر و احکام ۔,مناسک حج تان را / آیین عبادتی را / یک راہ بندگی را / امتی / امتى / تسلیم / تسليم,منسک,2:128-2:200-22:34-22:67,4
1992,430,ط,شَاکِلَۃ,«شَکَلَ» بمعنی مشتبہ ہونا ۔ اور «شَکُلَ الدَّایَۃ» بمعنی جانور کو پائے بند ڈالنا ( پائے بند وہ رسی جس سے جانور کے اگلے اور پچھلے پاؤں باندھے جاتے ہیں ) ( منجد ) اور «اَلنَّاسُ اَشْکَالٌ وَّ اُلَّافٌ» بمعنی لوگ آپس میں مشابہ اور الفت کرنے والے ہیں (مف) گویا شکل کے معنی میں دو باتیں پائی جاتی ہیں شکل و صورت میں اشتباہ (شک و شبہہ) اور پابندی ۔ اور «شَاکِلَۃ» وہ مخصوص انداز یا طور طریقہ  ہے جو انسان اپنی طبیعت کے رجحان یا جھکاؤ کی بناء پر اختیار کرتا ہے ۔ جیسا کہ حضور ﷺ نے فرمایا : «کُلٌّ مُّیَسَّرٌ لِّمَا خُلِقَ لَہٗ» یعنی ہر ایک کو جس کے لیے اسے پیدا کیا گیا ہے آسان کر دیا جاتا ہے ۔ اس کی مثال یوں سمجھئے کہ ایک شخص کھلے عام صدقہ و خیرات اس بناء پر پسند کرتا ہے کہ دوسروں کو بھی ایسا کرنے کی رغبت ہو اور نمائش مقصود نہ ہو مگر دوسرا شخص صدقہ و خیرات دینا اسطرح پسند کرتا ہے کہ کسی کو کانوں کان خبر تک نہ ہو ۔ اب یہ دونوں طریقے جائز اور درست ہیں ۔ عمل بھی ملتا جلتا ہے بلکہ ایک ہی ہے لیکن طریقہِ ادائیگی دونوں کا الگ الگ ہے جو ان کی اپنی اپنی پسند اور صوابدید (مصلحت) کے مطابق ہے ۔ یہ «شَاکِلَۃ» ہے ۔\nمثلاً در قرآن کریم آمده است :\n«قُلۡ کُلٌّ یَّعۡمَلُ عَلٰی شَاکِلَتِہٖ» ( 17/84 )\nترجمه : بگو: «هر کس طبق روش (و خلق و خوی) خود عمل می‌کند؛ و پروردگارتان کسانی را که راهشان نیکوتر است، بهتر می‌شناسد.»,«شَاکِلَۃ» کسی کے انفرادی رجحان کے سبب اس کا طرز عمل ۔,داناتر / تر / عمل / روش,شاکلۃ,17:84,1
1993,430,ط,مَعْرُوْف,«مَعْرُوْف»  بمعنی بھلائی نیکی اور اسکی ضد «مُنْکَر» ہے بمعنی ہر وہ بات جو شریعت کی رو سے ناپسند یدہ یا حرام ہو ، برائی ، بری بات ، برا کام ۔ «عُرْف» بمعنی پہچاننا ۔ اور معروف ہر وہ طریقہ ملکی دستور یا رسم و رواج ہے جو معاشرہ میں جانا پہچانا ہو اور اسے اچھا سمجھا جاتا ہو اور شریعت میں اس کے متعلق خواہ کوئی رہنمائی ملے یا نہ ملے ، جیسے اپنے سے بڑوں کے سامنے ادب سے بیٹھنا اور انہیں جی یا آپ کہہ کر پکارنا ، ان باتوں کا شریعت میں حکم نہیں ، تاہم اچھی باتیں ہیں ۔ یہ معروف ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ لِلۡمُطَلَّقٰتِ مَتَاعٌۢ بِالۡمَعۡرُوۡفِ» ( 2/241 )\nترجمه : و برای زنان مطلقه، هدیه مناسبی لازم است (که از طرف شوهر، پرداخت گردد). این، حقی است بر مردان پرهیزکار,«مَعْرُوْف» [بہ شایستگی برولی دم است] «مَعْرُوْف» بمعنی بھلائی نیکی ، ایسا رسم  و رواج جو معاشرہ در پسندیدہ ہو اور اس پر شرعًا کوئی پابندی نہ ہو ۔,بہ شایستگی برولی دم است / بہ شایستگی =عدالت / بہ طور شایستہ / نگھداشتن بہ شایستگی / بہ شایستگی / شایستہ را / پسندیده,معروف,2:178-2:180-2:228-2:229-2:231-2:232-2:233-2:234-2:235-2:236-2:240-2:241-2:263-3:104-3:110-3:114-4:5-4:6-4:8-4:19-4:25-4:114-7:157-9:67-9:71-9:112-22:41-24:53-31:15-31:17-33:6-33:32-47:21-60:12-65:2-65:6,36
1994,430,ط,خُلُق,«خَلْق ، خِلْقَت» یعنی اس شکل و صورت پر بولا جاتا ہے جس کی پہچان اور فہم آنکھ  سے دیکھ  سے ہوتا ہے اور «خُلْق» کا تعلق قوائے باطنہ (یعنی دماغی اور روحانی قوتیں جو بطاہر محسوس نہیں ہوتیں ، باطن کی قوتیں ، ذہنی صلاحتیں.) اور عادات و خصائل کے معنی میں ہوتا ہے جن کا تعلق بصیرت (عقل ، فہم ، شعور) سے ہے  (مف) «خُلْق» اور «خُلُق» بمعنی طبیعت ، خصلت ، فطرت (منجد) یا وہ عادت و طریقہ جو طبیعت کے ساتھ رچ بس گیا ہو ۔ اور اسکی جمع  «اَخْلَاق» ہے ۔\nمثلاً در قرآن کریم آمده است :\n«اِنۡ  ہٰذَاۤ   اِلَّا  خُلُقُ  الۡاَوَّلِیۡنَ» ( 26/137 )\nترجمه : این همان روش (و افسانه‌های) پیشینیان است,«خُلُق» [خوی و روش] «خُلُق» ایسی عادات یا طور طریقے جو کسی کی طبیعت در رچ بس چکے ہوں ۔,خوی و روش / خویی / پیشینیان / پيشينيان / اخلاق / اخلاقِ / شیوه,خلق,26:137-68:4,2
1995,431,ط,طَعَنَ,«طَعَنَ» بمعنی نیزہ ۔ سینگ یا کسی دوسری تیز اور نوکیلی چیز کے ساتھ زخم کرنا (مف) پھر اس لفظ کا استعمال کسی شخص کے متعلق یا اس کے منہ پر ایسی بات کہنا جو اسے نیزہ کی طرح چبھ جائے ہونے لگا ، یعنی کسی کا کوئی عیب اس طرح بیان کرنا جو اسے سخت ناگوار ہو (مف)\nمثلاً در قرآن کریم آمده است :\n«وَ  اِنۡ نَّکَثُوۡۤا اَیۡمَانَہُمۡ  مِّنۡۢ بَعۡدِ عَہۡدِہِمۡ وَ طَعَنُوۡا فِیۡ دِیۡنِکُمۡ  فَقَاتِلُوۡۤا اَئِمَّۃَ الۡکُفۡرِ» ( 9/12 )\nترجمه : یوسف را بکشید؛ یا او را به سرزمین دوردستی بیفکنید؛ تا توجه پدر، فقط به شما باشد؛ و بعد از آن، (از گناه خود توبه می‌کنید؛ و) افراد صالحی خواهید بود,«طَعَنَ» [وطعنہ] «طَعَنَ» کسی شخص کا کوئی عیب یا کمزوری اس طرح بیان کرنا جو اسے نوک کی طرح چبھ جائے ۔,وطعنہ / و فرمان بر دیم / و طعنہ زنند / طعنه / بشنو / شنیدیم / شنيديم,طعن,4:46-9:12,2
1996,431,ط,لَمَزَ,«لَمَزَ» بمعنی عیب جوئی یا عیب چینی کرنا ۔ کسی کے عیوب تلاش کرتے رہنا اور اس مقصد کے لیے اس کی غیبت کرنا (مف) تاکہ کسی کا کوئی کمزور پہلو ہاتھ آ جائے ۔ پھر اس پر  نکتہ چینی یا طعنہ زنی کرنا ۔ اور بمعنی کسی کے فعل پر بے انصافی کا الزام لگانا ( فق 39 )\nمثلاً در قرآن کریم آمده است :\n«اَلَّذِیۡنَ یَلۡمِزُوۡنَ الۡمُطَّوِّعِیۡنَ مِنَ الۡمُؤۡمِنِیۡنَ فِی الصَّدَقٰتِ» ( 9/79 )\nترجمه : و چشمهای آنان از شدّت ترس فروافتاده است,«لَمَزَ» [عیب می گیرند بر تو] «لَمَزَ» بدنام کرنا ، الزام دینا ، تہمت لگانا ، رسوا کرنا ، طعنہ دینا ان تمام معنوں در به کار می‌رود.,عیب می گیرند بر تو / عیب جویی می کنند / عیب جو / عیب / عيب / صدقات / مسخره,لمز,9:58-9:79-49:11-104:1,4
1997,431,ط,ھَمَزَ,«ھَمَزَ» بمعنی چٹکی لینا ، چبھونا ، غیبت کرنا ۔ اور «ھَامَز» بمعنی بڑا عیب گیر اور «ھَمَّاز» بمعنی  نقص نکالنے اور طعن و تشنیع ( لعنت ملامت) کرنے والا (منجد) اور «ھَمَزَاتِ الشَّیٰطِیْن» بمعنی شیطان کی چھیڑ چھاڑ اور وساوس (منجد) اور «ھَامِز» بمعنی غیبت میں آنکھوں اور ہاتھوں کے اشارے سے برائی کرنے والا (مف) اور «ھَمَزَ» بمعنی آنکھ سے اشارہ کیا ۔ کاٹا ۔ مارا اور غیبت کی ۔ اور «ھَمَزَ الْفَرَس» بمعنی گھوڑے کو ایڑ لگائی (م ۔ ق)\nمثلاً در قرآن کریم آمده است :\n«ہَمَّازٍ مَّشَّآءٍۭ  بِنَمِیۡمٍ» ( 68/11 )\nترجمه : کسی که بسیار عیبجوست و به سخن چینی آمد و شد می‌کند،,«ھَمَزَ» [بسیار عیب جویِ] «ھَمَزَ» اشارہ کنایہ در طعنہ زنی کرنا ۔,بسیار عیب جویِ / طعنہ زنندۂ / چینی / چينى / وای / واى / عیب,ھمز,68:11-104:1,2
1998,432,ط,طَوَّقَ,«طَوَّقَ» طوق ہر اس چیز کو کہتے ہیں جو گولائی کی شکل اختیار کیے ہو (م ۔ ل) اور طوق بمعنی گلے کا زیور ۔ ہر احاطہ کرنے والی چیز ۔ اور اسکی جمع «اَطْوَاق» ہے ۔ (منجد) گویا طوق گلے کا ہار ، گلے کا زیور ، گلے کا پھندا ۔ لوہے کا کڑا جو گردن میں ڈالا جائے ، سب کے لیے استعمال ہو سکتا ہے اور «اِطَّوَّقَ الْحَیَّۃ» بمعنی سانپ کا کنڈلی مارنا ۔ اور «طَوَّقَ» بمعنی کسی کو طوق پہنانا (منجد)\nمثلاً در قرآن کریم آمده است :\n«سَیُطَوَّقُوۡنَ مَا بَخِلُوۡا بِہٖ یَوۡمَ الۡقِیٰمَۃِ» ( 3/180 )\nترجمه : کسانی که بخل می‌ورزند، و آنچه را خدا از فضل خویش به آنان داده، انفاق نمی‌کنند، گمان نکنند این کار به سود آنها است؛ بلکه برای آنها شر است؛ بزودی در روز قیامت، آنچه را نسبت به آن بخل ورزیدند، همانند طوقی به گردنشان می‌افکنند. و میراث آسمانها و زمین، از آن خداست؛ و خداوند، از آنچه انجام می‌دهید، آگاه است,«طَوَّقَ» [بہ زودی چون طوقی بہ گردنشان افکندہ می شود] «طَوَّقَ» گلے کا ہار، گلے کا زیور، گلے کا پھندا ، لوہے کا کڑا جو گردن در ڈالا جائے ، سب کے لیے استعمال ہو سکتا ہے۔,بخل در روز قیامت قلاده (عذاب) است / بہ زودی چون طوقی بہ گردنشان افکندہ می شود / بخل / میراث / ميراث / طوق / گردنشان,طوق,3:180,1
1999,432,ط,غُلّ,«غُلّ» اسکی جمع «اَغْلَال» ہے ۔ یہ لفظ طوق سے زیادہ عام ہے ۔ «غُلّ» ہر اس چیز کو کہا جاتا ہے جس سے کسی کے اعضاء کو جکڑ کر اس کے درمیان میں باندھ دیا جاتا ہے (مف) اور اس کا اطلاق ہتھکڑی ، بیڑیاں اور طوق سب پر ہوتا ہے ۔ «غَلَّ» بمعنی ہتھکڑی یا طوق ڈالنا  ہے (منجد) ۔\nمثلاً در قرآن کریم آمده است :\n«خُذُوۡہُ  فَغُلُّوۡہُ ثُمَّ  الۡجَحِیۡمَ  صَلُّوۡہُ» ( 69/30،31 )\nترجمه : ( حکم ہو گا ) اسے پکڑ لو اور طوق پہنا دو ۔ پھر دوزخ کی آگ میں جھونک دو ۔,«غُلّ» بمعنی ہتھکڑی یا طوق ڈالنا ۔,زنجیرها / زنجيرها / غل / غُل / گردن / غلها / غُلها,غل,5:64-7:157-12:23-13:5-17:29-34:33-36:8-40:71-76:4,9
2000,433,ط,طَمَعَ,«طَمَعَ» دل میں کسی چیز کے لیے قوی امید پیدا ہونے کو کہتے ہیں (م ۔ ل) قوی امید رکھنا ۔\nمثلاً در قرآن کریم آمده است :\n«وَّ مَہَّدۡتُّ لَہٗ  تَمۡہِیۡدًا ثُمَّ  یَطۡمَعُ اَنۡ اَزِیۡدَ» ( 74/14،15 )\nترجمه : اور میں نے ہر طرح سے اس کے سامان میں وسعت دی ۔ ابھی وہ طمع رکھتا ہے کہ اور زیادہ دوں ۔,«طَمَعَ» [آیا پس امید دارید شما مسلمانان] «طَمَعَ» کسی بات کی دل در قوی امید رکھنا ۔,آیا پس امید دارید شما مسلمانان / و حال آنکہ امید داریم / امید می دارند / و امید / امید داریم / امید دارم / امید,طمع,2:75-5:84-7:46-7:56-13:12-26:51-26:82-30:24-32:16-33:32-70:38-74:15,12
2001,433,ط,حِرْص,«حِرْص» کسی چیز کے لیے لالچ ، یا رغبت جب بڑھ جائے تو اسے «حِرْص» کہتے ہیں (م ۔ ل) خواہ وہ اپنے فائدے کے لیے ہو یا دوسرے کے فائدہ کے لیے ۔ (مف) لالچ۔ مثلاً در قرآن کریم آمده است :\n«اِنۡ تَحۡرِصۡ عَلٰی ہُدٰىہُمۡ فَاِنَّ اللّٰہَ  لَا یَہۡدِیۡ مَنۡ یُّضِلُّ» ( 16/37 )\nترجمه : هر قدر بر هدایت آنها حریص باشی، (سودی ندارد؛ چرا) که خداوند کسی را که گمراه ساخت، هدایت نمی‌کند؛ و آنها یاورانی نخواهند داشت,«حِرْص» [آز مند ترین] «حِرْص» کسی چیز کے لیے طمع یا رغبت جب بڑھ جائے تو اسے «حِرْص» کہتے ہیں ۔,آز مند ترین / آزمند باشید بہ آن / آزمند است / حرص بورزی / حرص ورزی / حریص / حريص,حرص,2:96-4:129-9:128-12:103-16:37,5
2002,433,ط,شُحّ,«شُحَّ» بمعنی بخل کرنا حرص و لالچ کرنا ۔ اور «اَلشِّیْح» اور «اَلشِّحَاح» بمعنی بخیل ۔ حریص (منجد) گویا «شَحَّ» میں دو باتیں بیک وقت پائی جاتی ہیں (1) مال کے حصول کی حرص (2) اسے خرچ کرنے میں بخل ، کنجوسی  اور یہ بدترین صفت ہے (مف)\nمثلاً در قرآن کریم آمده است :\n«فَاِذَا  ذَہَبَ الۡخَوۡفُ سَلَقُوۡکُمۡ بِاَلۡسِنَۃٍ حِدَادٍ  اَشِحَّۃً عَلَی الۡخَیۡرِ» ( 33/19 )\nترجمه : آنها در همه چیز نسبت به شما بخیلند؛ و هنگامی که (لحظات) ترس (و بحرانی) پیش آید، می‌بینی آنچنان به تو نگاه می‌کنند، و چشمهایشان در حدقه می‌چرخد، که گویی می‌خواهند قالب تهی کنند! امّا وقتی حالت خوف و ترس فرو نشست، زبانهای تند و خشن خود را با انبوهی از خشم و عصبانیت بر شما می‌گشایند (و سهم خود را از غنایم مطالبه می‌کنند!) در حالی که در آن نیز حریص و بخیلند؛ آنها (هرگز) ایمان نیاورده‌اند، از این رو خداوند اعمالشان را حبط و نابود کرد؛ و این کار بر خدا آسان است\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«وَ مَنۡ یُّوۡقَ شُحَّ نَفۡسِہٖ  فَاُولٰٓئِکَ ہُمُ  الۡمُفۡلِحُوۡنَ» ( 59/9 )\nترجمه : (در حالی که) اگر به آنچه خدا و پیامبرش به آنان داده راضی باشند، و بگویند: «خداوند برای ما کافی است! و بزودی خدا و رسولش، از فضل خود به ما می‌بخشند؛ ما تنها رضای او را می‌طلبیم.» (برای آنها بهتر است),«شُحَّ» جب مال کے حصول کی حرص کے ساتھ بخل کا اضافہ بھی ہوجائے ۔,بخل / بُخل / حرص / حرصِ / نفس / نفسِ / تند,شح,4:128-33:19-59:9-64:16,4
2003,434,ر,عَبَرَ,«عَبَرَ» کا بنیادی معنیٰ پانی سے گزر جانا ہے  خواہ تیر کر گزرا جائے یا کسی سواری یا پل کے ذریعہ اور «عَبْرُ النَّھْر» نہر کے اُس کنارہ کو کہتے ہیں جہاں سے اتر کر نہر کو عبور کیا جا سکے ۔ اور «عَبَرَ الْعَیْن» بمعنی آنسوؤں کا جاری ہونا ۔ اور «اَلْعَبَرَات» ( جمع ہے ) بمعنی آنسو (مف) پھر اس کا استعمال ہر طرح کے راستے کو طے کرنے پر بھی ہونے لگا خواہ راستہ میں پانی ہو یا نہ ہو ۔\nمثلاً در قرآن کریم آمده است :\n«وَ لَا جُنُبًا اِلَّا عَابِرِیۡ سَبِیۡلٍ حَتّٰی تَغۡتَسِلُوۡا» ( 4/43 )\nترجمه : ای کسانی که ایمان آورده‌اید! در حال مستی به نماز نزدیک نشوید، تا بدانید چه می‌گویید! و همچنین هنگامی که جنب هستید -مگر اینکه مسافر باشید- تا غسل کنید. و اگر بیمارید، یا مسافر، و یا «قضای حاجت» کرده‌اید، و یا با زنان آمیزش جنسی داشته‌اید، و در این حال، آب (برای وضو یا غسل) نیافتید، با خاک پاکی تیمّم کنید! (به این طریق که) صورتها و دستهایتان را با آن مسح نمایید. خداوند، بخشنده و آمرزنده است,«عَبَرَ» [عبور کنندگان] «عَبَرَ» کا لفظ صرف راستہ بالخصوص پانی طے یا عبور کرنے کے لیے به کار می‌رود\n اور «قَطَعَ» کا لفظ عام  ہے جو معاملات طے کرنے اور قطعات ارضی (زمین، زرعی زمین، کھیت وغیرہ) کو پار کر جانے کے لیے آتا ہے ۔,حکم دوم در مورد حرام بودن مشروبات الکلی / عبور کنندگان / غسل / تیمّم / تیمم / مسح / مستی,عبر,4:43,1
2004,434,ر,قَطَعَ,«قَطَعَ» کا بنیادی معنیٰ کاٹنا اور الگ کرنا ہے ۔ اور «قَطَعَ النَّھْر» بمعنی نہر کو عبور کرنا ۔ «قَطَعَ السَّبِیْل» بمعنی راہزنی (یعنی مسافروں کو لوٹنے والا) ۔ اور «قَطَعَ الْوَادِی» بمعنی کسی میدان کو طے کر جانا ۔ اور «قَطَعَ الْاَمْر» بمعنی کسی کام کو سرانجام دینے کے لیے پروگرام طے کرنا ۔ گویا یہ لفظ راستہ طے کرنا کے معنوں میں بھی «عَبَرَ» سے زیادہ عام  ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَّ لَا یَقۡطَعُوۡنَ وَادِیًا اِلَّا کُتِبَ لَہُمۡ» ( 9/121 )\nترجمه : و هیچ مال کوچک یا بزرگی را (در این راه) انفاق نمی‌کنند، و هیچ سرزمینی را (بسوی میدان جهاد و یا در بازگشت) نمی‌پیمایند، مگر اینکه برای آنها نوشته می‌شود؛ تا خداوند آن را بعنوان بهترین اعمالشان، پاداش دهد\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«مَا کُنۡتُ قَاطِعَۃً  اَمۡرًا حَتّٰی تَشۡہَدُوۡنِ» ( 27/32 )\nترجمه : (سپس) گفت: «ای اشراف (و ای بزرگان)! نظر خود را در این امر مهمّ به من بازگو کنید، که من هیچ کار مهمّی را بدون حضور (و مشورت) شما انجام نداده‌ام,«قَطَعَ» [ومی گسلند] «قَطَعَ» کا بنیادی معنیٰ کاٹنا اور الگ کرنا ہے ۔ ,ومی گسلند / تا نابود کند / پس ببرید / پس بریدہ شد / و بریدیم / وببرد =براندازد / قطع,قطع,2:27-3:127-5:38-6:45-7:72-8:7-9:121-13:25-22:15-29:29-59:5-69:46,12
2005,435,ظ,ظَھَرَ,«ظَھْر» بمعنی پیٹھ اور ہر چیز کا ظاہری حصہ جس کوآنکھوں سے دیکھ سکے اور اس کی ضد «بَطَن» بمعنی پیٹ یا ہر چیز کا اندرونی حصہ ہے جسے آنکھوں سے نہ دیکھ سکے (مف) اور «ظَھَرَ» بمعنی کسی چیز کا دکھائی دینا ، رونما ہونا ، سامنے آنا اور غالب ہونا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«ظَہَرَ الۡفَسَادُ فِی الۡبَرِّ وَ الۡبَحۡرِ بِمَا کَسَبَتۡ اَیۡدِی  النَّاسِ» ( 30/41 )\nترجمه : فساد، در خشکی و دریا بخاطر کارهایی که مردم انجام داده‌اند آشکار شده است؛ خدا می‌خواهد نتیجه بعضی از اعمالشان را به آنان بچشاند، شاید (بسوی حق) بازگردند\nپھر اس لفظ کا استعمال معنوی طور پر بھی ہوتا ہے ۔\nمثلاً : ارشاد باری تعالیٰ ہے :\n«قُلۡ  اِنَّمَا حَرَّمَ رَبِّیَ الۡفَوَاحِشَ مَا ظَہَرَ  مِنۡہَا وَ  مَا بَطَنَ» ( 7/33 )\nترجمه : (به خاطر آور) هنگامی را که از پیامبران پیمان گرفتیم، و (همچنین) از تو و از نوح و ابراهیم و موسی و عیسی بن مریم، و ما از همه آنان پیمان محکمی گرفتیم (که در ادای مسؤولیت تبلیغ و رسالت کوتاهی نکنند),«ظَھَرَ» [در حالی کہ پشتیبانی می کنیدیکدیگررا] «ظَھَرَ» اس طرح ظاہر ہونا کہ آنکھوں سے دیکھ  سکے ۔ یہ لفظ عام ہے ۔,در حالی کہ پشتیبانی می کنیدیکدیگررا / گناہ آشکار / آشکار باشد / دست یابند / تا غالب سازد آن را / و آشکار گشت / پیروز,ظھر,2:85-6:120-6:151-7:33-9:8-9:33-9:48-13:33-18:20-18:22-18:97-24:31-30:7-30:18-30:41-31:20-34:18-40:26-40:29-43:33-48:28-57:3-57:13-61:9-61:14-66:3-72:26,27
2006,435,ظ,جَھَرَ,«جَھَرَ» کوئی کام اس طرح کرنا کہ دوسروں کو اس کا علم ہو جائے ۔ اسکی  ضد «اَسرَّ» بمعنی چھپانا ہے ۔ (مف)\nمثلاً در قرآن کریم آمده است :\n«وَ اِذۡ قُلۡتُمۡ یٰمُوۡسٰی لَنۡ نُّؤۡمِنَ لَکَ حَتّٰی نَرَی اللّٰہَ جَہۡرَۃً» ( 2/55 )\nترجمه : قرآن را تعلیم فرمود،\nلیکن یہ لفظ بالعموم آواز کو ظاہر کرنے اور اعلان کرنے  کے لیے استعمال ہوتا ہے (م ۔ ل) ۔ جہری نماز وہ ہے جس میں امام قراءت بلند آواز سے پڑھتا ہے یعنی فجر ، مغرب اور عشاء کی نمازیں ۔ اور سری وہ ہے جس میں امام بھی قراءت اس طرح پست آواز سے کرتا ہے جسے دوسرے نہ سن سکیں ۔«جَھَرَ» کوئی بات اس طرح کہنا کہ دوسرے سن لیں (م ۔ ق)\nمثلاً در قرآن کریم آمده است :\n«لَا یُحِبُّ اللّٰہُ  الۡجَہۡرَ  بِالسُّوۡٓءِ مِنَ الۡقَوۡلِ اِلَّا مَنۡ ظُلِمَ» ( 4/148 )\nترجمه : خداوند دوست ندارد کسی با سخنان خود، بدیها (ی دیگران) را اظهار کند؛ مگر آن کس که مورد ستم واقع شده باشد. خداوند، شنوا و داناست,«جَھَرَ» [آشکارا] «جَھَرَ» کوئی بات اس طرح اعلانیہ کہنا ، یا کوئی کام اس طرح کرنا کہ دوسروں کو اس کا علم ہو جائے ۔,آشکارا / بانگ برداشتن / و آشکار شما را / آوای بلند / بہ آواز بلند گوید / و آشکارا / آشكارا,جھر,2:55-4:148-4:153-6:3-6:47-7:205-13:10-16:75-17:110-20:7-21:110-49:2-67:13-87:7,14
2007,435,ظ,بَدَا,«بَدَا» بمعنی کسی چیز کا نمایاں طور پر ظاہر ہو جانا اور اس میں کسی کے قصد اور ارادہ کو دخل نہیں ہوتا ۔ فق ل ۔ 237 )\nمثلاً در قرآن کریم آمده است :\n«بَلۡ بَدَا لَہُمۡ مَّا کَانُوۡا یُخۡفُوۡنَ مِنۡ  قَبۡلُ» ( 6/28 )\nترجمه : (آنها در واقع پشیمان نیستند،) بلکه اعمال و نیّاتی را که قبلاً پنهان می‌کردند، در برابر آنها آشکار شده (و به وحشت افتاده‌اند). و اگر بازگردند، به همان اعمالی که از آن نهی شده بودند بازمی‌گردند؛ آنها دروغگویانند\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«بَدَتۡ لَہُمَا سَوۡاٰتُہُمَا وَ طَفِقَا یَخۡصِفٰنِ عَلَیۡہِمَا مِنۡ وَّرَقِ الۡجَنَّۃِ» ( 7/22 )\nترجمه : و اینکه رستاخیز آمدنی است، و شکّی در آن نیست؛ و خداوند تمام کسانی را که در قبرها هستند زنده می‌کند\nپھر اس لفظ کا استعمال معنوی طور پر بھی ہوتا ہے ۔\nمثلاً : ارشاد باری تعالیٰ ہے :\n«ثُمَّ بَدَا لَہُمۡ مِّنۡۢ بَعۡدِ مَا رَاَوُا الۡاٰیٰتِ لَیَسۡجُنُنَّہٗ حَتّٰی حِیۡنٍ» ( 12/35 )\nترجمه : دو دریا یکسان نیستند: این یکی دریایی است که آبش گوارا و شیرین و نوشیدنش خوشگوار است، و آن یکی شور و تلخ و گلوگیر؛ (امّا) از هر دو گوشتی تازه می خورید و وسایل زینتی استخراج کرده می‌پوشید؛ و کشتیها را در آن می‌بینی که آنها را می‌شکافند (و به سوی مقصد پیش می‌روند) تا از فضل خداوند بهره‌گیرید، و شاید شکر (نعمتهای او را) بجا آورید,«بَدَا» [آشکار شد] «بَدَا» بغیر ارادہ کسی بات کا ظاہر ہوجانا جسے چھپانے کی کوشش کی جائے ۔,آشکار شد / و ظاھر شود / و آشکار شود / و آشکار شد / ھمیشگی / آشکار / آشكار,بدا,3:118-6:28-7:22-12:35-20:121-39:47-39:48-45:33-60:4,9
2008,435,ظ,عَثَرَ,«عَثَرَ» بمعنی پھسل جانا اور گر پڑنا ہے (مف) اور «عَثَرَ» کا استعمال ظاہر ہونے کے معنی میں اس وقت ہو گا ۔ جب کوئی شخص جھوٹ بول کر کوئی بات چھپانے کی کوشش کر رہا ہو لیکن غلطی سے کوئی سچی بات ازخود اس کے منہ سے نکل جائے جس سے حقیقت ظاہر ہو جائے ۔\nمثلاً در قرآن کریم آمده است :\n«فَاِنۡ عُثِرَ عَلٰۤی اَنَّہُمَا اسۡتَحَقَّاۤ اِثۡمًا» ( 5/107 )\nترجمه : و اگر اطلاعی حاصل شود که آن دو، مرتکب گناهی شده‌اند (و حق را کتمان کرده‌اند)، دو نفر از کسانی که نسبت به میت، اولی هستند، به جای آنها قرار می‌گیرند، و به خدا سوگند یاد می‌کنند که: «گواهی ما، از گواهی آن دو، به حق نزدیکتر است! و ما تجاوزی نکرده‌ایم؛ که اگر چنین کرده باشیم، از ظالمان خواهیم بود!»,«عَثَرَ» [پی بردہ شود] «عَثَرَ» باتوں باتوں در اصل حقیقت کا ظاہر ہو جانا ۔,پی بردہ شود / آگاہ کردیم / بدانند / درست / تجاوز / تر,عثر,5:107-18:21,2
2009,435,ظ,تَبَیَّنَ ، اِسْتِبَانَ,«بَانَ» بمعنی کسی چیز کا دوسری سے الگ ہو کر ظاہر ہونا اور واضح ہونا (م ۔ ل) گویا اس کے معنیٰ میں تین باتوں کا تصور پایا جاتا ہے (1) افتراق (یعنی جدائی) (2) بُعْد (یعنی دوری) (3) وُضُوح (یعنی روشن، ظاہر اور واضح) (م ل) اور «تَبَیَّن» بھی انہی معنوں میں استعمال ہو گا ۔\nمثلاً در قرآن کریم آمده است :\n«قَدۡ تَّبَیَّنَ الرُّشۡدُ مِنَ الۡغَیِّ» ( 2/256 )\nترجمه : در قبول دین، اکراهی نیست. (زیرا) راه درست از راه انحرافی، روشن شده است. بنابر این، کسی که به طاغوت [= بت و شیطان، و هر موجود طغیانگر] کافر شود و به خدا ایمان آورد، به دستگیره محکمی چنگ زده است، که گسستن برای آن نیست. و خداوند، شنوا و داناست\nایک دوسرے مقام پر ارشاد باری تعالیٰ ہے :\n«وَ لِتَسۡتَبِیۡنَ سَبِیۡلُ  الۡمُجۡرِمِیۡنَ» ( 6/55 )\nترجمه : و این چنین آیات را برمیشمریم، (تا حقیقت بر شما روشن شود،) و راه گناهکاران آشکار گردد,«تَبَیَّنَ» بمعنی کسی چیز کا دوسری سے الگ ہو کر ظاہر ہونا اور واضح ہونا ۔\n«اِسْتِبَانَ» ایسا بیان ہے جس سے معانی ظاہر ہوجائیں۔,روشن / آشکار / آشكار / بیان / بيان / برایشان / برايشان,تبین ، استبان,2:109-2:187-2:256-2:259-3:187-4:115-6:55-8:6-9:43-9:113-9:114-14:45-16:44-16:64-29:38-34:14-37:117-41:53-47:25-47:32,20
2010,435,ظ,حَصْحَص,«حَصْحَص» جب کوئی بات کسی دباؤ کی وجہ سے پردہ  میں رہے اور دباؤ اٹھ جانے کے بعد وہ ظاہر ہو جائے (مف) تو «حَصْحَص» کا لفظ استعمال ہو گا ۔\nمثلاً در قرآن کریم آمده است :\n«قَالَتِ امۡرَاَتُ الۡعَزِیۡزِ الۡئٰنَ حَصۡحَصَ الۡحَقُّ ۫ اَنَا رَاوَدۡتُّہٗ عَنۡ  نَّفۡسِہٖ» ( 12/51 )\nترجمه : و پیوسته سؤال می‌کنند: «روز جزا چه موقع است؟!»,«حَصْحَص» [آشکار شد] «حَصْحَص» ایسی بات جو کسی دباؤ کی وجہ سے چھپی رہے اور دباؤ اٹھ جانے کے بعد وہ ظاہر ہو جائے ۔,آشکار شد / عزیز / عزيز / راستگویان / راستگويان / بودم / یوسف,حصحص,12:51,1
2011,435,ظ,تَجَّلّٰی,«تَجَّلّٰٰی» کسی روشن اور خوبصورت چیز کا اچھی طرح ظاہر ہونا ( تفصیل ’’ روشن ہونا ‘‘ میں دیکھیے )\nمثلاً در قرآن کریم آمده است :\n«فَلَمَّا تَجَلّٰی رَبُّہٗ  لِلۡجَبَلِ جَعَلَہٗ  دَکًّا» ( 7/143 )\nترجمه : و هنگامی که موسی به میعادگاه ما آمد، و پروردگارش با او سخن گفت، عرض کرد: «پروردگارا! خودت را به من نشان ده، تا تو را ببینم!» گفت: «هرگز مرا نخواهی دید! ولی به کوه بنگر، اگر در جای خود ثابت ماند، مرا خواهی دید!» اما هنگامی که پروردگارش بر کوه جلوه کرد، آن را همسان خاک قرار داد؛ و موسی مدهوش به زمین افتاد. چون به هوش آمد، عرض کرد: «خداوندا! منزهی تو (از اینکه با چشم تو را ببینم)! من به سوی تو بازگشتم! و من نخستین مؤمنانم!»,«تَجَّلّٰی» [تجلی کرد] «تَجَّلّٰٰی» کسی روشن اور خوبصورت چیز کا ظاہر ہونا ۔,تجلی کرد / جلوہ کند / گفت، / وقت / تجلی / تجلى / جلوه,تجلی,7:143-7:187-91:3-92:2,4
2012,435,ظ,شُرَّعًا,«شَرَعَ» بمعنی کسی چیز کا کِھچ کر یا بلند ہو کر سامنے آنا یا ظاہر ہونا ۔ کہتے ہیں «شَرَعَ الْبَعِیْرُ عُنُقَہٗ» یعنی اونٹ نے اس طرح گردن بلند کی کہ وہ نمایاں طور پر نظر آنے لگی ۔ (م ل)\nمثلاً در قرآن کریم آمده است :\n«اِذۡ تَاۡتِیۡہِمۡ حِیۡتَانُہُمۡ یَوۡمَ سَبۡتِہِمۡ شُرَّعًا» ( 7/163 )\nترجمه : و از آنها درباره (سرگذشت) شهری که در ساحل دریا بود بپرس! زمانی که آنها در روزهای شنبه، تجاوز (و نافرمانی) خدا می‌کردند؛ همان هنگام که ماهیانشان، روز شنبه (که روز تعطیل و استراحت و عبادت بود، بر سطح آب،) آشکار می‌شدند؛ امّا در غیر روز شنبه، به سراغ آنها نمی‌آمدند؛ این چنین آنها را به چیزی آزمایش کردیم که نافرمانی می‌کردند,«شُرَّعًا» [آشکارا بر آب] «شُرَّعًا» کسی چیز کا کِھچ کر یا بلند ہو کر ظاہر ہونا ۔,آشکارا بر آب / شنبه / تجاوز / دریا / دريا / نافرمانی / نافرمانى,شرعًا,7:163,1
2013,435,ظ,اَظْھَرَ,«اَظْھَرَ» بمعنی ظاہر کرنا ۔ خوب ظاہر، نہایت اور بہت زیادہ واضح ۔\nمثلاً در قرآن کریم آمده است :\n«عٰلِمُ الۡغَیۡبِ فَلَا یُظۡہِرُ عَلٰی غَیۡبِہٖۤ اَحَدًا» ( 72/26 )\nترجمه : گفت: «آیا هنگامی که آنها را می‌خوانید صدای شما را می‌شنوند؟,«اَظْھَرَ» [آگاہ ساخت او پیامبر را] «اَظْھَرَ» بمعنی ظاہر کرنا ۔,آگاہ ساخت او پیامبر را / دانای / داناى / راز / همسرانش / غیب / غيب,اظھر,66:3-72:26,2
2014,435,ظ,اَبْدَا,«اَبْدَا» بمعنی ظاہر کرنا ۔\nمثلاً در قرآن کریم آمده است :\n«وَ اَعۡلَمُ مَا تُبۡدُوۡنَ وَ مَا کُنۡتُمۡ تَکۡتُمُوۡنَ» ( 2/33 )8\nترجمه : فرمود: «ای آدم! آنان را از اسامی (و اسرار) این موجودات آگاه کن.» هنگامی که آنان را آگاه کرد، خداوند فرمود: «آیا به شما نگفتم که من، غیب آسمانها و زمین را میدانم؟! و نیز میدانم آنچه را شما آشکار میکنید، و آنچه را پنهان میداشتید!»,«اَبْدَا» بمعنی ظاہر کرنا ۔,پنهان / پِنهان / آشکار / آشكار / دارید / داريد / دارید،,ابدا,2:33-2:271-2:284-3:29-3:154-4:149-5:99-5:101-6:91-7:20-12:77-24:29-24:31-28:10-33:37-33:54,16
2015,435,ظ,اَعْثَرَ,«اَعْثَرَ» بمعنی ظاہر کردینا ، واقف کردینا ، آگاہ کردینا ۔\nمثلاً در قرآن کریم آمده است :\n«وَ کَذٰلِکَ اَعۡثَرۡنَا عَلَیۡہِمۡ لِیَعۡلَمُوۡۤا اَنَّ وَعۡدَ اللّٰہِ حَقٌّ» ( 18/21 )\nترجمه : و اینچنین مردم را متوّجه حال آنها کردیم، تا بدانند که وعده خداوند (در مورد رستاخیز) حقّ است؛ و در پایان جهان و قیام قیامت شکّی نیست! در آن هنگام که میان خود درباره کار خویش نزاع داشتند، گروهی می‌گفتند: «بنایی بر آنان بسازید (تا برای همیشه از نظر پنهان شوند! و از آنها سخن نگویید که) پروردگارشان از وضع آنها آگاهتر است!» ولی آنها که از رازشان آگاهی یافتند (و آن را دلیلی بر رستاخیز دیدند) گفتند: «ما مسجدی در کنار (مدفن) آنها می‌سازیم (تا خاطره آنان فراموش نشود.)»,«اَعْثَرَ» [آگاہ کردیم] «اَعْثَرَ» بمعنی ظاہر کردینا ، واقف کردینا ، آگاہ کردینا ۔,استقبال گرم مردم غار / آگاہ کردیم / بدانند / بسازید / بسازيد / بنايى / بنایی,اعثر,18:21,1
2016,435,ظ,جَھَرَ,«جَھَرَ» بمعنی  ظاہر کرنا ۔\nمثلاً در قرآن کریم آمده است :\n«وَ اَسِرُّوۡا  قَوۡلَکُمۡ  اَوِ اجۡہَرُوۡا بِہٖ ؕ اِنَّہٗ  عَلِیۡمٌۢ  بِذَاتِ الصُّدُوۡرِ» ( 67/13 )\nترجمه : گفتار خود را پنهان کنید یا آشکار (تفاوتی نمی‌کند)، او به آنچه در سینه‌هاست آگاه است,«جَھَرَ» [آشکارا] «جَھَرَ» بمعنی  ظاہر کرنا ۔,آشکارا / بانگ برداشتن / و آشکار شما را / آوای بلند / بہ آواز بلند گوید / و آشکارا / آشكارا,جھر,2:55-4:148-4:153-6:3-6:47-7:205-13:10-16:75-17:110-20:7-21:110-49:2-67:13-87:7,14
2017,435,ظ,اَعْلَنَ,«اَعْلَنَ» بمعنی  ظاہر کرنا ۔ اسکی ضد «اَسَرَّ» ہے ۔ اس کا استعمال اظہار معانی یعنی کسی بات کے ظاہر کرنے کے لیے ہوتا ہے ، اجسام کے لیے بہت کم آتا ہے (مف) اور اس میں آواز کا اونچا ہونا ضروری نہیں ہوتا ( فق ل 237 )\nمثلاً در قرآن کریم آمده است :\n«وَ اللّٰہُ یَعۡلَمُ  مَا تُسِرُّوۡنَ وَ مَا  تُعۡلِنُوۡنَ» ( 16/19 )\nترجمه : خداوند آنچه را پنهان می‌دارید و آنچه را آشکار می‌سازید، می‌داند\nظاہر کے لیے «ظَاھِر ، عَلَانِیَۃ» اور «شُرَّعًا» کے الفاظ آئے ہیں ۔ تفصیل اوپر گزر چکی ۔,«اَعْلَنَ» [کہ آشکار نمودید] «اَعْلَنَ» بمعنی  ظاہر کرنا ۔,کہ آشکار نمودید / آشکار ساختم / پنهان / آشکار / آشكار / نهان / داند,اعلن,2:77-2:274-11:5-13:22-14:31-14:38-16:19-16:23-27:25-27:74-28:69-35:29-36:76-60:1-64:4-71:9,16
2018,436,ع,عَجَزَ,«عِجْز» کسی کام کے کرنے سے قاصر ہونا ، سرانجام دینے کی استطاعت و طاقت نہ رکھنا ( فل 214 ) اور «عِجْز» کی ضد قدرت ہے ۔\nمثلاً در قرآن کریم آمده است :\n«قَالَ یٰوَیۡلَتٰۤی اَعَجَزۡتُ اَنۡ  اَکُوۡنَ مِثۡلَ  ہٰذَا الۡغُرَابِ» ( 5/31 )\nترجمه : آنان بر طریق هدایت از پروردگارشانند، و آنانند رستگاران,«عَجَزَ» [آیا ناتوان شدم] «عِجْز» کوئی کام نہ کر سکنا ۔,آیا ناتوان شدم / ناتوان کنندگان اللہ / عاجز کنندگان اللہ / عاجز کنندہ گان اللہ / عاجز کنندہ اللہ / عاجز کنندۂ اللہ اند / ناتوان,عجز,5:31-6:134-8:59-9:2-9:3-10:53-11:20-11:33-16:46-24:57-29:22-35:44-39:51-42:31-46:32-72:12,16
2019,436,ع,عَیَّ,«عَیَّ» کام کرتے کرتے تھک جانا اور سرانجام دینے کے قابل نہ رہنا یا دوبارہ وہی کام کرنے کی طاقت نہ رکھنا  یا ٹھیک طریقہ سے نہ کر سکنا (منجد) اور «دَاءٌ عِیَاءٌ» لاعلاج مرض کو کہتے ہیں (مف) «عَیَاءُ» عجز سے کمتر ہے (منجد) کیونکہ پہلے اس میں کام کرنے کی استعداد موجود تھی ۔\nمثلاً در قرآن کریم آمده است :\n«اَفَعَیِیۡنَا بِالۡخَلۡقِ الۡاَوَّلِ ؕ بَلۡ ہُمۡ فِیۡ لَبۡسٍ مِّنۡ خَلۡقٍ جَدِیۡدٍ» ( 50/15 )\nترجمه : آیا ما از آفرینش نخستین عاجز ماندیم (که قادر بر آفرینش رستاخیز نباشیم)؟! ولی آنها (با این همه دلایل روشن) باز در آفرینش جدید تردید دارند,«عَیَّ» تھکاوٹ کی وجہ سے کام جاری نہ رکھ سکنا یا دوبارہ نہ کر سکنا ۔,آفرینش / آفرينش / مردگان / مُردگان / درمانده / نخستین / نخستين,عی,46:33-50:15,2
2020,436,ع,اِسْتَکَان فلَانٌ,«اِسْتَکَان فلَانٌ» بمعنی فلاں نے عاجزی کا اظہار کیا ۔ گویا وہ ٹھہر گیا (مف) اور مقابلہ میں دب جانا ۔ اور بمعنی عاجزی کرنا ۔ مطیع (تابعدار) ہونا (منجد)\nمثلاً در قرآن کریم آمده است :\n«فَمَا وَہَنُوۡا لِمَاۤ اَصَابَہُمۡ فِیۡ سَبِیۡلِ اللّٰہِ وَ مَا ضَعُفُوۡا وَ مَا اسۡتَکَانُوۡا» ( 3/146 )\nترجمه : چه بسیار پیامبرانی که مردان الهی فراوانی به همراه آنان جنگ کردند! آنها هیچ‌گاه در برابر آنچه در راه خدا به آنان می‌رسید، سست و ناتوان نشدند (و تن به تسلیم ندادند)؛ و خداوند استقامت‌کنندگان را دوست دارد,«اِسْتَکَان» مقابلہ در دب جانا اور عاجزی کا اظہار کرنا ۔,فروتنی / فروتنى / زاری / زارى / نکردند / نكردند / نشدند,استکان فلان,3:146-23:76,2
2021,437,ع,اَخْبَتَ,«خَبْت» نشیبی اور نرم زمین کو کہتے ہیں ۔ اور «اَخْبَتَ الرَّجُل» بمعنی کسی شخص کا نرم زمین کا ارادہ کرنا یا وہاں اترنا ۔ اس کے بعد یہ لفظ نرمی اور تواضع کے معنی میں استعمال ہونے لگا (مف) بمعنی سکون اور اطمینان سے اللہ کی طرف رجوع کرنا ( فق 208 )\nمثلاً در قرآن کریم آمده است :\n«اِنَّ الَّذِیۡنَ اٰمَنُوۡا وَ عَمِلُوا الصّٰلِحٰتِ وَ اَخۡبَتُوۡۤا اِلٰی رَبِّہِمۡ ۙ اُولٰٓئِکَ اَصۡحٰبُ الۡجَنَّۃِ» ( 11/23 )\nترجمه : (وارثانی) که بهشت برین را ارث می‌برند، و جاودانه در آن خواهند ماند,«اَخْبَتَ» [و فروتنی کردند] «اَخْبَت» دل کا نرم اور متواضع ہونا ( عاجزی کرنے والا) ۔,و فروتنی کردند / بدانند / امتی / امتى / خاضع / نام,اخبت,11:23-17:97-22:34-22:54,4
2022,437,ع,خَشَعَ,«خُشُوْع» ایسے ڈر کو کہتے ہیں جس کا اثر دل سے آگے اعضاء و جوارح پر بھی نمایاں ہونے لگے ۔ اور اس سے نگاہیں اور آواز پست ہو جائیں (م ۔ ل) ( تفصیل ’’ ڈرنا ‘‘ میں دیکھیے ) لہذا یہ لفظ ڈرنا اور عاجزی کرنا دونوں معنوں میں استعمال ہو گا ۔ ڈر کی وجہ دل کے نرم ہونے کی یہ ظاہری کیفیت ہے کہ نگاہ اور آواز پست ہو جاتی ہے ۔ مثلاً در قرآن کریم آمده است :\n«وَ اِنَّ مِنۡ اَہۡلِ  الۡکِتٰبِ لَمَنۡ یُّؤۡمِنُ بِاللّٰہِ وَ مَاۤ اُنۡزِلَ اِلَیۡکُمۡ وَ مَاۤ  اُنۡزِلَ اِلَیۡہِمۡ خٰشِعِیۡنَ  لِلّٰہِ» ( 3/199 )\nترجمه : و از اهل کتاب، کسانی هستند که به خدا، و آنچه بر شما نازل شده، و آنچه بر خودشان نازل گردیده، ایمان دارند؛ در برابر (فرمان) خدا خاضعند؛ و آیات خدا را به بهای ناچیزی نمی‌فروشند. پاداش آنها، نزد پروردگارشان است. خداوند، سریع الحساب است. (تمام اعمال نیک آنها را به سرعت حساب می‌کند، و پاداش می‌دهد),«خَشَعَ» [خاشعان] «خُشُوْع» خوف الہی کی وجہ سے عاجزی اختیار کرنا ۔,خاشعان / در حالی کہ فروتنان اند / و پست می شود / فروتنان / فروتن اند / و مردان فروتن / فروتن,خشع,2:45-3:199-20:108-21:90-23:2-33:35-41:39-42:45-54:7-57:16-59:21-68:43-70:44-79:9-88:2,15
2023,437,ع,خَضَعَ,«خَضَعَ» بمعنی کسی کا مطیع و فرمابردار ہونا ۔ «خُضُوْع» بمعنی تابع ، فرماں بردار ، احکام کا پابند ، ماتحت ، عاجز بہت جھکنے والا ۔ (مف) اور «خَاضِع» بمعنی عاجز ۔ اور «رَجُلٌ خَضِیْعٌ» ایسے شخص کو کہتے ہیں جسے ذلت کی پرواہ نہ ہو ۔ (م ۔ ق) خضوع میں عاجزی کا تصور نمایاں ہوتاہے جبکہ خشوع میں خوف اور اعضاء و جوارح پر اس کے اثرات نمایاں ہوتے ہیں ۔\nمثلاً در قرآن کریم آمده است :\n«اِنۡ نَّشَاۡ نُنَزِّلۡ عَلَیۡہِمۡ مِّنَ السَّمَآءِ  اٰیَۃً فَظَلَّتۡ اَعۡنَاقُہُمۡ  لَہَا خٰضِعِیۡنَ» ( 26/4 )\nترجمه : خداوند می‌خواهد (با این دستورها، راه‌های خوشبختی و سعادت را) برای شما آشکار سازد، و به سنتهای (صحیح) پیشینیان رهبری کند. و خداوند دانا و حکیم است,«خَضَعَ» [فروتنان] «خَضَعَ» بمعنی کسی کا مطیع و فرمابردار ہونا ۔ ,فروتنان / بخواهيم، / بخواهیم، / گردن / فرود / معجزه,خضع,26:4,1
2024,437,ع,تَضَرَّعَ,«تَضَرُّع» بمعنی ذلیل ہونا ۔ چپکے چپکے قریب آنا (منجد) اس کے مفہوم میں خشوع اور خضوع کی دونوں صفات پائی جاتی ہیں ۔ دل کی نرمی ، رقت اور عجز و انکسار جب زیادہ ہو جائیں تو «تَضَرُّع» کا لفظ استعمال ہو گا ۔ بمعنی گڑگڑانا یعنی چپکے چپکے رو رو کر اللہ کے سامنے اپنی عاجزی اور کمتری کا اظہار کرنا ۔\nمثلاً در قرآن کریم آمده است :\n«فَلَوۡلَاۤ  اِذۡ جَآءَہُمۡ بَاۡسُنَا تَضَرَّعُوۡا وَ لٰکِنۡ  قَسَتۡ قُلُوۡبُہُمۡ» ( 6/43 )\nترجمه : چه بسیار پیامبرانی که (برای هدایت) در میان اقوام پیشین فرستادیم؛,«تَضَرَّعَ» [زاری کنند] «تَضَرُّع» خشوع اور خضوع دونوں کے مجموعہ کو کہتے ہیں ، دل کی نرمی ، رقت اورعجز و انکسار جب زیادہ ہو جائے تو «تَضَرُّع» کا لفظ استعمال ہوتاہے ۔,زاری کنند / زاری نکردند / بہ زاری / بہ زاری پردازند / زاری / زارى / تضرع,تضرع,6:42-6:43-6:63-7:55-7:205-23:76,6
2025,438,ع,عَالِمْ,«عَالِم» بمعنی علم رکھنے والا ۔ کسی چیز کی حقیقت کو سمجھنے والا ۔ معروف لفظ ہے اور اس کا استعمال عام ہے ۔ اس کی جمع  «عُلَمَاء» ہے ۔  «عَلَّام» اور «عَلِیْم» مبالغے کے صیغے ہیں ۔ «عَلَّام» بمعنی بہت زیادہ علم رکھنے والا ۔ اور «عَلِیْم» بمعنی ہر ایک چیز کو جاننے والا ۔\nمثلاً در قرآن کریم آمده است :\n«اِنَّمَا یَخۡشَی اللّٰہَ مِنۡ عِبَادِہِ  الۡعُلَمٰٓؤُا» ( 35/28 )\nترجمه : فرمود: «بزودی بازوان تو را بوسیله برادرت محکم (و نیرومند) می‌کنیم، و برای شما سلطه و برتری قرارمی‌دهیم؛ و به برکت آیات ما، بر شما دست نمی‌یابند؛ شما و پیروانتان پیروزید!»,«عَالِم» جاننے والا ، علم رکھنے والا ، عام ہے خواہ پڑھا لکھا ہو یا نہ ہو ۔,دانای / داناى / نهان / نهانِ / غیب / غيب / آشکار,عالم,6:73-9:94-9:105-13:9-21:51-21:81-23:92-26:197-29:43-30:22-32:6-34:3-35:28-35:38-39:46-59:22-62:8-64:18-72:26,19
2026,438,ع,اَحْبَار,«اَحْبَار» جمع ہے «حِبْر» اور «حَبْر» کی ۔ بمعنی سیاہی بھی اور لکھی ہوئی تحریر بھی ، جس سے لکھا جائے وہ بھی «حِبْر» ہے جیسے ( دوات ، سیاہی ، قلم وغیرہ ) اور جو کچھ لکھا جائے وہ بھی «حِبْر» ہے ۔ اور «حِبْر» اور «حَبْر» لکھنے والے کو بھی کہتے ہیں اور پڑھنے والے کو بھی ۔ اور «اَحْبَار» بھی  پڑھنے لکھنے والے یا لکھے پڑھے لوگ (م ۔ ل) اور «اَحْبَار» کا اطلاق قرآن میں یہود و نصاریٰ دونوں کے پڑھے لکھے  لوگوں پر ہوا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«اِتَّخَذُوۡۤا اَحۡبَارَہُمۡ وَ رُہۡبَانَہُمۡ اَرۡبَابًا مِّنۡ دُوۡنِ اللّٰہِ» ( 9/31 )\nترجمه : جاودانه در آن خواهند ماند؛ این وعده حتمی الهی است؛ و اوست عزیز و حکیم (شکست‌ناپذیر و دانا),«اَحْبَار» [و دانشمندان یھود] «اَحْبَار» پڑھے لکھے اور اہل قلم حضرات ۔,و دانشمندان یھود / ودانشمندان یھود / دانشمندان خود / دانشمندان یھود / دانشمندان / راهبان / راهبانِ,احبار,5:44-5:63-9:31-9:34,4
2027,438,ع,قِسِّیْسِیْن,«قَسَّی الشَّیْ» بمعنی کسی چیز کی جستجو اور طلب کرنا ۔ اور «قَسِیْسَۃٌ» بمعنی راہب ہونا یا پادری بن جانا (منجد) «قِسِّیْسِیْن»  جمع ہے «قَسُّ» کی ۔ بمعنی عیسائیوں کے مدرس ۔ پادری حضرات ۔ «قَسُّ» کا درجہ «اُسْقُف» اور «شَمَّاس» کے درمیان ہوتا ہے (منجد)\nمثلاً در قرآن کریم آمده است :\n«وَ لَتَجِدَنَّ  اَقۡرَبَہُمۡ مَّوَدَّۃً  لِّلَّذِیۡنَ اٰمَنُوا الَّذِیۡنَ قَالُوۡۤا اِنَّا نَصٰرٰی ؕ ذٰلِکَ بِاَنَّ مِنۡہُمۡ قِسِّیۡسِیۡنَ وَ رُہۡبَانًا» ( 5/82 )\nترجمه : (در آن زمان) هر کس می‌داند آنچه را از پیش فرستاده و آنچه را برای بعد گذاشته است\nنوٹ : «اُسْقُف»  بڑا پادری ، عیسائیوں کا مزہبی پیشوا ۔\n«شَمَّاس» کنیسہ کا   خادم  جس کا درجہ قسیس سے کم ہوتا ہے  ,«قِسِّیْسِیْن» [کشیشان] «قِسِّیْسِیْن» عیسائیوں کے مدرس اور معلم ۔,دوستان و دشمنان مسلمانان / کشیشان / كشيشان / ترین / ترين / تکبّر / تکبر,قسیسین,5:82,1
2028,439,ع,صَوَامِع,«صَوَامِع» جمع ہے «صَوْمِعَہ» کی  ۔ بمعنی خانقاہ ۔ راہبوں کی عبادت گاہیں ۔,«صَوَامِع» راہبوں (پادریوں) کی عبادت گاہیں ۔,کلیسا / ویران / ويران / دفع / ناحق / ناحقّ / رانده,صوامع,22:40,1
2029,439,ع,بِیَعٌ,«بِیَعٌ» جمع ہے «بیعۃ» کی بمعنی عیسائیوں کا عبادت خانہ ۔,«بِیَعٌ» [و کلیساھای مسیحیان] «بِیَعٌ» عیسائیوں کا عبادت خانہ ۔,کلیسا / و کلیساھای مسیحیان / ویران / ويران / دفع / ناحق / ناحقّ,بیع,22:40,1
2030,439,ع,صَلَوٰت,«صَلَوٰت» جمع ہے «صَلَاۃ» کی ۔ یہودیوں کی عبادت گاہیں ۔ یہودیوں کی عبادت گاہوں کو «کَنَائِس» بھی کہتے ہیں جو جمع ہے «کَنِیْسَہ» کی ( فل 275 ) لیکن قرآن نے یہودیوں کے عبادت خانہ کے لیے «کَنِیْسَہ» کی جگہ «صَلٰوۃ» کا لفظ استعمال کیا ہے جو عبادت کی معروف شکل ہے ۔,«صَلَوٰت» [و کنیسہ ھای یھودیان] «صَلَوٰت» یہودیوں کی عبادت گاہ ۔,کلیسا / و کنیسہ ھای یھودیان / ویران / ويران / دفع / ناحق / ناحقّ,صلوت,22:40,1
2031,439,ع,مَسَاجِد,«مَسَاجِد» جمع ہے «مَسْجِد» کی  بمعنی سجدہ گاہ ۔ مسلمانوں کی عبادت گاہوں کے لیے یہی لفظ استعمال ہوتا ہے ۔\nمثلاً در قرآن کریم آمده است :\n«وَ لَوۡ لَا دَفۡعُ اللّٰہِ النَّاسَ بَعۡضَہُمۡ بِبَعۡضٍ لَّہُدِّمَتۡ صَوَامِعُ وَ بِیَعٌ وَّ صَلَوٰتٌ وَّ مَسٰجِدُ یُذۡکَرُ فِیۡہَا اسۡمُ اللّٰہِ کَثِیۡرًا» ( 22/40 )\nترجمه : این برای آن بود که پیامبرانشان پیوسته با دلایل روشن به سراغشان می‌آمدند، ولی آنها انکار می‌کردند؛ خداوند هم آنان را گرفت (و کیفر داد) که او قوّی و مجازاتش شدید است,«مَسَاجِد» مسلمانوں کی عبادت گاہ ۔,مساجد / مساجدِ / آباد / نام / ویران / ويران,مساجد,2:114-2:187-9:17-9:18-22:40-72:18,6
2032,440,ع,عَذَاب,«عَذَبَ الرَّجُل» بمعنی اس نے شدت پیاس کی وجہ سے کھانا اور سونا چھوڑ دیا ۔ اور جو شخص اس طرح کھانا اور سونا چھوڑ دیتا ہے اسے «عَاذِبٌ و عَذُوْبٌ» کہا جاتا ہے ۔ اور «عَذَاب» بمعنی سخت تکلیف دینا ( مف ) یہ تکلیف خواہ جسمانی سزا سے ہو یا ذہنی ہو ۔ اور تعذیب کے معنی کوڑے مارنا ۔ اور بعض کے نزدیک صرف مارنا یا عذاب دینا ہے (مف)\nمثلاً در قرآن کریم آمده است :\n«وَ لَہُمۡ عَذَابٌ اَلِیۡمٌ ۢ  ۬ ۙ بِمَا کَانُوۡا یَکۡذِبُوۡنَ» ( 2/10 )\nترجمه : در دلهای آنان یک نوع بیماری است؛ خداوند بر بیماری آنان افزوده؛ و به خاطر دروغهایی که میگفتند، عذاب دردناکی در انتظار آنهاست,«عَذَاب» [عذابی] «عَذَاب» دکھ ، سزا ، برے کام کا بدلہ ۔ عام ہے ۔,عذابی / شکنجہ را / عذاب / عذاب را / کیفر است البتہ پشیمان خواھند شد / و عذاب را / عذابى,عذاب,2:7-2:10-2:49-2:85-2:86-2:90-2:96-2:104-2:114-2:126-2:162-2:165-2:166-2:174-2:175-2:178-2:201-3:4-3:16-3:21-3:56-3:77-3:88-3:91-3:105-3:106-3:176-3:177-3:178-3:181-3:188-3:191-4:14-4:18-4:25-4:37-4:56-4:93-4:102-4:138-4:147-4:151-4:161-4:173-5:33-5:36-5:37-5:41-5:73-5:80-5:94-5:115-6:15-6:30-6:40-6:47-6:49-6:65-6:70-6:93-6:124-6:157-7:38-7:39-7:59-7:73-7:141-7:156-7:164-7:165-7:167-8:14-8:32-8:35-8:50-8:68-9:3-9:34-9:39-9:52-9:61-9:68-9:74-9:79-9:90-9:101-10:4-10:15-10:50-10:52-10:54-10:70-10:88-10:97-10:98-11:3-11:8-11:20-11:26-11:39-11:48-11:58-11:64-11:76-11:84-11:93-11:103-12:25-12:107-13:34-14:2-14:6-14:7-14:17-14:21-14:22-14:44-15:50-16:26-16:45-16:63-16:85-16:88-16:94-16:104-16:106-16:113-16:117-17:10-17:57-17:58-18:55-18:58-18:87-19:45-19:75-19:79-20:48-20:61-20:71-20:127-20:134-21:46-22:2-22:4-22:9-22:18-22:22-22:25-22:47-22:55-22:57-23:64-23:76-23:77-24:2-24:8-24:11-24:14-24:19-24:23-24:63-25:19-25:37-25:42-25:65-25:69-26:135-26:156-26:158-26:189-26:201-26:204-27:5-27:21-28:64-29:10-29:23-29:29-29:53-29:54-29:55-30:16-31:6-31:7-31:21-31:24-32:14-32:20-32:21-33:8-33:30-33:57-33:68-34:5-34:8-34:12-34:14-34:33-34:38-34:42-34:46-35:7-35:10-35:36-36:18-37:9-37:33-37:38-37:176-38:8-38:26-38:41-38:61-39:13-39:19-39:24-39:25-39:26-39:40-39: